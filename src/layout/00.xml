			<dataSource>ИсточникДанных1</dataSource>
			<query>ВЫБРАТЬ
	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
	ОстаткиТоваровОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
	ВЫБОР
		КОГДА &amp;ОсновнойСклад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
			ТОГДА ОстаткиТоваровОстатки.Склад
		ИНАЧЕ &amp;ОсновнойСклад
	КОНЕЦ КАК Склад,
	ВЫБОР
		КОГДА ЕСТЬNULL(ЦеныНоменклатурыПоЦветуСрезПоследних.Цена, 0) &gt; 0
			ТОГДА ЦеныНоменклатурыПоЦветуСрезПоследних.Цена
		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатурыБезЦветаСрезПоследних.Цена, 0)
	КОНЕЦ КАК ЦенаДоСкидки,
	ВЫБОР
		КОГДА ЕСТЬNULL(ЦеныНоменклатурыПоЦветуСрезПоследних.Цена, 0) &gt; 0
			ТОГДА ЦеныНоменклатурыПоЦветуСрезПоследних.Цена * (100 - ЕСТЬNULL(СкидкиМагазиновСрезПоследних.Скидка, 0)) / 100
		ИНАЧЕ ЕСТЬNULL(ЦеныНоменклатурыБезЦветаСрезПоследних.Цена, 0) * (100 - ЕСТЬNULL(СкидкиМагазиновСрезПоследних.Скидка, 0)) / 100
	КОНЕЦ КАК Цена,
	ОстаткиТоваровОстатки.ОстатокОстаток КАК Остаток,
	Штрихкоды.Штрихкод КАК Штрихкод
ПОМЕСТИТЬ врОстатки
ИЗ
	РегистрНакопления.ОстаткиТоваров.Остатки(, Склад В (&amp;Склады)) КАК ОстаткиТоваровОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыПоЦвету.СрезПоследних(, ТипЦен = &amp;ВидЦены) КАК ЦеныНоменклатурыПоЦветуСрезПоследних
		ПО ОстаткиТоваровОстатки.Номенклатура = ЦеныНоменклатурыПоЦветуСрезПоследних.Номенклатура
			И ОстаткиТоваровОстатки.ХарактеристикаНоменклатуры.Цвет = ЦеныНоменклатурыПоЦветуСрезПоследних.Цвет
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатурыБезЦвета.СрезПоследних(, ТипЦен = &amp;ВидЦены) КАК ЦеныНоменклатурыБезЦветаСрезПоследних
		ПО ОстаткиТоваровОстатки.Номенклатура = ЦеныНоменклатурыБезЦветаСрезПоследних.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		ПО ОстаткиТоваровОстатки.Номенклатура = Штрихкоды.Владелец
			И ОстаткиТоваровОстатки.ХарактеристикаНоменклатуры = Штрихкоды.ХарактеристикаНоменклатуры
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СкидкиМагазинов.СрезПоследних КАК СкидкиМагазиновСрезПоследних
		ПО ОстаткиТоваровОстатки.Склад = СкидкиМагазиновСрезПоследних.Склад
			И ОстаткиТоваровОстатки.Номенклатура = СкидкиМагазиновСрезПоследних.Номенклатура
			И ОстаткиТоваровОстатки.ХарактеристикаНоменклатуры.Цвет = СкидкиМагазиновСрезПоследних.Цвет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	врОстатки.Номенклатура КАК Номенклатура,
	врОстатки.Характеристика КАК Характеристика,
	врОстатки.Склад КАК Склад,
	СРЕДНЕЕ(врОстатки.ЦенаДоСкидки) КАК ЦенаДоСкидки,
	СРЕДНЕЕ(врОстатки.Цена) КАК Цена,
	СУММА(врОстатки.Остаток) КАК Остаток,
	врОстатки.Штрихкод КАК Штрихкод
ИЗ
	врОстатки КАК врОстатки

СГРУППИРОВАТЬ ПО
	врОстатки.Номенклатура,
	врОстатки.Характеристика,
	врОстатки.Склад,
	врОстатки.Штрихкод		</query>

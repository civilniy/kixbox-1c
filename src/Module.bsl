// Создает характеристику на сайте посредством API запроса.
//
// Параметры:
//   СтруктураХарактеристики - Структура - Содержит данные характеристики для создания
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - Узел, используемый для вызова API
//
// Возвращаемое значение:
//   Булево - Признак наличия ошибок при создании характеристики
Процедура СоздатьПустыеХарактеристики(Узел)
	
	ПустыеХарактеристики = Неопределено;
	Если НЕ Узел.Свойство("ПустыеХарактеристики", ПустыеХарактеристики) ИЛИ ПустыеХарактеристики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Хар Из ПустыеХарактеристики Цикл
		Если ПроверитьХарактеристикуНаСайте(Хар.external_id, Узел).ХарактеристикаСуществует Тогда
			Продолжить; //уже есть - не трогаем (название можно менять в кабинете)
		КонецЕсли;
		Структура = Новый Структура;
		Структура.Вставить("title", Хар.title);
		Структура.Вставить("slug", Хар.slug);
		Структура.Вставить("type", ?(Хар.Свойство("type"), Хар.type, "STRING"));
		Структура.Вставить("select_mode", ?(Хар.Свойство("select_mode"), Хар.select_mode, "MULTIPLE"));
		Структура.Вставить("external_id", Хар.external_id);
		Структура.Вставить("is_grouping", Ложь);
		Если СоздатьХарактеристикуНаСайте(Структура, Узел) Тогда
			Сообщить("Характеристика «" + Хар.title + "» (" + Хар.slug + ") не создана, см. ошибку выше");
		Иначе
			Сообщить("Характеристика «" + Хар.title + "» (slug и external_id " + Хар.slug + ") создана на сайте");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


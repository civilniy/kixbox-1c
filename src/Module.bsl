// Получает список последних обновленных заказов из внешнего источника по методу delivery chunks.
//
// Параметры:
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена с сайтом, содержащий дату последнего получения заказов
//
// Возвращаемое значение:
//   Массив из Структура - коллекция полученных заказов 
Функция ПолучитьСписокПоследнихОбновленныхЗаказов_chunks(Узел) Экспорт

	ШаблонЗапроса = "/api/public/v1/orders/chunks?page=%1&per_page=25&updated_from=%2&exportable=true";
	Метод = "GET";
	
	НомерСтраницы = 1;
	КоличествоЭлементов = 25;
	//ДатаПоследнегоЗапроса = ПланыОбмена.янд_ОбменСайтом.ПолучитьДатаПоследнегоПолученияЗаказа(Узел);
	ДатаПоследнегоЗапроса = Узел.ДатаПоследнегоЗапроса;
	ДатаJSON = ЗаписатьДатуJSON(ДатаПоследнегоЗапроса, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.УниверсальнаяДата);  
	
	ТекстЗапроса = СтрШаблон(ШаблонЗапроса, НомерСтраницы, ДатаJSON);
	
	ВыполнятьЗапрос = Истина;
	МассивПолученныхЗаказов = Новый Массив;
	Пока ВыполнятьЗапрос Цикл
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса);
		
		Если Результат.КодСостояния <> 200 Тогда
			ВыполнятьЗапрос = Ложь;
			Продолжить;
		КонецЕсли;
		
		ТелоОтвета = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку()); 
		
		Если ТелоОтвета.total_count > КоличествоЭлементов Тогда
			НомерСтраницы = НомерСтраницы + 1;
			КоличествоЭлементов = КоличествоЭлементов * 2;
			ТекстЗапроса = СтрШаблон(ШаблонЗапроса, НомерСтраницы, ДатаJSON);
			ДополнитьМассив(МассивПолученныхЗаказов, ТелоОтвета.orders); 
		Иначе
			ВыполнятьЗапрос = Ложь;
			ДополнитьМассив(МассивПолученныхЗаказов, ТелоОтвета.orders);
		КонецЕсли;
		
	КонецЦикла;
	
//	ПланыОбмена.янд_ОбменСайтом.ЗаписатьДатуПоследнегоПолученияЗаказов(Узел);
	
	Возврат МассивПолученныхЗаказов;	
	
КонецФункции

//Получает URL штрихкода доставки для печати из внешнего источника
//
//Параметры:
// 	IDЗаказа - Строка - Идентификатор заказа на сайте
//  IDChunk - Строка - Идентификатор chunk для заказа на сайте
//	Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена с сайтом
//
// Возвращаемое значение:
//	URL - Адрес для скачивания файла
Функция ПолучитьURLШтрихкодаДоставки(IDЗаказа, IDChunk, Узел) Экспорт
	
	РезультатВыполнения = Новый Структура("ЕстьURL, URL", Ложь, "");
	
	ШаблонЗапроса = "/api/public/v1/orders/%1/%2/delivery/label";
	Метод = "GET";
	
	ТекстЗапроса = СтрШаблон(ШаблонЗапроса, IDЗаказа, IDChunk);
	
	Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса);

	Если Результат.КодСостояния = 200 Тогда
		ДанныеОтвета = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку());
		РезультатВыполнения.ЕстьURL = Истина;
		РезультатВыполнения.URL = ДанныеОтвета.label_path;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции


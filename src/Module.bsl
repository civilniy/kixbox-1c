Функция ЕстьСлово(СписокСлов, Слово)
	Возврат СтрНайти(СтрЗаменить(СтрЗаменить(СписокСлов, Символы.ПС, " "), "|", " "), " " + Слово + " ") > 0;
КонецФункции

Функция КороткийТипДляСайта(ТипНоменклатуры)

	Если НЕ ЗначениеЗаполнено(ТипНоменклатуры) Тогда
		Возврат "";
	КонецЕсли;
	Т = НРегЕ(ТипНоменклатуры);
	Замены = Новый Массив;
	Замены.Добавить("футболка-джерси дл. рукав=Лонгслив");
	Замены.Добавить("футболка дл. рукав=Лонгслив");
	Замены.Добавить("футболка без рукавов=Майка");
	Замены.Добавить("джемпер=Лонгслив");
	Замены.Добавить("рубашка поло=Рубашка-поло");
	Замены.Добавить("харрингтон=Куртка");
	Замены.Добавить("куртка-рубашка=Куртка");
	Замены.Добавить("шапка-ушанка=Шапка");
	Замены.Добавить("брелок-ключница=Брелок");
	Замены.Добавить("дезодорант для обуви=Освежитель для обуви");
	Замены.Добавить("сумка-=Сумка");
	Замены.Добавить("футболка-джерси кор=Футболка");
	Для Каждого Замена Из Замены Цикл
		Поз = СтрНайти(Замена, "=");
		Если СтрНачинаетсяС(Т, Лев(Замена, Поз - 1)) Тогда
			Возврат Сред(Замена, Поз + 1);
		КонецЕсли;
	КонецЦикла;
	//«Щетка для обуви», «Набор по уходу за обувью» - тип целиком
	Если СтрНайти(" " + Т + " ", " для ") > 0 ИЛИ СтрНайти(" " + Т + " ", " по ") > 0 Тогда
		Скобка = СтрНайти(ТипНоменклатуры, "(");
		Возврат ?(Скобка > 1, СокрЛП(Лев(ТипНоменклатуры, Скобка - 1)), ТипНоменклатуры);
	КонецЕсли;
	Слова = СтрРазделить(ТипНоменклатуры, " ", Ложь);
	Возврат Слова[0];

КонецФункции

Функция ПолДляНазвания(ТипСайта, Пол)

	Основа = ?(Пол = "Жен", "Женск", "Мужск");
	Слово = НРегЕ(СтрРазделить(ТипСайта, " ", Ложь)[0]);
	Первое = СтрРазделить(Слово, "-", Ложь)[0];
	Последняя = Прав(Первое, 1);
	Если ЕстьСлово(" сабо халф-тайтсы ", Слово) ИЛИ Последняя = "ы" ИЛИ Последняя = "и" Тогда
		Окончание = "ие";
	ИначеЕсли Последняя = "а" ИЛИ Последняя = "я" Тогда
		Окончание = "ая";
	ИначеЕсли Последняя = "о" ИЛИ Последняя = "е" Тогда
		Окончание = "ое";
	Иначе
		Окончание = ?(Пол = "Жен", "ий", "ой");
	КонецЕсли;
	Возврат Основа + Окончание;

КонецФункции

Функция МодельДляСайта(Описание, ТипНоменклатуры)

	Стоп = " t-shirt t-shirts tshirt tee tees shirt overshirt l/s s/s ls ss sweat sweatshirt hoodie hooded hood jacket jac
		| jean jeans pant pants trouser trousers sweatpant sweatpants shorts jorts sweater jumper top cap bag tote skirt woven trucker
		| socks sock jersey longsleeve longsleeves dress beanie puffer pin enamel carabiner keychain wallet belt scarf vase swimsuit trunks
		| clogs slide ";
	СтопКонец = " t-shirt tshirt tee shirt overshirt pant pants trouser trousers sweatpant sweatpants short shorts jorts
		| jacket jac sweat sweatshirt hoodie hooded hood sweater jumper knit cap hat beanie snapback strapback bag skirt dress
		| socks sock jean jeans polo wallet belt scarf top vest puffer coat cardigan backpack clogs slide keychain keyholder
		| longsleeve long sleeve sleeves l/s ls s/s ss crewneck crew - w ";
	СтопНачало = " s/s l/s ls ss w w' w’s wm hooded ";

	Слова = СтрРазделить(Описание, " ", Ложь);
	Если СтрНайти(НРегЕ(ТипНоменклатуры), "джинс") > 0 Тогда
		Если Слова.Количество() > 1 И НРегЕ(Слова[Слова.ВГраница()]) = "denim" Тогда
			Слова.Удалить(Слова.ВГраница());
		КонецЕсли;
	КонецЕсли;
	Пока Слова.Количество() > 1 И ЕстьСлово(СтопНачало, НРегЕ(Слова[0])) Цикл
		Слова.Удалить(0);
	КонецЦикла;

	//пары слов: long sleeve, short sleeve, button down; одиночное (W)
	Очищено = Новый Массив;
	Инд = 0;
	Пока Инд < Слова.Количество() Цикл
		Текущее = НРегЕ(Слова[Инд]);
		Если Инд + 1 < Слова.Количество() Тогда
			Пара = Текущее + " " + НРегЕ(Слова[Инд + 1]);
			Если Пара = "long sleeve" ИЛИ Пара = "short sleeve" ИЛИ Пара = "button down" Тогда
				Инд = Инд + 2;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Текущее <> "(w)" Тогда
			Очищено.Добавить(Слова[Инд]);
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;

	Если Очищено.Количество() > 1 Тогда
		БезСтоп = Новый Массив;
		Для Каждого Сл Из Очищено Цикл
			Если НЕ ЕстьСлово(Стоп, НРегЕ(Сл)) Тогда
				БезСтоп.Добавить(Сл);
			КонецЕсли;
		КонецЦикла;
		Если БезСтоп.Количество() > 0 Тогда
			Очищено = БезСтоп;
		КонецЕсли;
	КонецЕсли;
	Пока Очищено.Количество() > 1 И ЕстьСлово(СтопКонец, НРегЕ(Очищено[Очищено.ВГраница()])) Цикл
		Очищено.Удалить(Очищено.ВГраница());
	КонецЦикла;

	Если Очищено.Количество() = 0 Тогда
		Возврат Описание;
	КонецЕсли;
	Возврат СтрСоединить(Очищено, " ");

КонецФункции

// Каждое слово: первая буква/цифра заглавная, остальное строчными («XT-4 OG» -> «Xt-4 Og», «(half-zip)» -> «(Half-zip)»)
Функция СловаСЗаглавной(Текст)

	Результат = Новый Массив;
	Для Каждого Слово Из СтрРазделить(Текст, " ", Ложь) Цикл
		Поз = 1;
		Пока Поз <= СтрДлина(Слово) Цикл
			Сим = Сред(Слово, Поз, 1);
			Если ВРег(Сим) <> НРег(Сим) ИЛИ СтрНайти("0123456789", Сим) > 0 Тогда
				Прервать;
			КонецЕсли;
			Поз = Поз + 1;
		КонецЦикла;
		Результат.Добавить(Лев(Слово, Поз - 1) + ВРег(Сред(Слово, Поз, 1)) + НРег(Сред(Слово, Поз + 1)));
	КонецЦикла;
	Возврат СтрСоединить(Результат, " ");

КонецФункции


// Поиск KIT по name частичный. В обработку передаем только точные совпадения ШК.
Функция ПрочитатьВариантыПоШтрихкодуKIT(Соединение, Токен, ШК)
    Варианты = Новый Массив;
    СтраницаПоиска = 1;
    Пока Истина Цикл
        Путь = "/v1/variants?per_page=100&name=" + ШК + "&page=" + Формат(СтраницаПоиска, "ЧГ=0");
        Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", Путь);
        Если Ответ.КодСостояния <> 200 Тогда
            Сообщить("Поиск варианта по ШК " + ШК + ": HTTP " + Строка(Ответ.КодСостояния));
            Возврат Неопределено;
        КонецЕсли;
        Данные = ОтветПубличногоAPIKIT(Ответ);
        Строки = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("variants"), Неопределено);
        Если ТипЗнч(Строки) <> Тип("Массив") Тогда
            Сообщить("KIT не вернул список вариантов для ШК " + ШК);
            Возврат Неопределено;
        КонецЕсли;
        Для Каждого Вариант Из Строки Цикл
            Если СокрЛП(Строка(Вариант.Получить("barcode"))) = ШК Тогда
                Варианты.Добавить(Вариант);
            КонецЕсли;
        КонецЦикла;
        Если Строки.Количество() < 100 Тогда
            Прервать;
        КонецЕсли;
        СтраницаПоиска = СтраницаПоиска + 1;
    КонецЦикла;
    Если Варианты.Количество() = 0 Тогда
        Сообщить("В KIT не найден вариант с ШК " + ШК);
    КонецЕсли;
    Возврат Варианты;
КонецФункции

Процедура ДописатьНедостающиеХарактеристики(ДанныеВариантов, Узел)
	
	Токен = ТокенПубличногоAPIKIT();
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Сообщить("Дописывание характеристик пропущено: не задан ключ публичного API KIT");
		Возврат;
	КонецЕсли;
	
	//1. Что отправили из 1С: штрихкод -> характеристики (external_id, value, name)
	Отправлено = Новый Соответствие;
	ВнешниеИД = Новый Соответствие;
	// v1.78.1: названия здесь нужны только для правила цвета HIKES Jasper.
	// Существующие карточки через PATCH не переименовываем.
	// Название нового товара передает основной импорт; приоритет в KIT — «Яндекс KIT».
	Названия = Новый Соответствие;
	Для Каждого Вариант Из ДанныеВариантов Цикл
		Штрихкод = Неопределено;
		Характеристики = Неопределено;
		Если НЕ Вариант.Свойство("barcode", Штрихкод) ИЛИ НЕ ЗначениеЗаполнено(Штрихкод) Тогда
			Продолжить;
		КонецЕсли;
		НазваниеВарианта = Неопределено;
		Если Вариант.Свойство("name", НазваниеВарианта) И ЗначениеЗаполнено(НазваниеВарианта) Тогда
			Названия.Вставить(СокрЛП(Строка(Штрихкод)), СокрЛП(НазваниеВарианта));
		КонецЕсли;
		Если НЕ Вариант.Свойство("characteristics", Характеристики) ИЛИ ТипЗнч(Характеристики) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Отправлено.Вставить(СокрЛП(Строка(Штрихкод)), Характеристики);
		Для Каждого Хар Из Характеристики Цикл
			ВнешнийИД = Неопределено;
			Если Хар.Свойство("external_id", ВнешнийИД) И ЗначениеЗаполнено(ВнешнийИД) Тогда
				ВнешниеИД.Вставить(ВнешнийИД, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Отправлено.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//2. id характеристик на сайте по external_id
	ИДыХарактеристик = Новый Соответствие;
	Для Каждого КлючЗначение Из ВнешниеИД Цикл
		Проверка = ПроверитьХарактеристикуНаСайте(КлючЗначение.Ключ, Узел);
		ИДХар = Неопределено;
		Если Проверка.ХарактеристикаСуществует И ТипЗнч(Проверка.ПараметрыХарактеристики) = Тип("Структура")
			И Проверка.ПараметрыХарактеристики.Свойство("id", ИДХар) И ЗначениеЗаполнено(ИДХар) Тогда
			ИДыХарактеристик.Вставить(КлючЗначение.Ключ, ИДХар);
		КонецЕсли;
	КонецЦикла;
	
	//3. Карточки на сайте постранично, сверка и дописывание
	Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	КонтрольныйШтрихкод = "2700010662516";
	ИДВариантаВыведен = Ложь;
	Проверено = 0;
	Дописано = 0;
	Ошибок = 0;
	ТоварыВыгрузки = Новый Соответствие;
	Выборочно = Узел.Свойство("ШтрихкодыПробнойВыгрузки");
	Если Выборочно Тогда
		КлючиСверки = Новый Массив;
		Для Каждого ЭлементСписка Из Узел.ШтрихкодыПробнойВыгрузки Цикл
			Если Отправлено.Получить(ЭлементСписка.Значение) <> Неопределено Тогда
				КлючиСверки.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Страница = 1;
	ВсегоНаСайте = 0;
	ПросмотреноНаСайте = 0;
	НачалоФазы = ТекущаяДата();
	Пока Истина Цикл
		Если Выборочно Тогда
        Если Страница > КлючиСверки.Количество() Тогда
            Прервать;
        КонецЕсли;
        КлючСверки = КлючиСверки[Страница - 1];
        ПоказатьПрогрессФазы("Характеристики карточек", Страница, КлючиСверки.Количество(), НачалоФазы);
        Варианты = ПрочитатьВариантыПоШтрихкодуKIT(Соединение, Токен, КлючСверки);
        Если Варианты = Неопределено Тогда
            Ошибок = Ошибок + 1;
            Страница = Страница + 1;
            Продолжить;
        КонецЕсли;
		Иначе
			Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/variants?per_page=100&page=" + Формат(Страница, "ЧГ=0"));
			Если Ответ.КодСостояния <> 200 Тогда
				Сообщить("Дописывание характеристик: не удалось прочитать карточки сайта, HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0") 
					+ " " + Лев(Ответ.ПолучитьТелоКакСтроку(), 500));
				Ошибок = Ошибок + 1;
				Прервать;
			КонецЕсли;
			Данные = ОтветПубличногоAPIKIT(Ответ);
			Варианты = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("variants"), Неопределено);
			Если ВсегоНаСайте = 0 И ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("total_count")) = Тип("Число") Тогда
				ВсегоНаСайте = Данные.Получить("total_count");
			КонецЕсли;
			Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

		Для Каждого ВариантСайта Из Варианты Цикл
			ПросмотреноНаСайте = ПросмотреноНаСайте + 1;
			Если НЕ Выборочно Тогда
				ПоказатьПрогрессФазы("Характеристики карточек", ПросмотреноНаСайте, ВсегоНаСайте, НачалоФазы);
			КонецЕсли;
			ШК = СокрЛП(Строка(ВариантСайта.Получить("barcode")));
			Наши = Отправлено.Получить(ШК);
			Если Наши = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Проверено = Проверено + 1;
            Если Узел.Свойство("ПолученныеИДВариантов") Тогда
                ИДИзОтвета = ВариантСайта.Получить("id");
                Если ЗначениеЗаполнено(ИДИзОтвета) Тогда
                    ИДПоШК = Узел.ПолученныеИДВариантов.Получить(ШК);
                    Если ИДПоШК = Неопределено Тогда
                        ИДПоШК = Новый Массив;
                        Узел.ПолученныеИДВариантов.Вставить(ШК, ИДПоШК);
                    КонецЕсли;
                    Если ИДПоШК.Найти(ИДИзОтвета) = Неопределено Тогда
                        ИДПоШК.Добавить(ИДИзОтвета);
                    КонецЕсли;
                КонецЕсли;
            КонецЕсли;
            Если ШК = КонтрольныйШтрихкод Тогда
				ИДВариантаKIT = ВариантСайта.Получить("id");
				Если ЗначениеЗаполнено(ИДВариантаKIT) Тогда
					Сообщить("ШК " + ШК + " — ID варианта KIT: " + Строка(ИДВариантаKIT));
					ИДВариантаВыведен = Истина;

				КонецЕсли;
			КонецЕсли;
			//товар сайта -> штрихкоды его вариантов из этой выгрузки
			ШтрихкодыТовара = ТоварыВыгрузки.Получить(ВариантСайта.Получить("product_id"));
			Если ШтрихкодыТовара = Неопределено Тогда
				ШтрихкодыТовара = Новый Массив;
				ТоварыВыгрузки.Вставить(ВариантСайта.Получить("product_id"), ШтрихкодыТовара);
			КонецЕсли;
			ШтрихкодыТовара.Добавить(ШК);
			
			//>>> ПРАВИЛО HIKES JASPER: у уже созданной карточки цвет тоже меняется на русский
			//(остальные характеристики существующих карточек выгрузка не трогает)
			ЦветHikes = Неопределено;
			ЗаменаЦветаHikes = "";
			ИДЦветаНаСайте = ИДыХарактеристик.Получить("color");
			Если ИДЦветаНаСайте <> Неопределено И ЭтоHikesJasper(Названия.Получить(ШК)) Тогда
				Для Каждого Хар Из Наши Цикл
					ВнешнийИДЦвета = Неопределено;
					Если Хар.Свойство("external_id", ВнешнийИДЦвета) И ВнешнийИДЦвета = "color" И Хар.Свойство("value") Тогда
						ЦветHikes = СокрЛП(Строка(Хар.value));
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			//<<< ПРАВИЛО HIKES JASPER
			
			// Для трех уровней категории источником значений служит 1С.
            ТипыИз1С = Новый Соответствие;
            Для Каждого ХарТипа Из Наши Цикл
                Если НЕ ХарТипа.Свойство("external_id") ИЛИ НЕ ХарТипа.Свойство("value") Тогда
                    Продолжить;
                КонецЕсли;
                Если ХарТипа.external_id = "type" ИЛИ ХарТипа.external_id = "type2" ИЛИ ХарТипа.external_id = "type3" Тогда
                    ИДТипа = ИДыХарактеристик.Получить(ХарТипа.external_id);
                    Если ЗначениеЗаполнено(ИДТипа) Тогда
                        ТипыИз1С.Вставить(ИДТипа, ХарТипа.value);
                    КонецЕсли;
                КонецЕсли;
            КонецЦикла;
            //текущие характеристики карточки сохраняем как есть
			ЕстьНаСайте = Новый Соответствие;
			ИтоговыеХарактеристики = Новый Массив;
			ХарСайта = ВариантСайта.Получить("characteristics");
			Если ТипЗнч(ХарСайта) = Тип("Массив") Тогда
				Для Каждого Х Из ХарСайта Цикл
					Значения = Х.Получить("values");
					Если ТипЗнч(Значения) <> Тип("Массив") Тогда
						Значения = Новый Массив;
						Если ЗначениеЗаполнено(Х.Получить("value")) Тогда
							Значения.Добавить(Х.Получить("value"));
						КонецЕсли;
					КонецЕсли;
					Если Значения.Количество() = 0 Тогда
						Продолжить; //пустая - заполним из 1С
					КонецЕсли;
					ЗначениеТипа = ТипыИз1С.Получить(Х.Получить("characteristic_id"));
                    Если ЗначениеТипа <> Неопределено Тогда
                        Если Значения.Количество() <> 1 ИЛИ Строка(Значения[0]) <> ЗначениеТипа Тогда
                            Продолжить; // новое значение добавится ниже из Наши
                        КонецЕсли;
                    КонецЕсли;
                    //>>> ПРАВИЛО HIKES JASPER
					Если ЗначениеЗаполнено(ЦветHikes) И Х.Получить("characteristic_id") = ИДЦветаНаСайте
						И (Значения.Количество() <> 1 ИЛИ СокрЛП(Строка(Значения[0])) <> ЦветHikes) Тогда
						ЗаменаЦветаHikes = "цвет HIKES Jasper: " + СтрСоединить(Значения, " / ") + " -> " + ЦветHikes;
						Значения = Новый Массив;
						Значения.Добавить(ЦветHikes);
					КонецЕсли;
					//<<< ПРАВИЛО HIKES JASPER
					ЕстьНаСайте.Вставить(Х.Получить("characteristic_id"), Истина);
					ИтоговыеХарактеристики.Добавить(Новый Структура("characteristic_id, values", Х.Получить("characteristic_id"), Значения));
				КонецЦикла;
			КонецЕсли;
			
			//чего нет на карточке - добавляем из 1С
			Добавлено = Новый Массив;
			Если ЗначениеЗаполнено(ЗаменаЦветаHikes) Тогда
				Добавлено.Добавить(ЗаменаЦветаHikes); //ПРАВИЛО HIKES JASPER
			КонецЕсли;
			Для Каждого Хар Из Наши Цикл
				ВнешнийИД = Неопределено;
				ЗначениеХар = Неопределено;
				Если НЕ Хар.Свойство("external_id", ВнешнийИД) ИЛИ НЕ Хар.Свойство("value", ЗначениеХар) Тогда
					Продолжить;
				КонецЕсли;
				ИДХар = ИДыХарактеристик.Получить(ВнешнийИД);
				Если ИДХар = Неопределено ИЛИ ЕстьНаСайте.Получить(ИДХар) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ТипЗнч(ЗначениеХар) = Тип("Число") Тогда
					ЗначениеСтрокой = Формат(ЗначениеХар, "ЧГ=0; ЧРД=.");
				Иначе
					ЗначениеСтрокой = СокрЛП(Строка(ЗначениеХар));
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ЗначениеСтрокой) Тогда
					Продолжить;
				КонецЕсли;
				Значения = Новый Массив;
				Значения.Добавить(ЗначениеСтрокой);
				ИтоговыеХарактеристики.Добавить(Новый Структура("characteristic_id, values", ИДХар, Значения));
				ЕстьНаСайте.Вставить(ИДХар, Истина);
				Добавлено.Добавить("«" + ЗначениеДляЛога(Хар, "name") + "» [" + ВнешнийИД + "]: " + ЗначениеСтрокой);
			КонецЦикла;
			
			// v1.78.1: отличие названия больше не является поводом для изменения карточки.
			Если Добавлено.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Тело = Новый Структура;
			Если Добавлено.Количество() > 0 Тогда
				Тело.Вставить("characteristics", ИтоговыеХарактеристики);
			КонецЕсли;
			Тело.Вставить("requires_marking", ВариантСайта.Получить("requires_marking") = Истина);
			ОтветИзменения = ЗапросПубличногоAPIKIT(Соединение, Токен, "PATCH", "/v1/variants/" + ВариантСайта.Получить("id"), Тело);
			Если ОтветИзменения.КодСостояния = 200 Тогда
				Дописано = Дописано + 1;
				Сообщить("Дописаны характеристики, ШК " + ШК + ": " + СтрСоединить(Добавлено, "; "));
			Иначе
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка дописывания характеристик, ШК " + ШК + ": HTTP " + Формат(ОтветИзменения.КодСостояния, "ЧГ=0") 
					+ " " + Лев(ОтветИзменения.ПолучитьТелоКакСтроку(), 500));
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Выборочно И Варианты.Количество() < 100 Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;
	КонецЦикла;
	
	Если Отправлено.Получить(КонтрольныйШтрихкод) <> Неопределено И НЕ ИДВариантаВыведен Тогда
		Сообщить("ШК " + КонтрольныйШтрихкод + " — при сверке с KIT не получен ID варианта");
	КонецЕсли;
	Сообщить("Характеристики существующих карточек: проверено " + Формат(Проверено, "ЧН=0; ЧГ=0") 
		+ ", дописано " + Формат(Дописано, "ЧН=0; ЧГ=0") + ?(Ошибок > 0, ", ошибок " + Формат(Ошибок, "ЧГ=0"), ""));
	
	ТоварыБезКатегории = Новый Соответствие;
	ПроставитьГруппировкуКарточек(Соединение, Токен, ТоварыВыгрузки, ИДыХарактеристик, ТоварыБезКатегории, Выборочно);
	
	//Карточки без категории (KIT не ставит категорию при создании карточки, ставит при повторной отправке):
	//их штрихкоды отдаем в ВыгрузитьВариантыНаСайт, там эти варианты отправляются второй раз.
	ШтрихкодыБезКатегории = Новый Соответствие;
	Для Каждого КЗ Из ТоварыБезКатегории Цикл
		ШтрихкодыТовара = ТоварыВыгрузки.Получить(КЗ.Ключ);
		Если ТипЗнч(ШтрихкодыТовара) = Тип("Массив") Тогда
			Для Каждого ШК Из ШтрихкодыТовара Цикл
				ШтрихкодыБезКатегории.Вставить(ШК, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Узел.Вставить("ШтрихкодыБезКатегории", ШтрихкодыБезКатегории);
	
КонецПроцедуры

// new.kixbox.ru. Выбор цвета и размера на странице товара строится по группирующим характеристикам карточки.
// KIT заполняет их сам только у карточек с несколькими вариантами; у карточки с одним вариантом список пустой,
// и цвет/размер на странице не показываются. Проставляем группировку «Цвет, Размер» (как на sale.kixbox.ru)
// всем карточкам из выгрузки, у которых она пустая. Уже заполненную группировку не трогаем.
Процедура ПроставитьГруппировкуКарточек(Соединение, Токен, ТоварыВыгрузки, ИДыХарактеристик, ТоварыБезКатегории = Неопределено, Выборочно = Ложь)
	
	ИДЦвета = ИДыХарактеристик.Получить("color");
	ИДРазмера = ИДыХарактеристик.Получить("size");
	Если ТоварыВыгрузки.Количество() = 0 ИЛИ ИДЦвета = Неопределено ИЛИ ИДРазмера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Группировка = Новый Массив;
	Группировка.Добавить(ИДЦвета);
	Группировка.Добавить(ИДРазмера);
	
	ИДКатегорииПоУмолчанию = "";
	Если ТоварыБезКатегории <> Неопределено Тогда
		ИДКатегорииПоУмолчанию = КатегорияПоУмолчаниюНаСайте(Соединение, Токен);
	КонецЕсли;
	
	Исправлено = 0;
	Ошибок = 0;
	Если Выборочно Тогда
		КлючиСверки = Новый Массив;
		Для Каждого Пара Из ТоварыВыгрузки Цикл
			КлючиСверки.Добавить(Пара.Ключ);
		КонецЦикла;
	КонецЕсли;
	Страница = 1;
	ВсегоНаСайте = 0;
	ПросмотреноНаСайте = 0;
	НачалоФазы = ТекущаяДата();
	Пока Истина Цикл
		Если Выборочно Тогда
        Если Страница > КлючиСверки.Количество() Тогда
            Прервать;
        КонецЕсли;
        КлючСверки = КлючиСверки[Страница - 1];
        ПоказатьПрогрессФазы("Группировка «Цвет, Размер»", Страница, КлючиСверки.Количество(), НачалоФазы);
        Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/products/" + КлючСверки);
        Если Ответ.КодСостояния <> 200 Тогда
            Сообщить("Группировка карточки " + КлючСверки + ": HTTP " + Строка(Ответ.КодСостояния));
            Ошибок = Ошибок + 1;
            Страница = Страница + 1;
            Продолжить;
        КонецЕсли;
        Карточка = ОтветПубличногоAPIKIT(Ответ);
        Если ТипЗнч(Карточка) <> Тип("Соответствие") ИЛИ Карточка.Получить("id") <> КлючСверки Тогда
            Сообщить("KIT не подтвердил ID карточки " + КлючСверки);
            Ошибок = Ошибок + 1;
            Страница = Страница + 1;
            Продолжить;
        КонецЕсли;
        Товары = Новый Массив;
        Товары.Добавить(Карточка);
		Иначе
			Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/products?per_page=100&page=" + Формат(Страница, "ЧГ=0"));
			Если Ответ.КодСостояния <> 200 Тогда
				Сообщить("Группировка карточек: не удалось прочитать товары сайта, HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0"));
				Прервать;
			КонецЕсли;
			Данные = ОтветПубличногоAPIKIT(Ответ);
			Товары = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("products"), Неопределено);
			Если ВсегоНаСайте = 0 И ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("total_count")) = Тип("Число") Тогда
				ВсегоНаСайте = Данные.Получить("total_count");
			КонецЕсли;
			Если ТипЗнч(Товары) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

		Для Каждого Товар Из Товары Цикл
			ПросмотреноНаСайте = ПросмотреноНаСайте + 1;
			Если НЕ Выборочно Тогда
				ПоказатьПрогрессФазы("Группировка «Цвет, Размер»", ПросмотреноНаСайте, ВсегоНаСайте, НачалоФазы);
			КонецЕсли;
			ИДТовара = Товар.Получить("id");
			Если ТоварыВыгрузки.Получить(ИДТовара) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			//товар без категории - запоминаем, его карточки будут отправлены повторно
			//«без категории» = список пуст или в нем служебная категория сайта «Не указана» (slug default):
			//KIT ставит ее новой карточке, а настоящую категорию - только при повторной отправке
			КатегорииТовара = Товар.Получить("category_ids");
			Если ТоварыБезКатегории <> Неопределено Тогда
				Если ТипЗнч(КатегорииТовара) <> Тип("Массив") ИЛИ КатегорииТовара.Количество() = 0
					ИЛИ (ЗначениеЗаполнено(ИДКатегорииПоУмолчанию) И КатегорииТовара.Найти(ИДКатегорииПоУмолчанию) <> Неопределено) Тогда
					ТоварыБезКатегории.Вставить(ИДТовара, Истина);
				КонецЕсли;
			КонецЕсли;
			Настройки = Товар.Получить("settings");
			Текущая = ?(ТипЗнч(Настройки) = Тип("Соответствие"), Настройки.Получить("grouping_characteristic_ids"), Неопределено);
			Если ТипЗнч(Текущая) = Тип("Массив") И Текущая.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НовыеНастройки = Новый Структура;
			НовыеНастройки.Вставить("grouping_characteristic_ids", Группировка);
			НовыеНастройки.Вставить("splitting_characteristic_ids", Новый Массив);
			ОтветИзменения = ЗапросПубличногоAPIKIT(Соединение, Токен, "PATCH", "/v1/products/" + ИДТовара, Новый Структура("settings", НовыеНастройки));
			Если ОтветИзменения.КодСостояния = 200 Тогда
				Исправлено = Исправлено + 1;
			Иначе
				Ошибок = Ошибок + 1;
				Сообщить("Группировка карточки " + ИДТовара + ": HTTP " + Формат(ОтветИзменения.КодСостояния, "ЧГ=0") 
					+ " " + Лев(ОтветИзменения.ПолучитьТелоКакСтроку(), 300));
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Выборочно И Товары.Количество() < 100 Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;
	КонецЦикла;
	
	Сообщить("Группировка «Цвет, Размер» проставлена карточкам: " + Формат(Исправлено, "ЧН=0; ЧГ=0") 
		+ ?(Ошибок > 0, ", ошибок " + Формат(Ошибок, "ЧГ=0"), ""));
	
КонецПроцедуры

// id служебной категории сайта «Не указана» (slug default) - в ней KIT держит новые карточки без категории.
// Не нашлась - возвращает "" (тогда «без категории» считается только пустой список категорий).
Функция КатегорияПоУмолчаниюНаСайте(Соединение, Токен)
	
	Страница = 1;
	Пока Страница <= 50 Цикл
		Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/categories?status=ACTIVE&per_page=100&page=" + Формат(Страница, "ЧГ=0"));
		Если Ответ.КодСостояния <> 200 Тогда
			Сообщить("Категории: не удалось прочитать категории сайта, HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0"));
			Возврат "";
		КонецЕсли;
		Данные = ОтветПубличногоAPIKIT(Ответ);
		КатегорииСайта = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("categories"), Неопределено);
		Если ТипЗнч(КатегорииСайта) <> Тип("Массив") Тогда
			Возврат "";
		КонецЕсли;
		Для Каждого КатегорияСайта Из КатегорииСайта Цикл
			Если КатегорияСайта.Получить("slug") = "default" Тогда
				Возврат КатегорияСайта.Получить("id");
			КонецЕсли;
		КонецЦикла;
		Если КатегорииСайта.Количество() < 100 Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;
	КонецЦикла;
	Возврат "";
	
КонецФункции

// new.kixbox.ru. Резерв под заказы: регистр «Комплектация» (движения делает «Заявка на комплектацию»).
// На сайт уходит свободный остаток = ОстаткиТоваров по складам узла - Комплектация по тем же складам.
// Резерв считается одной суммой по варианту и вычитается из его остатков (не ниже 0).
// Загружается один раз перед отправкой остатков / выгрузкой товаров: Узел.РезервыКомплектации (ИД варианта -> количество).
Процедура ЗагрузитьРезервыКомплектации(Узел)
	
	Узел.Вставить("РезервыКомплектации", Новый Соответствие);
	Узел.Вставить("РезервовУчтено", 0);
	Узел.Вставить("РезервШтук", 0);
	Если НЕ Узел.Свойство("СкладСкидок") Тогда
		Возврат; //только new.kixbox.ru
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	К.Номенклатура КАК Номенклатура,
	|	К.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СУММА(К.КоличествоОстаток) КАК Резерв
	|ИЗ
	|	РегистрНакопления.Комплектация.Остатки(, Склад В (&Склады)) КАК К
	|
	|СГРУППИРОВАТЬ ПО
	|	К.Номенклатура,
	|	К.ХарактеристикаНоменклатуры
	|
	|ИМЕЮЩИЕ
	|	СУММА(К.КоличествоОстаток) > 0";
	Запрос.УстановитьПараметр("Склады", Узел.Склады.ВыгрузитьКолонку("Склад"));
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Сообщить("ВНИМАНИЕ: резервы (регистр «Комплектация») не прочитаны, остатки уйдут без вычета резерва: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Резервы = Узел.РезервыКомплектации;
	Пока Выборка.Следующий() Цикл
		ИДВарианта = ?(ЗначениеЗаполнено(Выборка.Характеристика),
			Строка(Выборка.Характеристика.УникальныйИдентификатор()), Строка(Выборка.Номенклатура.УникальныйИдентификатор()));
		Резервы.Вставить(ИДВарианта, ?(Резервы.Получить(ИДВарианта) = Неопределено, 0, Резервы.Получить(ИДВарианта)) + Выборка.Резерв);
	КонецЦикла;
	Сообщить("Резерв на комплектации (регистр «Комплектация», склады узла): вариантов " + Формат(Резервы.Количество(), "ЧН=0; ЧГ=0")
		+ " - их остаток на сайт уходит за вычетом резерва");
	
КонецПроцедуры
	
// Минус на складе в 1С: KIT отрицательный остаток не принимает и отклоняет вариант целиком
// (карточка не создается, цена и остаток «не найден»). Отправляем 0.
Процедура ОбнулитьОтрицательныеОстатки(МассивОстатков)
	
	Для Каждого СтрокаОстатка Из МассивОстатков Цикл
		Если ТипЗнч(СтрокаОстатка.quantity) = Тип("Число") И СтрокаОстатка.quantity < 0 Тогда
			СтрокаОстатка.quantity = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция РезервКомплектации(ИДВарианта, Узел)
	
	Резервы = Неопределено;
	Если НЕ Узел.Свойство("РезервыКомплектации", Резервы) ИЛИ ТипЗнч(Резервы) <> Тип("Соответствие") Тогда
		Возврат 0;
	КонецЕсли;
	Резерв = Резервы.Получить(ИДВарианта);
	Возврат ?(ТипЗнч(Резерв) = Тип("Число"), Резерв, 0);
	
КонецФункции
	
// МассивОстатков - массив структур (external_id, quantity) одного варианта
Процедура ВычестьРезервКомплектации(МассивОстатков, ИДВарианта, Узел)
	
	Резерв = РезервКомплектации(ИДВарианта, Узел);
	Если Резерв <= 0 Тогда
		Возврат;
	КонецЕсли;
	Списано = 0;
	Для Каждого СтрокаОстатка Из МассивОстатков Цикл
		Если Резерв <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если ТипЗнч(СтрокаОстатка.quantity) <> Тип("Число") ИЛИ СтрокаОстатка.quantity <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Списать = Мин(СтрокаОстатка.quantity, Резерв);
		СтрокаОстатка.quantity = СтрокаОстатка.quantity - Списать;
		Резерв = Резерв - Списать;
		Списано = Списано + Списать;
	КонецЦикла;
	Если Списано > 0 Тогда
		Узел.РезервовУчтено = Узел.РезервовУчтено + 1;
		Узел.РезервШтук = Узел.РезервШтук + Списано;
		Если Узел.Свойство("ПоказатьОтправку") Тогда
			Сообщить("Резерв: вариант " + ИДВарианта + ", вычтено " + Формат(Списано, "ЧГ=0"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
	
Процедура СообщитьИтогРезервов(Узел)
	
	Если Узел.Свойство("РезервовУчтено") И Узел.РезервовУчтено > 0 Тогда
		Сообщить("Резерв вычтен из остатков: вариантов " + Формат(Узел.РезервовУчтено, "ЧГ=0")
			+ ", штук " + Формат(Узел.РезервШтук, "ЧГ=0"));
	КонецЕсли;
	
КонецПроцедуры
	
// new.kixbox.ru, кнопка «Обновить остатки» (полная выгрузка).
// В таблицу остатков 1С попадают только товары с остатком; проданные туда не попадают, и на сайте
// у них оставался старый остаток. Здесь: все варианты сайта (активные и архивные) с остатком > 0,
// штрихкода которых нет в отправленной таблице, получают 0 - если остаток по 9 складам в 1С
// действительно не больше нуля (проверка отдельным запросом, без отборов выгрузки).
Процедура ОбнулитьПроданныеНаСайте(ТаблицаОстатков, Узел)

	Если НЕ Узел.Свойство("СкладСкидок") ИЛИ ТаблицаОстатков.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Токен = ТокенПубличногоAPIKIT();
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Сообщить("Обнуление проданных: не задан ключ публичного API KIT, пропущено");
		Возврат;
	КонецЕсли;

	//1. Штрихкоды, остаток которых только что отправлен
	Отправленные = Новый Соответствие;
	Для Каждого КЗ Из ШтрихкодыВариантов1С(ТаблицаОстатков) Цикл
		Для Каждого ШК Из КЗ.Значение Цикл
			Отправленные.Вставить(ШК, Истина);
		КонецЦикла;
	КонецЦикла;
	Если Отправленные.Количество() = 0 Тогда
		Сообщить("Обнуление проданных: не найдены штрихкоды отправленных остатков, пропущено");
		Возврат;
	КонецЕсли;

	//2. Варианты сайта с остатком > 0, которых нет среди отправленных
	СообщитьЭтап("Обнуление проданных: чтение остатков вариантов сайта...");
	Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	Кандидаты = Новый Соответствие; //ШК -> остаток на сайте
	ВсегоСОстатком = 0;
	Для Каждого Статус Из СтрРазделить(",ARCHIVED", ",") Цикл
		Страница = 1;
		ВсегоНаСайте = 0;
		Просмотрено = 0;
		НачалоФазы = ТекущаяДата();
		Пока Истина Цикл
			Путь = "/v1/variants?per_page=100&page=" + Формат(Страница, "ЧГ=0") + ?(Статус = "", "", "&status=" + Статус);
			Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", Путь);
			Если Ответ.КодСостояния <> 200 Тогда
				Сообщить("Обнуление проданных: не удалось прочитать варианты сайта, HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0")
					+ ". Обнуление не выполнялось.");
				Возврат;
			КонецЕсли;
			Данные = ОтветПубличногоAPIKIT(Ответ);
			Варианты = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("variants"), Неопределено);
			Если ВсегоНаСайте = 0 И ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("total_count")) = Тип("Число") Тогда
				ВсегоНаСайте = Данные.Получить("total_count");
			КонецЕсли;
			Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;
			Для Каждого ВариантСайта Из Варианты Цикл
				Просмотрено = Просмотрено + 1;
				ПоказатьПрогрессФазы("Обнуление проданных: чтение " + ?(Статус = "", "активных", "архивных") + " вариантов",
					Просмотрено, ВсегоНаСайте, НачалоФазы);
				Остаток = 0;
				Остатки = ВариантСайта.Получить("stocks");
				Если ТипЗнч(Остатки) = Тип("Массив") Тогда
					Для Каждого О Из Остатки Цикл
						Если ТипЗнч(О.Получить("quantity")) = Тип("Число") Тогда
							Остаток = Остаток + О.Получить("quantity");
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Если Остаток <= 0 Тогда
					Продолжить;
				КонецЕсли;
				ВсегоСОстатком = ВсегоСОстатком + 1;
				ШК = СокрЛП(Строка(ВариантСайта.Получить("barcode")));
				Если ЗначениеЗаполнено(ШК) И Отправленные.Получить(ШК) = Неопределено Тогда
					Кандидаты.Вставить(ШК, Остаток);
				КонецЕсли;
			КонецЦикла;
			Если Варианты.Количество() < 100 Тогда
				Прервать;
			КонецЕсли;
			Страница = Страница + 1;
		КонецЦикла;
	КонецЦикла;

	Если Кандидаты.Количество() = 0 Тогда
		Сообщить("Обнуление проданных: на сайте нет вариантов с устаревшим остатком (с остатком " + Формат(ВсегоСОстатком, "ЧН=0; ЧГ=0") + ")");
		Возврат;
	КонецЕсли;
	//защита: если «проданными» выходит больше половины товаров с остатком - скорее всего, ошибка выборки 1С
	Если ВсегоСОстатком > 20 И Кандидаты.Количество() > ВсегоСОстатком / 2 Тогда
		Сообщить("ВНИМАНИЕ: к обнулению " + Формат(Кандидаты.Количество(), "ЧГ=0") + " из " + Формат(ВсегоСОстатком, "ЧГ=0")
			+ " вариантов с остатком - это больше половины, похоже на ошибку. Обнуление НЕ выполнялось.");
		Возврат;
	КонецЕсли;

	//3. Проверка по 1С: товар по штрихкоду и его остаток на складах new (без отборов выгрузки)
	СписокШК = Новый Массив;
	Для Каждого КЗ Из Кандидаты Цикл
		СписокШК.Добавить(КЗ.Ключ);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ш.Штрихкод КАК Штрихкод,
	|	Ш.Владелец КАК Номенклатура,
	|	Ш.ХарактеристикаНоменклатуры КАК Характеристика
	|ПОМЕСТИТЬ ВТ_ШК
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Ш
	|ГДЕ
	|	Ш.Штрихкод В (&СписокШК)
	|	И Ш.Владелец ССЫЛКА Справочник.Номенклатура
	|;
	|ВЫБРАТЬ
	|	ВТ_ШК.Штрихкод КАК Штрихкод,
	|	ВТ_ШК.Номенклатура КАК Номенклатура,
	|	ВТ_ШК.Характеристика КАК Характеристика,
	|	ЕСТЬNULL(СУММА(О.ОстатокОстаток), 0) КАК Остаток
	|ИЗ
	|	ВТ_ШК КАК ВТ_ШК
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				,
	|				Склад В (&Склады)
	|					И (Номенклатура, ХарактеристикаНоменклатуры) В
	|						(ВЫБРАТЬ Т.Номенклатура, Т.Характеристика ИЗ ВТ_ШК КАК Т)) КАК О
	|		ПО ВТ_ШК.Номенклатура = О.Номенклатура
	|			И ВТ_ШК.Характеристика = О.ХарактеристикаНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ШК.Штрихкод,
	|	ВТ_ШК.Номенклатура,
	|	ВТ_ШК.Характеристика";
	Запрос.УстановитьПараметр("СписокШК", СписокШК);
	Запрос.УстановитьПараметр("Склады", Узел.Склады.ВыгрузитьКолонку("Склад"));
	Выборка = Запрос.Выполнить().Выбрать();

	МассивВыгрузки = Новый Массив;
	Найдены = Новый Соответствие;
	ЕстьОстатокВ1С = 0;
	ВключенныеВарианты = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Найдены.Вставить(Выборка.Штрихкод, Истина);
		ИДВарианта = ?(ЗначениеЗаполнено(Выборка.Характеристика),
			Строка(Выборка.Характеристика.УникальныйИдентификатор()), Строка(Выборка.Номенклатура.УникальныйИдентификатор()));
		СвободныйОстаток = Выборка.Остаток - РезервКомплектации(ИДВарианта, Узел);
		Если СвободныйОстаток > 0 Тогда
			ЕстьОстатокВ1С = ЕстьОстатокВ1С + 1; //в 1С есть свободный остаток, просто не попал в выборку - не трогаем
			Продолжить;
		КонецЕсли;
		СтрОбнуления = ПолучитьСтруктруДляОстатков();
		СтрОбнуления.model = Строка(Выборка.Номенклатура.УникальныйИдентификатор());
		СтрОбнуления.variant_external_id = ?(ЗначениеЗаполнено(Выборка.Характеристика),
			Строка(Выборка.Характеристика.УникальныйИдентификатор()), СтрОбнуления.model);
		Если ВключенныеВарианты.Получить(СтрОбнуления.variant_external_id) <> Неопределено Тогда
			Продолжить; //у варианта несколько штрихкодов
		КонецЕсли;
		ВключенныеВарианты.Вставить(СтрОбнуления.variant_external_id, Истина);
		СтрОбнуления.stocks.Добавить(Новый Структура("external_id, quantity", ВнешнийИДСкладаДляОстатков(Узел.ОсновнойСклад, Узел), 0));
		ДобавитьНулевыеОстатки(СтрОбнуления.stocks, Узел);
		МассивВыгрузки.Добавить(СтрОбнуления);
		Если Узел.Свойство("ПоказатьОтправку") Тогда
			Сообщить("Обнуление: ШК " + Выборка.Штрихкод + ", на сайте было " + Формат(Кандидаты.Получить(Выборка.Штрихкод), "ЧГ=0") + " -> 0");
		КонецЕсли;
	КонецЦикла;

	НеНайдены = Новый Массив;
	Для Каждого ШК Из СписокШК Цикл
		Если Найдены.Получить(ШК) = Неопределено Тогда
			НеНайдены.Добавить(ШК);
		КонецЕсли;
	КонецЦикла;
	Если НеНайдены.Количество() > 0 Тогда
		Пример = Новый Массив;
		Для Инд = 0 По Мин(9, НеНайдены.ВГраница()) Цикл
			Пример.Добавить(НеНайдены[Инд]);
		КонецЦикла;
		Сообщить("Обнуление проданных: " + Формат(НеНайдены.Количество(), "ЧГ=0") + " штрихкодов сайта нет в 1С, их остаток не менялся: "
			+ СтрСоединить(Пример, ", ") + ?(НеНайдены.Количество() > 10, " ...", ""));
	КонецЕсли;
	Если ЕстьОстатокВ1С > 0 Тогда
		Сообщить("Обнуление проданных: у " + Формат(ЕстьОстатокВ1С, "ЧГ=0") + " вариантов в 1С есть остаток, но они не попали в выгрузку остатков - не обнулялись");
	КонецЕсли;

	Если МассивВыгрузки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СообщитьЭтап("Обнуление проданных: отправка 0 по " + Формат(МассивВыгрузки.Количество(), "ЧГ=0") + " вариантам...");
	ЕстьОшибки = API_ОтправитьОстаткиНаСайт(МассивВыгрузки, Узел, "stock_modification_update_" + ПолучитьТекущуюДатуTimeStamp());
	Сообщить("Обнулён остаток у проданных вариантов: " + Формат(МассивВыгрузки.Количество(), "ЧГ=0") + ?(ЕстьОшибки, " (были ошибки, см. выше)", ""));

КонецПроцедуры

// Штрихкоды активных (не архивных) вариантов new.kixbox.ru - публичное API KIT, постранично.
// Возвращает Соответствие ШК -> Истина или Неопределено при ошибке.
Функция ШтрихкодыАктивныхВариантовСайта()
	
	Токен = ТокенПубличногоAPIKIT();
	Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	Результат = Новый Соответствие;
	Страница = 1;
	Пока Истина Цикл
		Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/variants?per_page=100&page=" + Формат(Страница, "ЧГ=0"));
		Если Ответ.КодСостояния <> 200 Тогда
			Сообщить("Чтение вариантов сайта: HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0") + " " + Лев(Ответ.ПолучитьТелоКакСтроку(), 300));
			Возврат Неопределено;
		КонецЕсли;
		Данные = ОтветПубличногоAPIKIT(Ответ);
		Варианты = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("variants"), Неопределено);
		Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
			Прервать;
		КонецЕсли;
		Для Каждого ВариантСайта Из Варианты Цикл
			Если ВариантСайта.Получить("status") = "ARCHIVED" Тогда
				Продолжить;
			КонецЕсли;
			ШК = СокрЛП(Строка(ВариантСайта.Получить("barcode")));
			Если ЗначениеЗаполнено(ШК) Тогда
				Результат.Вставить(ШК, Истина);
			КонецЕсли;
		КонецЦикла;
		Если Варианты.Количество() < 100 Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// new.kixbox.ru. Характеристика «Скидка, %» (slug discount, число) на вариантах сайта.
// СкидкиПоШтрихкодам: штрихкод -> процент скидки, посчитанный при отправке цен (0 - скидки нет).
// По каждому активному варианту сайта из этого списка: скидка изменилась - значение меняется,
// скидки больше нет - характеристика с варианта убирается, остальные характеристики не трогаются.
// Архивные варианты KIT менять не дает - они пропускаются.
Процедура ОбновитьХарактеристикуСкидки(СкидкиПоШтрихкодам, Узел)

	Токен = ТокенПубличногоAPIKIT();
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		Сообщить("«Скидка, %»: не задан ключ публичного API KIT, характеристика не обновлялась");
		Возврат;
	КонецЕсли;

	СоздатьПустыеХарактеристики(Узел); //создаст «Скидка, %», если ее еще нет на сайте
	Проверка = ПроверитьХарактеристикуНаСайте("discount", Узел);
	ИДСкидки = Неопределено;
	Если НЕ Проверка.ХарактеристикаСуществует ИЛИ ТипЗнч(Проверка.ПараметрыХарактеристики) <> Тип("Структура")
		ИЛИ НЕ Проверка.ПараметрыХарактеристики.Свойство("id", ИДСкидки) ИЛИ НЕ ЗначениеЗаполнено(ИДСкидки) Тогда
		Сообщить("«Скидка, %»: характеристика discount не найдена на сайте, значения не отправлялись");
		Возврат;
	КонецЕсли;

	Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	Проверено = 0;
	Поставлено = 0;
	Изменено = 0;
	Снято = 0;
	Ошибок = 0;
	СбросЦеныСоСкидкой = Новый Массив; //варианты без скидки, у которых на сайте осталась цена со скидкой
	Выборочно = Узел.Свойство("ШтрихкодыПробнойВыгрузки");
	Если Выборочно Тогда
		КлючиСверки = Новый Массив;
		Для Каждого ЭлементСписка Из Узел.ШтрихкодыПробнойВыгрузки Цикл
			Если СкидкиПоШтрихкодам.Получить(ЭлементСписка.Значение) <> Неопределено Тогда
				КлючиСверки.Добавить(ЭлементСписка.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Страница = 1;
	ВсегоНаСайте = 0;
	ПросмотреноНаСайте = 0;
	НачалоФазы = ТекущаяДата();
	Пока Истина Цикл
		Если Выборочно Тогда
        Если Страница > КлючиСверки.Количество() Тогда
            Прервать;
        КонецЕсли;
        КлючСверки = КлючиСверки[Страница - 1];
        ПоказатьПрогрессФазы("Характеристика «Скидка, %»", Страница, КлючиСверки.Количество(), НачалоФазы);
        Варианты = ПрочитатьВариантыПоШтрихкодуKIT(Соединение, Токен, КлючСверки);
        Если Варианты = Неопределено Тогда
            Ошибок = Ошибок + 1;
            Страница = Страница + 1;
            Продолжить;
        КонецЕсли;
		Иначе
			Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/variants?per_page=100&page=" + Формат(Страница, "ЧГ=0"));
			Если Ответ.КодСостояния <> 200 Тогда
				Сообщить("«Скидка, %»: не удалось прочитать варианты сайта, HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0")
					+ " " + Лев(Ответ.ПолучитьТелоКакСтроку(), 300));
				Ошибок = Ошибок + 1;
				Прервать;
			КонецЕсли;
			Данные = ОтветПубличногоAPIKIT(Ответ);
			Варианты = ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные.Получить("variants"), Неопределено);
			Если ВсегоНаСайте = 0 И ТипЗнч(Данные) = Тип("Соответствие") И ТипЗнч(Данные.Получить("total_count")) = Тип("Число") Тогда
				ВсегоНаСайте = Данные.Получить("total_count");
			КонецЕсли;
			Если ТипЗнч(Варианты) <> Тип("Массив") Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;

		Для Каждого ВариантСайта Из Варианты Цикл
			ПросмотреноНаСайте = ПросмотреноНаСайте + 1;
			Если НЕ Выборочно Тогда
				ПоказатьПрогрессФазы("Характеристика «Скидка, %»", ПросмотреноНаСайте, ВсегоНаСайте, НачалоФазы);
			КонецЕсли;
			Если ВариантСайта.Получить("status") = "ARCHIVED" Тогда
				Продолжить;
			КонецЕсли;
			ШК = СокрЛП(Строка(ВариантСайта.Получить("barcode")));
			НужнаяСкидка = СкидкиПоШтрихкодам.Получить(ШК);
			Если НужнаяСкидка = Неопределено Тогда
				Продолжить; //вариант не из этой выгрузки
			КонецЕсли;
			Проверено = Проверено + 1;
			
			//скидки нет, а на сайте заполнена цена со скидкой - сбросить (b2b-обмен null не сбрасывает)
			Если НужнаяСкидка = 0 Тогда
				Цены = ВариантСайта.Получить("pricing");
				Если ТипЗнч(Цены) = Тип("Соответствие") И ЗначениеЗаполнено(Цены.Получить("manual_discount_price")) Тогда
					СбросЦеныСоСкидкой.Добавить(ВариантСайта.Получить("id"));
				КонецЕсли;
			КонецЕсли;

			//текущие характеристики варианта: скидку отделяем, остальные сохраняем как есть
			ТекущаяСкидка = 0;
			ИтоговыеХарактеристики = Новый Массив;
			ХарСайта = ВариантСайта.Получить("characteristics");
			Если ТипЗнч(ХарСайта) = Тип("Массив") Тогда
				Для Каждого Х Из ХарСайта Цикл
					Значения = Х.Получить("values");
					Если ТипЗнч(Значения) <> Тип("Массив") Тогда
						Значения = Новый Массив;
						Если ЗначениеЗаполнено(Х.Получить("value")) Тогда
							Значения.Добавить(Х.Получить("value"));
						КонецЕсли;
					КонецЕсли;
					Если Х.Получить("characteristic_id") = ИДСкидки Тогда
						Если Значения.Количество() > 0 Тогда
							Попытка
								ТекущаяСкидка = Число(Значения[0]);
							Исключение
								ТекущаяСкидка = -1; //непонятное значение - перезапишем
							КонецПопытки;
						КонецЕсли;
						Продолжить;
					КонецЕсли;
					Если Значения.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					ИтоговыеХарактеристики.Добавить(Новый Структура("characteristic_id, values", Х.Получить("characteristic_id"), Значения));
				КонецЦикла;
			КонецЕсли;

			Если ТекущаяСкидка = НужнаяСкидка Тогда
				Продолжить;
			КонецЕсли;

			Если НужнаяСкидка > 0 Тогда
				Значения = Новый Массив;
				Значения.Добавить(Формат(НужнаяСкидка, "ЧГ=0"));
				ИтоговыеХарактеристики.Добавить(Новый Структура("characteristic_id, values", ИДСкидки, Значения));
			КонецЕсли;

			Тело = Новый Структура;
			Тело.Вставить("characteristics", ИтоговыеХарактеристики);
			Тело.Вставить("requires_marking", ВариантСайта.Получить("requires_marking") = Истина);
			ОтветИзменения = ЗапросПубличногоAPIKIT(Соединение, Токен, "PATCH", "/v1/variants/" + ВариантСайта.Получить("id"), Тело);
			Если ОтветИзменения.КодСостояния = 200 Тогда
				Если ТекущаяСкидка = 0 Тогда
					Поставлено = Поставлено + 1;
				ИначеЕсли НужнаяСкидка = 0 Тогда
					Снято = Снято + 1;
				Иначе
					Изменено = Изменено + 1;
				КонецЕсли;
				Если Узел.Свойство("ПоказатьОтправку") Тогда
					Сообщить("«Скидка, %», ШК " + ШК + ": " + Формат(ТекущаяСкидка, "ЧГ=0; ЧН=0") + " -> " + Формат(НужнаяСкидка, "ЧГ=0; ЧН=0"));
				КонецЕсли;
			Иначе
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка «Скидка, %», ШК " + ШК + ": HTTP " + Формат(ОтветИзменения.КодСостояния, "ЧГ=0")
					+ " " + Лев(ОтветИзменения.ПолучитьТелоКакСтроку(), 500));
			КонецЕсли;
		КонецЦикла;

		Если НЕ Выборочно И Варианты.Количество() < 100 Тогда
			Прервать;
		КонецЕсли;
		Страница = Страница + 1;
	КонецЦикла;

	СброшеноЦен = 0;
	Пакет = Новый Массив;
	Для Инд = 0 По СбросЦеныСоСкидкой.ВГраница() Цикл
		Пакет.Добавить(Новый Структура("variant_id, manual_discount_price", СбросЦеныСоСкидкой[Инд], Неопределено));
		Если Пакет.Количество() = 1000 ИЛИ Инд = СбросЦеныСоСкидкой.ВГраница() Тогда
			ПоказатьСостояние("Сброс цены со скидкой у товаров без скидки: " + Формат(Инд + 1, "ЧГ=0") + " из " + Формат(СбросЦеныСоСкидкой.Количество(), "ЧГ=0"), ПроцентОт(Инд + 1, СбросЦеныСоСкидкой.Количество()));
			ОтветСброса = ЗапросПубличногоAPIKIT(Соединение, Токен, "POST", "/v1/variants/prices/bulk_update", Новый Структура("items", Пакет));
			Если ОтветСброса.КодСостояния = 200 ИЛИ ОтветСброса.КодСостояния = 204 Тогда
				СброшеноЦен = СброшеноЦен + Пакет.Количество();
			Иначе
				Ошибок = Ошибок + 1;
				Сообщить("Ошибка сброса цены со скидкой: HTTP " + Формат(ОтветСброса.КодСостояния, "ЧГ=0") + " " + Лев(ОтветСброса.ПолучитьТелоКакСтроку(), 500));
			КонецЕсли;
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если СброшеноЦен > 0 Тогда
		Сообщить("Цена со скидкой сброшена у товаров без скидки: " + Формат(СброшеноЦен, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	
	Сообщить("«Скидка, %»: проверено вариантов " + Формат(Проверено, "ЧН=0; ЧГ=0")
		+ ", поставлено " + Формат(Поставлено, "ЧН=0; ЧГ=0")
		+ ", изменено " + Формат(Изменено, "ЧН=0; ЧГ=0")
		+ ", снято " + Формат(Снято, "ЧН=0; ЧГ=0")
		+ ?(Ошибок > 0, ", ошибок " + Формат(Ошибок, "ЧГ=0"), ""));

КонецПроцедуры


// Штрихкоды 1С для строк таблицы цен: Соответствие (Характеристика или Номенклатура) -> Массив ШК.
Функция ШтрихкодыВариантов1С(ТаблицаДанных)
	
	СписокНоменклатуры = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаДанных.Строки Цикл
		СписокНоменклатуры.Добавить(СтрокаТаблицы.Номенклатура);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Штрихкоды.Владелец КАК Номенклатура,
	|	Штрихкоды.ХарактеристикаНоменклатуры КАК Характеристика,
	|	Штрихкоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Владелец В (&Список)";
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ключ = ?(ЗначениеЗаполнено(Выборка.Характеристика), Выборка.Характеристика, Выборка.Номенклатура);
		Список = Результат.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(СокрЛП(Строка(Выборка.Штрихкод)));
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

// Ключ публичного API Яндекс KIT магазина new.kixbox.ru (кабинет KIT → Настройки → API).
// Нужен только для дописывания характеристик в существующие карточки (b2b-ключ для этого не подходит).
Функция ТокенПубличногоAPIKIT()
	
	Возврат "<LOCAL_PUBLIC_API_CREDENTIAL>";
	
КонецФункции

Функция ЗапросПубличногоAPIKIT(Соединение, Токен, Метод, Путь, Тело = Неопределено)
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/merge-patch+json");
	КонецЕсли;
	
	Запрос = Новый HTTPЗапрос(Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ЗаписатьДанныеВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	
	Ответ = Неопределено;
	Для НомерПопытки = 1 По 8 Цикл
		//обрыв связи («Failure when receiving data from the peer» и т.п.) - пауза и повтор
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Если НомерПопытки = 8 Тогда
				ВызватьИсключение "KIT " + Метод + " " + Путь + ": связь оборвалась 8 раз подряд: " + ТекстОшибки;
			КонецЕсли;
			Сообщить("KIT " + Метод + " " + Путь + ": обрыв связи (" + ТекстОшибки + "), повтор " + Формат(НомерПопытки + 1, "ЧГ=0") + " из 8");
			ДатаОжидания = ТекущаяДатаСеанса() + ?(НомерПопытки < 4, 3, 10);
			Пока ТекущаяДатаСеанса() < ДатаОжидания Цикл
			КонецЦикла;
			Продолжить;
		КонецПопытки;
		Если Ответ.КодСостояния = 429 ИЛИ (Ответ.КодСостояния >= 500 И Ответ.КодСостояния < 600) Тогда
			//лимит публичного API ~1 запрос в 1-2 секунды
			ДатаОжидания = ТекущаяДатаСеанса() + ?(НомерПопытки < 4, 2, 5);
			Пока ТекущаяДатаСеанса() < ДатаОжидания Цикл
			КонецЦикла;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

Функция ОтветПубличногоAPIKIT(Ответ)
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
		Результат = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ЗначениеДляЛога(Данные, Ключ)
	
	Значение = Неопределено;
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Ключ, Значение) И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат "—";
	
КонецФункции

Функция ОписаниеВариантаДляЛога(Вариант, Узел)
	
	Строки = Новый Массив;
	Учтено = Новый Структура("barcode, external_id, name, seller_sku, brand, price, manual_discount_price, vat, product, stocks, characteristics, media, dimensions, description");
	
	Строки.Добавить("=== Штрихкод " + ЗначениеДляЛога(Вариант, "barcode") + " | внешний ID варианта " + ЗначениеДляЛога(Вариант, "external_id"));
	Строки.Добавить("  Название товара: " + ЗначениеДляЛога(Вариант, "name"));
	Строки.Добавить("  Артикул: " + ЗначениеДляЛога(Вариант, "seller_sku"));
	Строки.Добавить("  Бренд: " + ЗначениеДляЛога(Вариант, "brand"));
	Строки.Добавить("  Цена: " + ЗначениеДляЛога(Вариант, "price"));
	Если Вариант.Свойство("manual_discount_price") Тогда
		Строки.Добавить("  Цена со скидкой: " + ЗначениеДляЛога(Вариант, "manual_discount_price"));
	КонецЕсли;
	Если Вариант.Свойство("vat") Тогда
		Строки.Добавить("  НДС: " + ЗначениеДляЛога(Вариант, "vat"));
	КонецЕсли;
	Если Вариант.Свойство("description") Тогда
		Строки.Добавить("  Описание: " + Лев(ЗначениеДляЛога(Вариант, "description"), 200));
	КонецЕсли;
	
	Продукт = Неопределено;
	Если Вариант.Свойство("product", Продукт) И ТипЗнч(Продукт) = Тип("Структура") Тогда
		ИДКатегории = ЗначениеДляЛога(Продукт, "external_category_id");
		ПутьКатегории = Неопределено;
		ПутиКатегорий = Неопределено;
		Если Узел.Свойство("ПутиКатегорий", ПутиКатегорий) И ТипЗнч(ПутиКатегорий) = Тип("Соответствие") Тогда
			ПутьКатегории = ПутиКатегорий.Получить(ИДКатегории);
		КонецЕсли;
		Строки.Добавить("  Категория: " + ?(ПутьКатегории = Неопределено, "", ПутьКатегории + " ") + "[" + ИДКатегории + "]");
		Строки.Добавить("  Модель (товар в 1С): " + ЗначениеДляЛога(Продукт, "model"));
	КонецЕсли;
	
	Остатки = Неопределено;
	Если Вариант.Свойство("stocks", Остатки) И ТипЗнч(Остатки) = Тип("Массив") Тогда
		Для Каждого Остаток Из Остатки Цикл
			ИДСклада = ЗначениеДляЛога(Остаток, "external_id");
			ИмяСклада = ИДСклада;
			Попытка
				ИмяСклада = Строка(Справочники.Склады.ПолучитьСсылку(Новый УникальныйИдентификатор(ИДСклада))) + " [" + ИДСклада + "]";
			Исключение
			КонецПопытки;
			Строки.Добавить("  Остаток, склад " + ИмяСклада + ": " + ЗначениеДляЛога(Остаток, "quantity"));
		КонецЦикла;
	КонецЕсли;
	
	Характеристики = Неопределено;
	Если Вариант.Свойство("characteristics", Характеристики) И ТипЗнч(Характеристики) = Тип("Массив") Тогда
		Для Каждого Хар Из Характеристики Цикл
			Строки.Добавить("  Характеристика «" + ЗначениеДляЛога(Хар, "name") + "» [" + ЗначениеДляЛога(Хар, "external_id") + "]: " + ЗначениеДляЛога(Хар, "value"));
		КонецЦикла;
	КонецЕсли;
	
	Медиа = Неопределено;
	Если Вариант.Свойство("media", Медиа) И ТипЗнч(Медиа) = Тип("Массив") Тогда
		Строки.Добавить("  Фото: " + Формат(Медиа.Количество(), "ЧН=0; ЧГ=0"));
	КонецЕсли;
	
	Для Каждого КЗ Из Вариант Цикл
		Если НЕ Учтено.Свойство(КЗ.Ключ) Тогда
			Попытка
				ТекстЗначения = ЗаписатьДанныеВJSON(КЗ.Значение);
			Исключение
				ТекстЗначения = Строка(КЗ.Значение);
			КонецПопытки;
			Строки.Добавить("  " + КЗ.Ключ + ": " + СтрЗаменить(СтрЗаменить(ТекстЗначения, Символы.ПС, " "), Символы.ВК, ""));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

// Отправляет цены на сайт пакетами.
//
// Параметры:
//   ДанныеВариантов - Массив из Структура - данные вариантов для отправки
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена для отправки данных
//	 ДатаВыгрузкиTimeStamp - Строка - ТипЗапроса и дата выгрузки в формате TimeStamp
//
// Возвращаемое значение:
//   Булево - признак наличия ошибок при отправке
Функция API_ОтправитьЦеныНаСайт(ДанныеВариантов, Узел, ДатаВыгрузкиTimeStamp) Экспорт

	ЕстьОшибки = Истина;
	
	ТекстЗапроса = "/api/public/v1/variants/bulk/prices";
	Метод = "POST";
	
	МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеВариантов, Узел.Пакет);

	КоличествоПакетов = МассивПакетов.Количество();
	СчетчикПакетов = 1;
	ЭтоПоследнийПакет = Ложь;		
	
	Итог = НовыйИтогВыгрузки("Цены", ДанныеВариантов.Количество(), КоличествоПакетов);
		
	Для Каждого Пакет Из МассивПакетов Цикл
		
		Если СчетчикПакетов = КоличествоПакетов Тогда
			ЭтоПоследнийПакет = Истина;	
		КонецЕсли;
		
		СтруктураОтправки = Новый Структура("prices", Пакет); 
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, СтруктураОтправки, ,ДатаВыгрузкиTimeStamp, ЭтоПоследнийПакет);
		УчестьОтветПакета(Итог, Результат, СчетчикПакетов, Пакет.Количество());
		ПоказатьПрогресс(Итог, СчетчикПакетов, Пакет.Количество());

		Если Результат.КодСостояния = 200 Тогда
			ЕстьОшибки = Ложь;
		КонецЕсли;
		
		СчетчикПакетов = СчетчикПакетов + 1;
		
	КонецЦикла;
	
	СообщитьИтогВыгрузки(Итог);
	
	Возврат ЕстьОшибки;	
	
КонецФункции


//Сперто с обмена с сайтами
Функция ПолучитьКонтрагентаСайта2(КодНаСайте,Почта,Телефон,Имя)
	
	Параметр = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("00000000111");	
	Запрос = Новый Запрос;
	
	Если НЕ ПустаяСтрока(Почта) Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Контрагент
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Почта = &Почта
		|	И ЗаказПокупателя.ЭтоЗаказИМ
		|	И ЗаказПокупателя.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата УБЫВ";		
	Иначе		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Контрагент
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Телефон ПОДОБНО &Телефон
		|	И ЗаказПокупателя.ЭтоЗаказИМ
		|	И ЗаказПокупателя.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата УБЫВ";				
	КонецЕсли;

	Запрос.УстановитьПараметр("Почта",Почта);
	_Телефон = СтрЗаменить(Телефон,"+","");
	_Телефон = Сред(_Телефон,2);
	
	Запрос.УстановитьПараметр("Телефон","%"+_Телефон);
	Рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат Рез.Контрагент;
	Иначе		
		Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		Контрагент.Родитель = Справочники.Контрагенты.НайтиПоКоду("ГЛ0002092");	
		Контрагент.Наименование = Имя;
		Контрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;			
		Контрагент.НаименованиеПолное = Контрагент.Наименование;	
		Контрагент.Покупатель = Истина;	
		Контрагент.Записать();
		
		МенеджерЗаписи = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Значение = КодНаСайте;
		МенеджерЗаписи.Объект = Контрагент.Ссылка;
		МенеджерЗаписи.Свойство = Параметр;
		МенеджерЗаписи.Записать();
		
		Возврат Контрагент.Ссылка;		
	КонецЕсли;		
	
КонецФункции

//Процедура настройки узла, так как формы как таковой нет.
//Функция ПолучитьНастройкиУзла(ИмяУзла)
Функция ПолучитьНастройкиУзла(Сайт)

	Узел = Новый Структура("КлючAPI, IDМагазина, APIКлюч, Таймаут, Пакет, Организация, ВидЦен, Склады, ОсновнойСклад,  ОтборНоменклатуры, 
	|РежимОтбораТоваров, ИспользоватьТиповыеГабаритыТоваров, ИспользоватьСтавкиНДС,НастройкиПолей, МаппингПолей,
	|ДатаПоследнегоЗапроса, ПрефиксЗаказа, Сайт"); 
	
	Узел.Таймаут = 60;  
	Узел.Пакет = 50;  
	Узел.ДатаПоследнегоЗапроса = ДобавитьМесяц(ТекущаяДата(), -1);   
	
	
	//Персональные настройки +
	Если Сайт = Перечисления.СписокСайтов.Яндекс Тогда
	    //Sale.kixbox.ru
		Узел.КлючAPI = "<LOCAL_B2B_CREDENTIAL>";	
		Узел.ВидЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("ГЛ0000004");

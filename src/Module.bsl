		//Нужна для динамической коллекции «Sale»: условие discount > 0. Значения ставит ОтправитьЦеныНаСайт.
		ПустыеХарактеристики.Добавить(Новый Структура("external_id, slug, title, type, select_mode", "discount", "discount", "Скидка, %", "INT", "RANGE"));

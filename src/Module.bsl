Функция ПостроитьКатегорииПоТипу(ДеревоДанных)
	
	СписокНоменклатуры = Новый Массив;
	Для Каждого СтрокаНоменклатуры Из ДеревоДанных.Строки Цикл
		Если ЗначениеЗаполнено(СтрокаНоменклатуры.Номенклатура) Тогда
			СписокНоменклатуры.Добавить(СтрокаНоменклатуры.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ном.Ссылка КАК Номенклатура,
	|	Ном.Тип КАК Тип,
	|	ЕСТЬNULL(Ном.Тип.Наименование, """") КАК ТипНаименование,
	|	Ном.Тип.Родитель КАК ТипРодитель,
	|	ЕСТЬNULL(Ном.Тип.Родитель.Наименование, """") КАК ТипРодительНаименование,
	|	Ном.Тип.ГрупповойТип КАК ГрупповойТип,
	|	ЕСТЬNULL(Ном.Тип.ГрупповойТип.Наименование, """") КАК ГрупповойТипНаименование,
	|	Ном.Тип.Родитель.Родитель КАК ТипРодительРодитель,
	|	ЕСТЬNULL(Ном.Тип.Родитель.Родитель.Наименование, """") КАК ТипРодительРодительНаименование,
	|	Ном.Тип.ГрупповойТип.Родитель КАК ГруппаГрупповогоТипа,
	|	ЕСТЬNULL(Ном.Тип.ГрупповойТип.Родитель.Наименование, """") КАК ГруппаГрупповогоТипаНаименование
	|ИЗ
	|	Справочник.Номенклатура КАК Ном
	|ГДЕ
	|	Ном.Ссылка В (&Список)";
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ИД");
	Дерево.Колонки.Добавить("Наименование");
	
	СтрокиПоИД = Новый Соответствие;
	КатегорииТоваров = Новый Соответствие;
	ТипыТоваров = Новый Соответствие;
	
	СтрокаБезКатегории = Дерево.Строки.Добавить();
	СтрокаБезКатегории.ИД = "kt_none";
	СтрокаБезКатегории.Наименование = "Без категории";
	СтрокиПоИД.Вставить("kt_none", СтрокаБезКатегории);
	
	Пока Выборка.Следующий() Цикл
		
		// Имена из той же строки запроса, фиксированные уровни даже для неполной ветки.
        Типы = Новый Массив;
        Типы.Добавить(Новый Структура("external_id, value, name", "type", СокрЛП(Выборка.ТипНаименование), "Тип"));
        Типы.Добавить(Новый Структура("external_id, value, name", "type2", СокрЛП(Выборка.ТипРодительНаименование), "Тип2"));
        Типы.Добавить(Новый Структура("external_id, value, name", "type3", СокрЛП(Выборка.ТипРодительРодительНаименование), "Тип3"));
        ТипыТоваров.Вставить(Выборка.Номенклатура, Типы);
        Уровни = Новый Массив;
		
		Если ЗначениеЗаполнено(Выборка.ТипРодительРодитель) Тогда
			Уровни.Добавить(Новый Структура("ИД, Наименование", 
				"tp1_" + Строка(Выборка.ТипРодительРодитель.УникальныйИдентификатор()), 
				Выборка.ТипРодительРодительНаименование));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ТипРодитель) Тогда
			Уровни.Добавить(Новый Структура("ИД, Наименование", 
				"tp2_" + Строка(Выборка.ТипРодитель.УникальныйИдентификатор()), 
				Выборка.ТипРодительНаименование));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Тип) Тогда
			Уровни.Добавить(Новый Структура("ИД, Наименование", 
				"t_" + Строка(Выборка.Тип.УникальныйИдентификатор()), 
				Выборка.ТипНаименование));
		КонецЕсли;
		
		Если Уровни.Количество() = 0 Тогда
			КатегорииТоваров.Вставить(Выборка.Номенклатура, "kt_none");
			Продолжить;
		КонецЕсли;
		
		СтрокаРодителя = Неопределено;
		Для Каждого Уровень Из Уровни Цикл
			СтрокаУровня = СтрокиПоИД.Получить(Уровень.ИД);
			Если СтрокаУровня = Неопределено Тогда
				Если СтрокаРодителя = Неопределено Тогда
					СтрокаУровня = Дерево.Строки.Добавить();
				Иначе
					СтрокаУровня = СтрокаРодителя.Строки.Добавить();
				КонецЕсли;
				СтрокаУровня.ИД = Уровень.ИД;
				Если ПустаяСтрока(Уровень.Наименование) Тогда
					СтрокаУровня.Наименование = "Без названия";
				Иначе
					СтрокаУровня.Наименование = СокрЛП(Уровень.Наименование);
				КонецЕсли;
				СтрокиПоИД.Вставить(Уровень.ИД, СтрокаУровня);
			КонецЕсли;
			СтрокаРодителя = СтрокаУровня;
		КонецЦикла;
		
		КатегорииТоваров.Вставить(Выборка.Номенклатура, СтрокаРодителя.ИД);
		
	КонецЦикла;
	
	ПутиКатегорий = Новый Соответствие;
	Для Каждого КЗ Из СтрокиПоИД Цикл
		Путь = "";
		Стр = КЗ.Значение;
		Пока ТипЗнч(Стр) = Тип("СтрокаДереваЗначений") Цикл
			Путь = Стр.Наименование + ?(Путь = "", "", " → " + Путь);
			Стр = Стр.Родитель;
		КонецЦикла;
		ПутиКатегорий.Вставить(КЗ.Ключ, Путь);
	КонецЦикла;
	
	Возврат Новый Структура("Дерево, КатегорииТоваров, Количество, ПутиКатегорий, ТипыТоваров", Дерево, КатегорииТоваров, СтрокиПоИД.Количество(), ПутиКатегорий, ТипыТоваров);
	
КонецФункции

Функция ПроверитьКатегорииКарточек(ДеревоДанных, КатегорииТоваров, Узел)
	
	Сообщить("Проверка категорий карточек на сайте:");
	НеСовпало = 0;
	Для Каждого СтрокаНоменклатуры Из ДеревоДанных.Строки Цикл
		Номенклатура = СтрокаНоменклатуры.Номенклатура;
		Модель = Строка(Номенклатура.УникальныйИдентификатор());
		ИДКатегории = КатегорииТоваров.Получить(Номенклатура);
		Если ИДКатегории = Неопределено Тогда
			ИДКатегории = "kt_none";
		КонецЕсли;
		
		Ожидается = "";
		РезКат = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/categories/by_external_id/" + ИДКатегории);
		Если РезКат.КодСостояния = 200 Тогда
			ДанныеКат = ПрочитатьДанныеJSON(РезКат.ПолучитьТелоКакСтроку());
			Если ТипЗнч(ДанныеКат) = Тип("Структура") И ДанныеКат.Свойство("id") Тогда
				Ожидается = ДанныеКат.id;
			КонецЕсли;
		Иначе
			Сообщить("  категория " + ИДКатегории + " на сайте не найдена, HTTP " + Формат(РезКат.КодСостояния, "ЧГ=0"));
		КонецЕсли;
		
		ИДВарианта = Модель;
		Если СтрокаНоменклатуры.Строки.Количество() > 0 Тогда
			Попытка
				Характеристика = СтрокаНоменклатуры.Строки[0].Характеристика;
				Если ЗначениеЗаполнено(Характеристика) Тогда
					ИДВарианта = Модель + "%23" + Строка(Характеристика.УникальныйИдентификатор());
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
		РезТов = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/variants/by_external_id/" + ИДВарианта);
		Если РезТов.КодСостояния = 200 Тогда
			ТелоТов = РезТов.ПолучитьТелоКакСтроку();
			ДанныеТов = ПрочитатьДанныеJSON(ТелоТов);
			ФактКат = "";
			Если ТипЗнч(ДанныеТов) = Тип("Структура") И ДанныеТов.Свойство("category_id") И ДанныеТов.category_id <> Неопределено Тогда
				ФактКат = ДанныеТов.category_id;
			КонецЕсли;
			Сообщить("  " + Номенклатура.Артикул + ": отправлена категория " + ИДКатегории + " (на сайте id " + Ожидается 
				+ "), у карточки на сайте category_id " + ФактКат 
				+ ?(ФактКат = Ожидается И ЗначениеЗаполнено(ФактКат), " - СОВПАДАЕТ", " - НЕ СОВПАДАЕТ"));
			Если НЕ (ФактКат = Ожидается И ЗначениеЗаполнено(ФактКат)) Тогда
				НеСовпало = НеСовпало + 1;
			КонецЕсли;
		Иначе
			Сообщить("  " + Номенклатура.Артикул + ": вариант " + ИДВарианта + " не найден, HTTP " + Формат(РезТов.КодСостояния, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеСовпало;
	
КонецФункции

Функция ВыгрузитьКатегорииНаСайт(ДеревоГрупп, Узел)
	
	СозданоОбновленоУспешно = Истина;
	
	Для Каждого СтрДерева Из ДеревоГрупп.Строки Цикл
		
		НаименованиеКатегории = СтрДерева.Наименование;
		Если ТипЗнч(СтрДерева.Родитель) = Тип("СтрокаДереваЗначений") Тогда
			ИДРодителя = СтрДерева.Родитель.ИД;
		Иначе
			ИДРодителя = "";
		КонецЕсли;
		
		Состояние("Категория: " + НаименованиеКатегории);
		Подробно = Узел.Свойство("ПоказатьОтправку");
		ДанныеКатегории = ПроверитьКатегориюНаСайте(СтрДерева, Узел);
		Если ДанныеКатегории.КатегорияСуществует Тогда
			ПараметрыКатегории = ДанныеКатегории.ПараметрыКатегории;
			ТекущееНаименование = "";
			ТекущийРодитель = "";
			Если ТипЗнч(ПараметрыКатегории) = Тип("Структура") Тогда
				Если ПараметрыКатегории.Свойство("title") И ПараметрыКатегории.title <> Неопределено Тогда
					ТекущееНаименование = ПараметрыКатегории.title;
				КонецЕсли;
				Если ПараметрыКатегории.Свойство("external_parent_id") И ПараметрыКатегории.external_parent_id <> Неопределено Тогда
					ТекущийРодитель = ПараметрыКатегории.external_parent_id;
				КонецЕсли;
			КонецЕсли;
			ИДНаСайте = "";
			Если ТипЗнч(ПараметрыКатегории) = Тип("Структура") И ПараметрыКатегории.Свойство("id") Тогда
				ИДНаСайте = ПараметрыКатегории.id;
			КонецЕсли;
			Если Подробно Тогда
				Сообщить("Категория «" + НаименованиеКатегории + "» (" + СтрДерева.ИД + "): уже есть на сайте, id " + ИДНаСайте
					+ ", название на сайте «" + ТекущееНаименование + "», родитель на сайте «" + ТекущийРодитель + "», нужен «" + ИДРодителя + "»");
			КонецЕсли;
			//new.kixbox.ru: название существующей категории не трогаем - его можно менять в кабинете
			//(например «Джемпер» -> «Лонгслив»), обработка правит только родителя
			НазваниеИзКабинета = Узел.Свойство("НазванияКатегорийИзКабинета");
			Если НазваниеИзКабинета Тогда
				НаименованиеДляСайта = ТекущееНаименование;
			Иначе
				НаименованиеДляСайта = НаименованиеКатегории;
			КонецЕсли;
			Если ТекущееНаименование <> НаименованиеДляСайта ИЛИ ТекущийРодитель <> ИДРодителя Тогда
				ОбновитьКатегориюНаСайте(СтрДерева, Узел, НаименованиеДляСайта, ИДНаСайте);
			КонецЕсли;
		Иначе
			СозданоОбновленоУспешно = СоздатьКатегориюНаСайте(СтрДерева, Узел, НаименованиеКатегории);
			Если Подробно И СозданоОбновленоУспешно Тогда
				Сообщить("Категория «" + НаименованиеКатегории + "» (" + СтрДерева.ИД + "): создана на сайте, родитель «" + ИДРодителя + "»");
			КонецЕсли;
		КонецЕсли;
		
		Если СтрДерева.Строки.Количество() > 0 И СозданоОбновленоУспешно Тогда
			СозданоОбновленоУспешно = ВыгрузитьКатегорииНаСайт(СтрДерева, Узел);
		КонецЕсли;
		
		Если НЕ СозданоОбновленоУспешно Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СозданоОбновленоУспешно;
	
КонецФункции	

Процедура СоответствиеКартинок1ССайта(ДеревоДанных, СоответствиеКартинокНоменклатуры, Узел)

	МассивНоменклатуры = ДеревоДанных.Строки.ВыгрузитьКолонку("Номенклатура");
	
	СписокФорматов = Новый СписокЗначений;
	СписокФорматов.Добавить("jpg");
	СписокФорматов.Добавить("jpeg");
	СписокФорматов.Добавить("png");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураПрисоединенныеФайлы.ВладелецФайла КАК Номенклатура,
		|	НоменклатураПрисоединенныеФайлы.Ссылка КАК СсылкаНаФайл,
		|	ВЫБОР
		|		КОГДА НоменклатураПрисоединенныеФайлы.ВладелецФайла.ФайлКартинки = НоменклатураПрисоединенныеФайлы.Ссылка
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОсновнойФайл
		|ИЗ
		|	Справочник.НоменклатураПрисоединенныеФайлы КАК НоменклатураПрисоединенныеФайлы
		|ГДЕ
		|	НЕ НоменклатураПрисоединенныеФайлы.ПометкаУдаления
		|	И НоменклатураПрисоединенныеФайлы.Расширение В(&СписокФорматов)
		|	И НоменклатураПрисоединенныеФайлы.ВладелецФайла В(&МассивНоменклатуры)		
		|
		|УПОРЯДОЧИТЬ ПО
		|	НоменклатураПрисоединенныеФайлы.ВладелецФайла,
		|	НоменклатураПрисоединенныеФайлы.Наименование,
		|	НоменклатураПрисоединенныеФайлы.Ссылка";
	
	Запрос.УстановитьПараметр("СписокФорматов", СписокФорматов);
	Запрос.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);

	Если Узел.РежимОтбораКартинок = 1 Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "	И НоменклатураПрисоединенныеФайлы.ВладелецФайла В(&МассивНоменклатуры)",
		"	И НоменклатураПрисоединенныеФайлы.ВладелецФайла В(&МассивНоменклатуры)
		|	И НоменклатураПрисоединенныеФайлы.Наименование ПОДОБНО &ОтборКартинок");		
		Запрос.УстановитьПараметр("ОтборКартинок", "%" + Узел.СтрокаОтбораКартинок + "%");	
	КонецЕсли;	
	
	ВыборкаФайлов = Запрос.Выполнить().Выбрать();	
	
	ТаблицаКартинок = Новый ТаблицаЗначений;
	ТаблицаКартинок.Колонки.Добавить("Номенклатура", 	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКартинок.Колонки.Добавить("ИмяФайла",		Новый ОписаниеТипов("Строка"));
	ТаблицаКартинок.Колонки.Добавить("Расширение",		Новый ОписаниеТипов("Строка"));
	ТаблицаКартинок.Колонки.Добавить("СтрокаХешСуммы", 	Новый ОписаниеТипов("Строка"));
	ТаблицаКартинок.Колонки.Добавить("ДвоичныеДанные",	Новый ОписаниеТипов("ДвоичныеДанные"));
	ТаблицаКартинок.Колонки.Добавить("ОсновнойФайл",	Новый ОписаниеТипов("Булево"));
	
	Пока ВыборкаФайлов.Следующий() Цикл
		
		ПрисоединенныйФайл = ВыборкаФайлов.СсылкаНаФайл;
		
		ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(ПрисоединенныйФайл);
		ХешФайла = Новый ХешированиеДанных(ХешФункция.SHA256);
		ХешФайла.Добавить(ДвоичныеДанныеФайла);
		СтрокаХешСуммы = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ХешФайла.ХешСумма));
		
		НоваяСтрока = ТаблицаКартинок.Добавить();
		НоваяСтрока.Номенклатура = ВыборкаФайлов.Номенклатура;
		НоваяСтрока.ИмяФайла = ПрисоединенныйФайл.Наименование;
		НоваяСтрока.Расширение = ПрисоединенныйФайл.Расширение;
		НоваяСтрока.ДвоичныеДанные = ДвоичныеДанныеФайла;
		НоваяСтрока.СтрокаХешСуммы = СтрокаХешСуммы;
		НоваяСтрока.ОсновнойФайл = ВыборкаФайлов.ОсновнойФайл;
		
	КонецЦикла;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаФайлов.Номенклатура КАК Номенклатура,
		|	ТаблицаФайлов.ОсновнойФайл КАК ОсновнойФайл,
		|	ВЫРАЗИТЬ(ТаблицаФайлов.СтрокаХешСуммы КАК СТРОКА(64)) КАК ХешСумма
		|ПОМЕСТИТЬ ВТ_Файлы
		|ИЗ
		|	&ТаблицаФайлов КАК ТаблицаФайлов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Файлы.Номенклатура КАК Номенклатура,
		|	ВТ_Файлы.ОсновнойФайл КАК ОсновнойФайл,
		|	ВТ_Файлы.ХешСумма КАК ХешСумма,
		|	янд_ВыгруженныеКартинки.IDКартинки КАК IDКартинки
		|ИЗ
		|	ВТ_Файлы КАК ВТ_Файлы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.янд_ВыгруженныеКартинки КАК янд_ВыгруженныеКартинки
		|		ПО ВТ_Файлы.Номенклатура = янд_ВыгруженныеКартинки.Номенклатура
		|			И ВТ_Файлы.ХешСумма = янд_ВыгруженныеКартинки.ХешСумма
		|			И янд_ВыгруженныеКартинки.УзелОбмена = &УзелОбмена";
	
	Запрос.УстановитьПараметр("ТаблицаФайлов", ТаблицаКартинок);
	Запрос.УстановитьПараметр("УзелОбмена", Узел);
	
	ТаблицаФайловНаСайте = Запрос.Выполнить().Выгрузить();	
	
	МассивДляУдаления = Новый Массив;
	МассивДляЗаписи = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ТаблицаФайловНаСайте Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.IDКартинки) Тогда
			МассивДляЗаписи.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы));
			Продолжить;
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("Номенклатура, СтрокаХешСуммы", СтрокаТаблицы.Номенклатура, СтрокаТаблицы.ХешСумма);		
		НайдСтроки = ТаблицаКартинок.НайтиСтроки(СтруктураПоиска);		
		Если НЕ НайдСтроки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеФайла = Новый Структура();
		ДанныеФайла.Вставить("Имя",			"file");
		ДанныеФайла.Вставить("ИмяФайла", 	НайдСтроки[0].ИмяФайла + "." + НайдСтроки[0].Расширение);
		ДанныеФайла.Вставить("Тип",			"image/" + НайдСтроки[0].Расширение);
		ДанныеФайла.Вставить("Данные",		НайдСтроки[0].ДвоичныеДанные);
		
		РезультатОтправки = ОтправитьФайлКартинкиНаСайт(ДанныеФайла, Узел);
		
		Если НЕ РезультатОтправки.ОтправленУспешно Тогда
			МассивДляУдаления.Добавить(СтрокаТаблицы);
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.IDКартинки = РезультатОтправки.ДанныеФайла.id;
		
		МассивДляЗаписи.Добавить(ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы));
		
	КонецЦикла;

	Если МассивДляУдаления.Количество() Тогда
		Для Каждого Строка Из МассивДляУдаления Цикл
			ТаблицаФайловНаСайте.Удалить(Строка);
		КонецЦикла;
	КонецЕсли;	
	
	Если МассивДляЗаписи.Количество() Тогда	
		РегистрыСведений.янд_ВыгруженныеКартинки.ЗаписатьДанныеВыгруженныхКартинок(МассивДляЗаписи, Узел);
	КонецЕсли;					
	
	СоответствиеКартинокНоменклатуры = ПреобразоватьТаблицуКартинокВСоответствие(ТаблицаФайловНаСайте);
	
КонецПроцедуры

Процедура ВыгрузитьВариантыНаСайт(ДеревоДанных, МассивХарактеристик, СоответствиеКартинокНоменклатуры, Узел, ДатаВыгрузки, ЭтоВыгрузкаЦенОстатков, КатегорииТоваров = Неопределено)
	
	УстановитьПривилегированныйРежим(Истина);
	
	СкладыСозданы = ПроверитьОбновитьСклады(Узел);

	Если Не СкладыСозданы Тогда
		Возврат;
	КонецЕсли;	
	
	УбратьИзВыгрузки = Новый Массив;
	Для Каждого СтрокаХар Из МассивХарактеристик Цикл
		Если НРег(СтрокаХар.ПолеИмя) = "name" Тогда
			// название уходит в поле "Название товара", в характеристику "name" не дублируем
			УбратьИзВыгрузки.Добавить(СтрокаХар);
			Продолжить;
		КонецЕсли;
		Если СтрокаХар.ПолеИмя = "Пол" Тогда
			ХарактеристикиСайта = Неопределено;
			Если Узел.Свойство("ХарактеристикиСайта", ХарактеристикиСайта) И ХарактеристикиСайта <> Неопределено
				И ХарактеристикиСайта.Получить("Номенклатура_Пол") <> Неопределено Тогда
				Сообщить("Пол: пишется в характеристику сайта «Пол» (slug и external_id " + ХарактеристикиСайта.Получить("Номенклатура_Пол") + ")");
				Продолжить;
			КонецЕсли;
			ПолНаСайте = НайтиХарактеристикуНаСайтеПоНазванию("Пол", Узел);
			Если ПолНаСайте = Неопределено Тогда
				УбратьИзВыгрузки.Добавить(СтрокаХар);
				Сообщить("Пол: не удалось получить список характеристик сайта, пол в этой выгрузке не отправляется.");
			ИначеЕсли ЗначениеЗаполнено(ПолНаСайте.ВнешнийИД) Тогда
				СтрокаХар.Вставить("ВнешнийИДНаСайте", ПолНаСайте.ВнешнийИД);
				Сообщить("Пол: пишется в характеристику сайта «Пол» (external_id " + ПолНаСайте.ВнешнийИД + ")");
			ИначеЕсли ЗначениеЗаполнено(ПолНаСайте.ИДБезВнешнего) Тогда
				УбратьИзВыгрузки.Добавить(СтрокаХар);
				Сообщить("Пол: на сайте есть «Пол» без внешнего ID (id " + ПолНаСайте.ИДБезВнешнего + "). Пол не отправляется, чтобы не создать дубль. Заархивируйте этот «Пол» в кабинете - тогда обработка создаст свой и будет его заполнять.");
			Иначе
				Сообщить("Пол: активного «Пола» на сайте нет, будет создан с external_id Номенклатура_Пол");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрокаХар Из УбратьИзВыгрузки Цикл
		МассивХарактеристик.Удалить(МассивХарактеристик.Найти(СтрокаХар));
	КонецЦикла;
	
	ПроверитьОбновитьХарактеристики(МассивХарактеристик, Узел);
    Если Узел.Свойство("ТипыДляКаталога") И НЕ Узел.Свойство("ТипыКаталогаПодготовлены") Тогда
        Узел.ПустыеХарактеристики.Добавить(Новый Структура("external_id, slug, title", "type", "type", "Тип"));
        Узел.ПустыеХарактеристики.Добавить(Новый Структура("external_id, slug, title", "type2", "type2", "Тип2"));
        Узел.ПустыеХарактеристики.Добавить(Новый Структура("external_id, slug, title", "type3", "type3", "Тип3"));
        Узел.Вставить("ТипыКаталогаПодготовлены", Истина);
    КонецЕсли;
	СоздатьПустыеХарактеристики(Узел);
	
	//Туктаров Р.Р. 09.04.2026
	//Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "ИспользоватьТиповыеГабаритыТоваров") Тогда 
	//	ТаблицаРазмеров = ПолучитьТаблицуГабаритов(ДеревоДанных.Строки);
	//Иначе
		ТаблицаРазмеров = Новый ТаблицаЗначений;	
	//КонецЕсли;	

	МассивВариантов = Новый Массив;
	
	//НастройкиПолей = ПланыОбмена.янд_ОбменСайтом.НастройкиПолей(Узел);
	НастройкиПолей = Узел.НастройкиПолей;
	//ХарактеристикиИспользуются = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ХарактеристикиИспользуются = Истина;
	
	ДатаОбработки = НачалоДня(ТекущаяДатаСеанса());
	//ПараметрыУчетаПоОрганизации = УчетНДСУП.ПараметрыУчетаПоОрганизации(Узел.Организация, ДатаОбработки);
	НастройкиЗаполненияНДС = Новый Структура();
	НастройкиЗаполненияНДС.Вставить("Организация", Узел.Организация);
	//НастройкиЗаполненияНДС.Вставить("НалогообложениеНДС",Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС);
	НастройкиЗаполненияНДС.Вставить("Дата", ДатаОбработки);
	НастройкиЗаполненияНДС.Вставить("ПередаватьСтавкиНДС", Узел.ИспользоватьСтавкиНДС);
	
	//Русский цвет из 1С (доп. свойство характеристики «Цвет для этикетки») -> характеристика сайта color_ru.
	//Пока выключено: color_ru заполняет скрипт kit_color_ru.py. Включить - раскомментировать одну строку ниже.
	//Работает только для new.kixbox.ru; карточки без цвета в 1С color_ru не получают.
	ЦветаДляЭтикетки = Неопределено;
	//ЦветаДляЭтикетки = ПолучитьЦветаДляЭтикетки(ДеревоДанных);
	
	ЗагрузитьРезервыКомплектации(Узел);
	
	Для Каждого СтрокаНоменклатуы Из ДеревоДанных.Строки Цикл
		СтруктураПродукта = Новый Структура;		
		
		Номенклатура = СтрокаНоменклатуы.Номенклатура;
		ИДКатегории = Неопределено;
		Если КатегорииТоваров <> Неопределено Тогда
			ИДКатегории = КатегорииТоваров.Получить(Номенклатура);
		КонецЕсли;
		Если ИДКатегории = Неопределено Тогда
			ИДКатегории = "kt_none";
		КонецЕсли;
		СтруктураПродукта.Вставить("external_category_id", ИДКатегории);
		УИДНоменклатуры = Строка(Номенклатура.УникальныйИдентификатор());
		СтруктураПродукта.Вставить("model", УИДНоменклатуры);
		АртикулНоменклатуры = СокрЛП(Номенклатура.Артикул);
		БрендНоменклатуры = СокрЛП(Строка(Номенклатура.Марка));
		//Название товара (new.kixbox.ru) - по правилам kixbox.ru: [Пол] + короткий тип + модель из «Описания»
		НазваниеСайта = "";
		Если Узел.Свойство("СкладСкидок") Тогда
			НазваниеСайта = НазваниеТовараДляСайта(Номенклатура);
		КонецЕсли;
		
		МассивКартинок = Новый Массив;
		Если СоответствиеКартинокНоменклатуры <> Неопределено Тогда
			ЗаполнитьМассивКартинок(МассивКартинок, Номенклатура, СоответствиеКартинокНоменклатуры);	
		КонецЕсли;
		
		Если НЕ ХарактеристикиИспользуются Тогда
			СтруктураВарианта = ПолучитьСтруктуруВарианта(НастройкиПолей);
			СтруктураВарианта.product = СтруктураПродукта;
			СтруктураВарианта.external_id = УИДНоменклатуры;
			ЗаполнитьОсновныеРеквизитыВарианта(СтрокаНоменклатуы.Строки[0], СтруктураВарианта, ТаблицаРазмеров, 
					НастройкиПолей, НастройкиЗаполненияНДС);
			Если ЗначениеЗаполнено(НазваниеСайта) Тогда
				СтруктураВарианта.name = НазваниеСайта;
			КонецЕсли;
			СтруктураВарианта.Вставить("seller_sku", АртикулНоменклатуры);
			СтруктураВарианта.Вставить("brand", БрендНоменклатуры);
			ЗаполнитьОстаткиВарианта(СтрокаНоменклатуы.Строки, СтруктураВарианта, Узел);
			ЗаполнитьХарактеристикиВарианта(СтрокаНоменклатуы.Строки[0], СтруктураВарианта, МассивХарактеристик);
			Если МассивКартинок.Количество() Тогда
				СтруктураВарианта.Вставить("media", МассивКартинок);		
			КонецЕсли;			
			ДобавитьТипыВарианта(СтруктураВарианта, Номенклатура, Узел);
			МассивВариантов.Добавить(СтруктураВарианта);
			УдалитьПустыеПоля(СтруктураВарианта);
		Иначе			
			Для Каждого СтрокаХарактеристики Из СтрокаНоменклатуы.Строки Цикл
				СтруктураВарианта = ПолучитьСтруктуруВарианта(НастройкиПолей);
				СтруктураВарианта.product = СтруктураПродукта; 				
				Характеристика = СтрокаХарактеристики.Характеристика;
				Если ЗначениеЗаполнено(Характеристика) Тогда
					УИДХарактеристики = Строка(Характеристика.УникальныйИдентификатор());
				Иначе
					УИДХарактеристики = УИДНоменклатуры;	
				КонецЕсли;
				СтруктураВарианта.external_id = УИДХарактеристики;								
				ЗаполнитьОсновныеРеквизитыВарианта(СтрокаХарактеристики.Строки[0], СтруктураВарианта, ТаблицаРазмеров, 
					НастройкиПолей, НастройкиЗаполненияНДС);
				Если ЗначениеЗаполнено(НазваниеСайта) Тогда
					СтруктураВарианта.name = НазваниеСайта;
				КонецЕсли;
				СтруктураВарианта.Вставить("seller_sku", АртикулНоменклатуры);
				СтруктураВарианта.Вставить("brand", БрендНоменклатуры);
				ЗаполнитьОстаткиВарианта(СтрокаХарактеристики.Строки, СтруктураВарианта, Узел);
				ЗаполнитьХарактеристикиВарианта(СтрокаХарактеристики.Строки[0], СтруктураВарианта, МассивХарактеристик);
				//Цвет (рус), new.kixbox.ru -> характеристика color_ru: реквизит «Доп хар» значения цвета
				//(справочник «Значения свойств объектов», владелец «Цвет»). Пустой - не отправляется.
				//Прежний вариант через «Цвет для этикетки» (ЦветаДляЭтикетки) оставлен выключенным выше.
				Если Узел.Свойство("ХарактеристикиСайта") И ТипЗнч(СтруктураВарианта.characteristics) = Тип("Массив") Тогда
					ЦветРус = Неопределено;
					Если ЦветаДляЭтикетки <> Неопределено Тогда
						ЦветРус = ЦветаДляЭтикетки.Получить(Характеристика);
					ИначеЕсли ЗначениеЗаполнено(Характеристика) Тогда
						ЦветРус = ЦветРусИз1С(Характеристика);
					КонецЕсли;
					Если ЗначениеЗаполнено(ЦветРус) Тогда
						СтруктураВарианта.characteristics.Добавить(Новый Структура("external_id, value, name", "color_ru", ЦветРус, "Цвет (рус)"));
					КонецЕсли;
				КонецЕсли;
				//Имя фото (new.kixbox.ru): Сезон_Марка_Артикул_Цвет - как в отчете «Анализ продаж \ прибыли \ остатков» и на kixbox.ru
				Если Узел.Свойство("ХарактеристикиСайта") И ТипЗнч(СтруктураВарианта.characteristics) = Тип("Массив") Тогда
					ИмяФото = ИмяФотоВарианта(Номенклатура, Характеристика, АртикулНоменклатуры, БрендНоменклатуры, СтруктураВарианта.characteristics, Узел);
					Если ЗначениеЗаполнено(ИмяФото) Тогда
						СтруктураВарианта.characteristics.Добавить(Новый Структура("external_id, value, name", "photo_name", ИмяФото, "Имя фото"));
					КонецЕсли;
				КонецЕсли;
				//Категория для фильтра (new.kixbox.ru): второй уровень типа товара, как фильтр «Категория» на kixbox.ru
				Если Узел.Свойство("ХарактеристикиСайта") И ТипЗнч(СтруктураВарианта.characteristics) = Тип("Массив") Тогда
					КатегорияФильтра = КатегорияДляФильтра(Номенклатура, Узел);
					Если ЗначениеЗаполнено(КатегорияФильтра) Тогда
						СтруктураВарианта.characteristics.Добавить(Новый Структура("external_id, value, name", "category", КатегорияФильтра, "Категория"));
					КонецЕсли;
				КонецЕсли;
				//>>> ПРАВИЛО HIKES JASPER: цвет карточки - русское название из свойства «Цвет этикетки».
				//Стоит ПОСЛЕ имени фото: имя фото остается с английским цветом, как файлы на FTP.
				Если ЭтоHikesJasper(НазваниеСайта) И ТипЗнч(СтруктураВарианта.characteristics) = Тип("Массив") Тогда
					ЗаменитьЦветHikesJasper(СтруктураВарианта.characteristics, Характеристика);
				КонецЕсли;
				//<<< ПРАВИЛО HIKES JASPER
				Если МассивКартинок.Количество() Тогда
					СтруктураВарианта.Вставить("media", МассивКартинок);	
				КонецЕсли;				
				ДобавитьТипыВарианта(СтруктураВарианта, Номенклатура, Узел);
				МассивВариантов.Добавить(СтруктураВарианта);			
				УдалитьПустыеПоля(СтруктураВарианта);
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	ЕстьОшибки = ОтправитьВариантыНаСайт(МассивВариантов, Узел, ДатаВыгрузки, ЭтоВыгрузкаЦенОстатков);
	
	//new.kixbox.ru: дописываем в уже существующие карточки характеристики, которых на них нет
	Если НЕ ЭтоВыгрузкаЦенОстатков И Узел.Свойство("ХарактеристикиСайта") Тогда
		ДописатьНедостающиеХарактеристики(МассивВариантов, Узел);
		
		//Категории: новым карточкам KIT ставит категорию только при повторной отправке.
		//Варианты товаров, оставшихся без категории, отправляются второй раз - автоматически, в этой же выгрузке.
		ШтрихкодыБезКатегории = Неопределено;
		Если Узел.Свойство("ШтрихкодыБезКатегории", ШтрихкодыБезКатегории) И ТипЗнч(ШтрихкодыБезКатегории) = Тип("Соответствие")
			И ШтрихкодыБезКатегории.Количество() > 0 Тогда
			ВариантыБезКатегории = Новый Массив;
			Для Каждого СтруктураВарианта Из МассивВариантов Цикл
				ШтрихкодВарианта = Неопределено;
				Если СтруктураВарианта.Свойство("barcode", ШтрихкодВарианта) И ЗначениеЗаполнено(ШтрихкодВарианта)
					И ШтрихкодыБезКатегории.Получить(СокрЛП(Строка(ШтрихкодВарианта))) <> Неопределено Тогда
					ВариантыБезКатегории.Добавить(СтруктураВарианта);
				КонецЕсли;
			КонецЦикла;
			Если ВариантыБезКатегории.Количество() > 0 Тогда
				СообщитьЭтап("Категории: повторная отправка карточек без категории, вариантов " + Формат(ВариантыБезКатегории.Количество(), "ЧГ=0") + "...");
				ОтправитьВариантыНаСайт(ВариантыБезКатегории, Узел, ДатаВыгрузки, ЭтоВыгрузкаЦенОстатков);
			КонецЕсли;
			Узел.Удалить("ШтрихкодыБезКатегории");
		КонецЕсли;
	КонецЕсли;
	
	//Если Не ЕстьОшибки Тогда
	//	ПланыОбмена.янд_ОбменСайтом.УвеличитьНомерОтправленного(Узел);	
	//КонецЕсли;	 	
		
КонецПроцедуры

Процедура ОтправитьОстаткиНаСайт(ТаблицаДанных, Узел, ПолнаяВыгрузка, ДатаВыгрузки)
	
	СкладыСозданы = ПроверитьОбновитьСклады(Узел);

	Если Не СкладыСозданы Тогда
		Возврат;
	КонецЕсли;	
	
	МассивВыгрузки = Новый Массив;
	//ХарактеристикиИспользуются = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");  
	ХарактеристикиИспользуются = Истина;

	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных.Строки Цикл
		
		СтруктураВыгрузки = ПолучитьСтруктруДляОстатков();	
		Номенклатура = СтрокаТаблицы.Номенклатура;
		СтруктураВыгрузки.model = Строка(Номенклатура.УникальныйИдентификатор());
		
		Если НЕ ХарактеристикиИспользуются Тогда
			СтруктураВыгрузки.variant_external_id = СтруктураВыгрузки.model;
		Иначе
			Если ЗначениеЗаполнено(СтрокаТаблицы.Характеристика) Тогда
				Характеристика = СтрокаТаблицы.Характеристика;
				СтруктураВыгрузки.variant_external_id = Строка(Характеристика.УникальныйИдентификатор());
			Иначе
				СтруктураВыгрузки.variant_external_id = СтруктураВыгрузки.model;
			КонецЕсли;
		КонецЕсли;

		Для Каждого СтрокаОстатков Из СтрокаТаблицы.Строки Цикл
			СтруктураОстатков = Новый Структура;
			СтруктураОстатков.Вставить("external_id"	, ВнешнийИДСкладаДляОстатков(СтрокаОстатков.Склад, Узел));
			СтруктураОстатков.Вставить("quantity"		, СтрокаОстатков.Остаток);		
			СтруктураВыгрузки.stocks.Добавить(СтруктураОстатков);
		КонецЦикла;
		ОбнулитьОтрицательныеОстатки(СтруктураВыгрузки.stocks);
		ВычестьРезервКомплектации(СтруктураВыгрузки.stocks, СтруктураВыгрузки.variant_external_id, Узел);
		ДобавитьНулевыеОстатки(СтруктураВыгрузки.stocks, Узел);
	
		МассивВыгрузки.Добавить(СтруктураВыгрузки);		
		
	КонецЦикла;
	
	API_ОтправитьОстаткиНаСайт(МассивВыгрузки, Узел, ДатаВыгрузки);
	СообщитьИтогРезервов(Узел);
	
	Если Не ПолнаяВыгрузка Тогда
		//РегистрыСведений.янд_ЗарегистрированныеИзмененияОстатков.ОчиститьВыгруженныеОстатки(ТаблицаДанных.Строки, Узел);
	КонецЕсли;	
	
КонецПроцедуры

Функция НайтиСкладПоКоду(КодСклада, ОписаниеСклада)
	
	Склад = Справочники.Склады.НайтиПоКоду(КодСклада);
	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		Сообщить("ВНИМАНИЕ: склад с кодом " + КодСклада + " (" + ОписаниеСклада + ") не найден в справочнике складов");
	ИначеЕсли Склад.ПометкаУдаления Тогда
		Сообщить("ВНИМАНИЕ: склад с кодом " + КодСклада + " (" + ОписаниеСклада + ") помечен на удаление");
	КонецЕсли;
	Возврат Склад;
	
КонецФункции

Функция НайтиСкладПоНомеру(НомерСклада, СообщатьЕслиНеНайден = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	ПОДСТРОКА(Склады.Наименование, 1, 4) = &Префикс
	|	И НЕ Склады.ПометкаУдаления";
	Запрос.УстановитьПараметр("Префикс", НомерСклада + " ");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Если СообщатьЕслиНеНайден Тогда
		Сообщить("Склад скидок " + НомерСклада + " не найден в справочнике складов. Скидки будут браться со склада остатка.");
	КонецЕсли;
	Возврат Справочники.Склады.ПустаяСсылка();
	
КонецФункции

Функция СкидкиСклада(Склад, ТаблицаДанных)
	
	Скидки = Новый Соответствие;
	СписокНоменклатуры = Новый Массив;
	Для Каждого СтрокаТаблицы Из ТаблицаДанных.Строки Цикл
		СписокНоменклатуры.Добавить(СтрокаТаблицы.Номенклатура);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Скидки.Номенклатура КАК Номенклатура,
	|	Скидки.Цвет КАК Цвет,
	|	Скидки.Скидка КАК Скидка
	|ИЗ
	|	РегистрСведений.СкидкиМагазинов.СрезПоследних(, Склад = &Склад И Номенклатура В (&Список)) КАК Скидки";
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("Список", СписокНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоЦветам = Скидки.Получить(Выборка.Номенклатура);
		Если ПоЦветам = Неопределено Тогда
			ПоЦветам = Новый Соответствие;
			Скидки.Вставить(Выборка.Номенклатура, ПоЦветам);
		КонецЕсли;
		ПоЦветам.Вставить(Выборка.Цвет, Выборка.Скидка);
	КонецЦикла;
	
	Возврат Скидки;
	
КонецФункции

Процедура ОтправитьЦеныНаСайт(ТаблицаДанных, Узел, ДатаВыгрузки)

	МассивВыгрузки = Новый Массив;
	
	СкладСкидок = Неопределено;
	СкидкиСкладаСкидок = Неопределено;
	Если Узел.Свойство("СкладСкидок", СкладСкидок) И ЗначениеЗаполнено(СкладСкидок) Тогда
		СкидкиСкладаСкидок = СкидкиСклада(СкладСкидок, ТаблицаДанных);
		Сообщить("Цены: скидка берется со склада «" + Строка(СкладСкидок) + "», товаров со скидками на этом складе: " + Формат(СкидкиСкладаСкидок.Количество(), "ЧН=0; ЧГ=0"));
	КонецЕсли;
	//ХарактеристикиИспользуются = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ХарактеристикиИспользуются = Истина;
	
	//отбор по вариантам сайта (кнопка «Обновить цены» на new): штрихкоды 1С по характеристикам
	ШтрихкодыСайта = Неопределено;
	ШтрихкодыВарианта1С = Неопределено;
	Пропущено = 0;
	Если Узел.Свойство("ШтрихкодыСайта", ШтрихкодыСайта) И ШтрихкодыСайта <> Неопределено Тогда
		ШтрихкодыВарианта1С = ШтрихкодыВариантов1С(ТаблицаДанных);
	КонецЕсли;
	
	//new.kixbox.ru: характеристика «Скидка, %» - штрихкод -> процент скидки (0 - без скидки)
	СкидкиПоШтрихкодам = Неопределено;
	ШтрихкодыДляСкидок = Неопределено;
	Если СкидкиСкладаСкидок <> Неопределено Тогда
		СкидкиПоШтрихкодам = Новый Соответствие;
		ШтрихкодыДляСкидок = ?(ШтрихкодыВарианта1С <> Неопределено, ШтрихкодыВарианта1С, ШтрихкодыВариантов1С(ТаблицаДанных));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных.Строки Цикл
		
		Если ШтрихкодыВарианта1С <> Неопределено Тогда
			КлючВарианта = ?(ЗначениеЗаполнено(СтрокаТаблицы.Характеристика), СтрокаТаблицы.Характеристика, СтрокаТаблицы.Номенклатура);
			ЕстьНаСайте = Ложь;
			ШКВарианта = ШтрихкодыВарианта1С.Получить(КлючВарианта);
			Если ШКВарианта <> Неопределено Тогда
				Для Каждого ШК Из ШКВарианта Цикл
					Если ШтрихкодыСайта.Получить(ШК) <> Неопределено Тогда
						ЕстьНаСайте = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Если НЕ ЕстьНаСайте Тогда
				Пропущено = Пропущено + 1;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураВыгрузки = ПолучитьСтруктруДляЦен();	
		Номенклатура = СтрокаТаблицы.Номенклатура;
		СтруктураВыгрузки.model = Строка(Номенклатура.УникальныйИдентификатор());
		
		Если НЕ ХарактеристикиИспользуются Тогда
			СтруктураВыгрузки.variant_external_id = СтруктураВыгрузки.model;
		Иначе
			Если ЗначениеЗаполнено(СтрокаТаблицы.Характеристика) Тогда
				Характеристика = СтрокаТаблицы.Характеристика;
				СтруктураВыгрузки.variant_external_id = Строка(Характеристика.УникальныйИдентификатор());
			Иначе
				СтруктураВыгрузки.variant_external_id = СтруктураВыгрузки.model;
			КонецЕсли;
		КонецЕсли;

		ТекстСкидки = "";
		Если СкидкиСкладаСкидок <> Неопределено Тогда
			ЦветВарианта = Неопределено;
			Попытка
				ЦветВарианта = СтрокаТаблицы.Характеристика.Цвет;
			Исключение
			КонецПопытки;
			Скидка = Неопределено;
			ПоЦветам = СкидкиСкладаСкидок.Получить(Номенклатура);
			Если ПоЦветам <> Неопределено И ЦветВарианта <> Неопределено Тогда
				Скидка = ПоЦветам.Получить(ЦветВарианта);
			КонецЕсли;
			Если Скидка = Неопределено Тогда
				Скидка = 0;
			КонецЕсли;
			Если СтрокаТаблицы.ЦенаДоСкидки <> 0 Тогда
				СтрокаТаблицы.Цена = Окр(СтрокаТаблицы.ЦенаДоСкидки * (100 - Скидка) / 100, 2);
			КонецЕсли;
			ТекстСкидки = ", скидка склада скидок " + Формат(Скидка, "ЧН=0; ЧГ=0") + "%";
		КонецЕсли;
		
		//@skip-check bsl-legacy-check-expression-type
		//Если СтрокаТаблицы.Цена <> 0 Тогда
		//	СтруктураВыгрузки.price = Формат(СтрокаТаблицы.Цена, "ЧГ=;ЧРД=.");
		//Иначе
		//	СтруктураВыгрузки.price = "";			
		//КонецЕсли;  
		
		Если СтрокаТаблицы.Цена = 0 И СтрокаТаблицы.ЦенаДоСкидки = 0 Тогда
			СтруктураВыгрузки.Удалить("manual_discount_price");
			СтруктураВыгрузки.Удалить("price");
		ИначеЕсли СтрокаТаблицы.Цена > СтрокаТаблицы.ЦенаДоСкидки Тогда
			СтруктураВыгрузки.price = Формат(СтрокаТаблицы.Цена, "ЧГ=;ЧРД=.");
			СтруктураВыгрузки.manual_discount_price = СтруктураВыгрузки.price;
		ИначеЕсли СтрокаТаблицы.Цена = 0 Тогда
			СтруктураВыгрузки.price = Формат(СтрокаТаблицы.ЦенаДоСкидки, "ЧГ=;ЧРД=.");
			СтруктураВыгрузки.manual_discount_price = СтруктураВыгрузки.price;
		ИначеЕсли СтруктураВыгрузки.price = 0 Тогда
			СтруктураВыгрузки.manual_discount_price = Формат(СтрокаТаблицы.Цена, "ЧГ=;ЧРД=.");
			СтруктураВыгрузки.price = СтруктураВыгрузки.manual_discount_price;
		Иначе
			СтруктураВыгрузки.price = Формат(СтрокаТаблицы.ЦенаДоСкидки, "ЧГ=;ЧРД=.");
			СтруктураВыгрузки.manual_discount_price = Формат(СтрокаТаблицы.Цена, "ЧГ=;ЧРД=.");
		КонецЕсли; 
		
		//new.kixbox.ru: скидки нет (цена со скидкой = цене до скидки) - цену со скидкой не передаем,
		//а сбрасываем: null в manual_discount_price, иначе на сайте осталась бы старая цена со скидкой
		Если СкидкиСкладаСкидок <> Неопределено И СтруктураВыгрузки.Свойство("price") И СтруктураВыгрузки.Свойство("manual_discount_price")
			И СтруктураВыгрузки.manual_discount_price = СтруктураВыгрузки.price Тогда
			СтруктураВыгрузки.manual_discount_price = Неопределено;
		КонецЕсли;
				
		МассивВыгрузки.Добавить(СтруктураВыгрузки);		
		
		Если СкидкиПоШтрихкодам <> Неопределено Тогда
			//та же логика, что выше: скидка есть, только если цена со скидкой > 0 и меньше цены до скидки
			ПроцентСкидки = 0;
			Если СтрокаТаблицы.Цена > 0 И СтрокаТаблицы.ЦенаДоСкидки > СтрокаТаблицы.Цена Тогда
				ПроцентСкидки = Окр((1 - СтрокаТаблицы.Цена / СтрокаТаблицы.ЦенаДоСкидки) * 100, 0);
			КонецЕсли;
			КлючВарианта = ?(ЗначениеЗаполнено(СтрокаТаблицы.Характеристика), СтрокаТаблицы.Характеристика, СтрокаТаблицы.Номенклатура);
			ШКВарианта = ШтрихкодыДляСкидок.Получить(КлючВарианта);
			Если ШКВарианта <> Неопределено Тогда
				Для Каждого ШК Из ШКВарианта Цикл
					СкидкиПоШтрихкодам.Вставить(ШК, ПроцентСкидки);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		Если Узел.Свойство("ПоказатьОтправку") Тогда
			Сообщить("Цены: " + СокрЛП(Номенклатура.Артикул) + " " + Строка(СтрокаТаблицы.Характеристика) 
				+ " [" + СтруктураВыгрузки.variant_external_id + "]"
				+ " | в 1С: цена до скидки " + Формат(СтрокаТаблицы.ЦенаДоСкидки, "ЧГ=0; ЧН=0")
				+ ", цена со скидкой " + Формат(СтрокаТаблицы.Цена, "ЧГ=0; ЧН=0") + ТекстСкидки
				+ " | на сайт: price " + ЗначениеДляЛога(СтруктураВыгрузки, "price")
				+ ", manual_discount_price " + ЗначениеДляЛога(СтруктураВыгрузки, "manual_discount_price"));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ШтрихкодыВарианта1С <> Неопределено Тогда
		Сообщить("Цены: вариантов есть на сайте - " + Формат(МассивВыгрузки.Количество(), "ЧН=0; ЧГ=0") 
			+ ", пропущено (нет на сайте или в архиве) - " + Формат(Пропущено, "ЧН=0; ЧГ=0"));
		Если МассивВыгрузки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	API_ОтправитьЦеныНаСайт(МассивВыгрузки, Узел, ДатаВыгрузки);
	
	Если СкидкиПоШтрихкодам <> Неопределено И СкидкиПоШтрихкодам.Количество() > 0 Тогда
		СообщитьЭтап("Характеристика «Скидка, %»: сверка с сайтом...");
		ОбновитьХарактеристикуСкидки(СкидкиПоШтрихкодам, Узел);
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьТипыВарианта(Вариант, Номенклатура, Узел)
    Если НЕ Узел.Свойство("ТипыДляКаталога") Тогда
        Возврат;
    КонецЕсли;
    Типы = Узел.ТипыДляКаталога.Получить(Номенклатура);
    Если Типы = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Для Каждого Уровень Из Типы Цикл
        Если ЗначениеЗаполнено(Уровень.value) Тогда
            Если ТипЗнч(Вариант.characteristics) <> Тип("Массив") Тогда
                Вариант.characteristics = Новый Массив;
            КонецЕсли;
            Вариант.characteristics.Добавить(Уровень);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПолучитьСтруктуруВарианта(НастройкиПолей)

	СтруктураВарианта = Новый Структура;
	СтруктураВарианта.Вставить("external_id");
	СтруктураВарианта.Вставить("stocks");
	СтруктураВарианта.Вставить("characteristics");
	СтруктураВарианта.Вставить("product");
	СтруктураВарианта.Вставить("dimensions");
	СтруктураВарианта.Вставить("vat");
		
	Для Каждого ИмяПоля Из НастройкиПолей.МассивПолей Цикл
		СтруктураВарианта.Вставить(ИмяПоля);
	КонецЦикла;
	
	Возврат СтруктураВарианта;
	
КонецФункции

// B2B принимает external_id. Проверяем его связь с закреплённым внутренним ID KIT.
Функция ВнешнийИДСкладаДляОстатков(Склад, Узел)
    ВнешнийИД = Строка(Склад.УникальныйИдентификатор());
    Если Узел = Неопределено Или НЕ Узел.Свойство("ИДСкладовКИТ") Тогда
        Возврат ВнешнийИД;
    КонецЕсли;
    Если Узел.ПроверенныеСкладыB2B.Получить(Склад) <> Неопределено Тогда
        Возврат ВнешнийИД;
    КонецЕсли;
    ИДКИТ = Узел.ИДСкладовКИТ.Получить(Склад.Код);
    Если НЕ ЗначениеЗаполнено(ИДКИТ) Тогда
        ВызватьИсключение "Не задан ID KIT для склада 1С " + Склад.Код;
    КонецЕсли;
    Ответ = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/warehouses/by_external_id/" + ВнешнийИД);
    Если Ответ.КодСостояния <> 200 Тогда
        ВызватьИсключение "Проверка склада " + Склад.Код + " в B2B KIT: HTTP " + Строка(Ответ.КодСостояния);
    КонецЕсли;
    Данные = ОтветПубличногоAPIKIT(Ответ);
    Если ТипЗнч(Данные) <> Тип("Соответствие") Или Данные.Получить("id") <> ИДКИТ Тогда
        ВызватьИсключение "B2B KIT не подтвердил ID " + ИДКИТ + " для склада 1С " + Склад.Код;
    КонецЕсли;
    Если Данные.Получить("status") = "ARCHIVED" Тогда
        ВызватьИсключение "Склад KIT в архиве: " + ИДКИТ;
    КонецЕсли;
    Узел.ПроверенныеСкладыB2B.Вставить(Склад, ИДКИТ);
    Возврат ВнешнийИД;
КонецФункции

Функция ПроверитьОбновитьСклады(Узел)
    Если Узел.Свойство("ИДСкладовКИТ") Тогда
        ВнешнийИДСкладаДляОстатков(Узел.ОсновнойСклад, Узел);
        Возврат Истина;
    КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	//// TODO: сделать общую функцию для получения складов
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//|	янд_ОбменСайтомСклады.Склад
	//|ИЗ
	//|	ПланОбмена.янд_ОбменСайтом.Склады КАК янд_ОбменСайтомСклады
	//|ГДЕ
	//|	янд_ОбменСайтомСклады.Ссылка = &Ссылка";
	//Запрос.УстановитьПараметр("Ссылка", Узел);
	//ТаблицаСкладов = Запрос.Выполнить().Выгрузить();
	//	
	//Туктаров Р.Р. 19/08/2026+
	Если Узел.ОсновнойСклад <> Справочники.Склады.ПустаяСсылка() Тогда
		 СкладСоздан = ПроверитьСкладНаСайте(Узел.ОсновнойСклад, Узел); 
		
		Если НЕ СкладСоздан Тогда                                                      
			ЕстьОшибки = СоздатьСкладНаСайте(Узел.ОсновнойСклад, Узел);		
		КонецЕсли;
	Иначе
		ТаблицаСкладов = Узел.Склады;
		
		Для Каждого СтрокаТаблицы Из ТаблицаСкладов Цикл
			СкладСоздан = ПроверитьСкладНаСайте(СтрокаТаблицы.Склад, Узел); 
			
			Если НЕ СкладСоздан Тогда                                                      
				ЕстьОшибки = СоздатьСкладНаСайте(СтрокаТаблицы.Склад, Узел);
				
				Если ЕстьОшибки Тогда
					Прервать;
				КонецЕсли;			
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

Функция НайтиХарактеристикуНаСайтеПоНазванию(Название, Узел)
	
	// Возвращает Неопределено, если запрос не удался, иначе структуру:
	//   ВнешнийИД     - external_id активной характеристики с таким названием (если есть)
	//   ИДБезВнешнего - id активной характеристики с таким названием без external_id (если есть)
	
	Результат = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/characteristics");
	Если Результат.КодСостояния <> 200 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Список = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку());
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Найдено = Новый Структура("ВнешнийИД, ИДБезВнешнего", "", "");
	
	Для Каждого Элемент Из Список Цикл
		
		Если ТипЗнч(Элемент) <> Тип("Структура") ИЛИ НЕ Элемент.Свойство("title") Тогда
			Продолжить;
		КонецЕсли;
		Если Элемент.title = Неопределено ИЛИ НРег(СокрЛП(Строка(Элемент.title))) <> НРег(Название) Тогда
			Продолжить;
		КонецЕсли;
		
		Статус = "";
		Если Элемент.Свойство("status") И Элемент.status <> Неопределено Тогда
			Статус = Строка(Элемент.status);
		КонецЕсли;
		Если Статус = "ARCHIVED" Тогда
			Продолжить;
		КонецЕсли;
		
		ВнешнийИД = "";
		Если Элемент.Свойство("external_id") И Элемент.external_id <> Неопределено Тогда
			ВнешнийИД = СокрЛП(Строка(Элемент.external_id));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВнешнийИД) Тогда
			Найдено.ВнешнийИД = ВнешнийИД;
		ИначеЕсли Элемент.Свойство("id") И Элемент.id <> Неопределено Тогда
			Найдено.ИДБезВнешнего = Строка(Элемент.id);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Найдено;
	
КонецФункции

Функция ПроверитьОбновитьХарактеристики(МассивХарактеристик, Узел)
	
	ЕстьОшибки = Ложь;
	
	Для Каждого СтрокаХарактеристики Из МассивХарактеристик Цикл

		ИдентификаторДляСайта = "%1_%2";
		ИдентификаторДляСайта = СтрШаблон(ИдентификаторДляСайта, СтрокаХарактеристики.РодительТип, 
			СтрокаХарактеристики.Идентификатор);
		
		//Свои внешний ID и слаг характеристики для сайта (new.kixbox.ru: Цвет -> color, Размер -> size)
		СлагХарактеристики = "";
		ХарактеристикиСайта = Неопределено;
		Если Узел.Свойство("ХарактеристикиСайта", ХарактеристикиСайта) И ХарактеристикиСайта <> Неопределено Тогда
			НовыйИД = ХарактеристикиСайта.Получить(ИдентификаторДляСайта);
			Если НовыйИД <> Неопределено Тогда
				ИдентификаторДляСайта = НовыйИД;
				СлагХарактеристики = НовыйИД;
			КонецЕсли;
		КонецЕсли;

		ТипЗначенияХарактеристики = ОпределитьТипЗначенияХарактеристики(СтрокаХарактеристики.ПолеТип);
		СтрокаХарактеристики.Вставить("ОписаниеТипа", 	ТипЗначенияХарактеристики);
		СтрокаХарактеристики.Вставить("external_id", 	ИдентификаторДляСайта);

		Если СтрокаХарактеристики.Свойство("ВнешнийИДНаСайте") Тогда
			СтрокаХарактеристики.external_id = СтрокаХарактеристики.ВнешнийИДНаСайте;
			Продолжить;
		КонецЕсли;
		
		СтруктураХарактеристики = Новый Структура;
		СтруктураХарактеристики.Вставить("title",		СтрокаХарактеристики.ПолеИмя);
		СтруктураХарактеристики.Вставить("type",		ТипЗначенияХарактеристики);
		СтруктураХарактеристики.Вставить("select_mode",	"MULTIPLE");
		СтруктураХарактеристики.Вставить("external_id",	ИдентификаторДляСайта);
		//Слаг задается только при создании характеристики
		Если ЗначениеЗаполнено(СлагХарактеристики) Тогда
			СтруктураХарактеристики.Вставить("slug", СлагХарактеристики);
		КонецЕсли;
		Если СтрокаХарактеристики.РодительТип = "Характеристика" Тогда
			СтруктураХарактеристики.Вставить("is_grouping", Истина);
		Иначе
			СтруктураХарактеристики.Вставить("is_grouping", Ложь);	
		КонецЕсли;
		
		ДанныеХарактеристики = ПроверитьХарактеристикуНаСайте(ИдентификаторДляСайта, Узел);
		
		Если ДанныеХарактеристики.ХарактеристикаСуществует Тогда		
			ПараметрыХарактеристики = ДанныеХарактеристики.ПараметрыХарактеристики; 
			
			Если ПараметрыХарактеристики.title <> СтруктураХарактеристики.title 
				ИЛИ ПараметрыХарактеристики.is_grouping <> СтруктураХарактеристики.is_grouping Тогда
				Если СтруктураХарактеристики.Свойство("slug") Тогда
					СтруктураХарактеристики.Удалить("slug");
				КонецЕсли;
				ЕстьОшибки = ОбновитьХарактеристикуНаСайте(СтруктураХарактеристики, Узел);	
			КонецЕсли;
		Иначе
			ЕстьОшибки = СоздатьХарактеристикуНаСайте(СтруктураХарактеристики, Узел);
		КонецЕСли;
	КонецЦикла;
	
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

Функция ПолучитьТаблицуГабаритов(ДанныеНоменклатуры)
	
	ТаблицаГабаритов = Новый ТаблицаЗначений;
	ТаблицаГабаритов.Колонки.Добавить("Номенклатура", 	Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаГабаритов.Колонки.Добавить("length", 		Новый ОписаниеТипов("Строка"));
	ТаблицаГабаритов.Колонки.Добавить("width", 			Новый ОписаниеТипов("Строка"));
	ТаблицаГабаритов.Колонки.Добавить("height", 		Новый ОписаниеТипов("Строка"));
	ТаблицаГабаритов.Колонки.Добавить("weight", 		Новый ОписаниеТипов("Строка"));
	
	Для Каждого Строка Из ДанныеНоменклатуры Цикл
		Номенклатура = Строка.Номенклатура;
		
		Если ЗначениеЗаполнено(Номенклатура.ВесЧислитель) И ЗначениеЗаполнено(Номенклатура.ВесЗнаменатель) 
				И ЗначениеЗаполнено(Номенклатура.ВесЕдиницаИзмерения) Тогда  
			Вес = Номенклатура.ВесЧислитель/Номенклатура.ВесЗнаменатель;
			Если Номенклатура.ВесЕдиницаИзмерения.МеждународноеСокращение = "KGM" Тогда
				Вес = Вес * 1000;
			ИначеЕсли Номенклатура.ВесЕдиницаИзмерения.МеждународноеСокращение = "TNE" Тогда
				Вес = Вес * 1000000;	
			КонецЕсли;
		Иначе 
			Вес = 0;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Номенклатура.ДлинаЧислитель) И ЗначениеЗаполнено(Номенклатура.ДлинаЗнаменатель) 
				И ЗначениеЗаполнено(Номенклатура.ДлинаЕдиницаИзмерения) Тогда
			Длина   = Номенклатура.ДлинаЧислитель/Номенклатура.ДлинаЗнаменатель;
			Если Номенклатура.ДлинаЕдиницаИзмерения.МеждународноеСокращение = "MTR" Тогда
				Длина = Длина * 100;
			ИначеЕсли Номенклатура.ДлинаЕдиницаИзмерения.МеждународноеСокращение = "DMT" Тогда
				Длина = Длина * 10;
			ИначеЕсли Номенклатура.ДлинаЕдиницаИзмерения.МеждународноеСокращение = "MMT" Тогда
				Длина = Длина / 100;
			КонецЕсли;
		Иначе
			Длина = 0;
		КонецЕсли;
		
		Если Длина <> 0 Тогда
			Если ЗначениеЗаполнено(Номенклатура.ПлощадьЧислитель) И ЗначениеЗаполнено(Номенклатура.ПлощадьЗнаменатель) 
					И ЗначениеЗаполнено(Номенклатура.ПлощадьЕдиницаИзмерения) Тогда	
				Если Номенклатура.ПлощадьЕдиницаИзмерения.МеждународноеСокращение = "MTK" Тогда
					ПлощадьЧислитель = Номенклатура.ПлощадьЧислитель * 10000;
				ИначеЕсли Номенклатура.ПлощадьЕдиницаИзмерения.МеждународноеСокращение = "MMK" Тогда
					ПлощадьЧислитель = Номенклатура.ПлощадьЧислитель / 10000;
				ИначеЕсли Номенклатура.ПлощадьЕдиницаИзмерения.МеждународноеСокращение = "MMK" Тогда
					ПлощадьЧислитель = Номенклатура.ПлощадьЧислитель * 100;
				Иначе
					ПлощадьЧислитель = Номенклатура.ПлощадьЧислитель;
				КонецЕсли;
				Ширина = Окр((ПлощадьЧислитель/Номенклатура.ПлощадьЗнаменатель/Длина), 2, РежимОкругления.Окр15как20);
			Иначе
				Ширина = 0;
			КонецЕсли;
		Иначе
			Ширина = 0;
		КонецЕсли;
		
		Если Длина <> 0 И Ширина <> 0 Тогда
			Если ЗначениеЗаполнено(Номенклатура.ОбъемЧислитель) И ЗначениеЗаполнено(Номенклатура.ОбъемЗнаменатель) 
					И ЗначениеЗаполнено(Номенклатура.ОбъемЕдиницаИзмерения) Тогда	
				Если Номенклатура.ОбъемЕдиницаИзмерения.МеждународноеСокращение = "MTQ" Тогда
					ОбъемЧислитель = Номенклатура.ОбъемЧислитель * 1000000;
				ИначеЕсли Номенклатура.ОбъемЕдиницаИзмерения.МеждународноеСокращение = "MMQ" Тогда
					ОбъемЧислитель = Номенклатура.ОбъемЧислитель / 1000000;
				ИначеЕсли Номенклатура.ОбъемЕдиницаИзмерения.МеждународноеСокращение = "LTR" 
						ИЛИ Номенклатура.ОбъемЕдиницаИзмерения.МеждународноеСокращение = "DMQ" Тогда
					ОбъемЧислитель = Номенклатура.ОбъемЧислитель * 1000;
				Иначе
					ОбъемЧислитель = Номенклатура.ОбъемЧислитель;
				КонецЕсли;			
				Высота  = Окр((ОбъемЧислитель/Номенклатура.ОбъемЗнаменатель/Длина/Ширина), 2, 
					РежимОкругления.Окр15как20);
			Иначе
				Высота = 0;
			КонецЕсли;
		Иначе
			Высота = 0;
		КонецЕсли;
		
		НоваяСтрокаТаблицы 				= ТаблицаГабаритов.Добавить();
		НоваяСтрокаТаблицы.Номенклатура = Номенклатура;
		НоваяСтрокаТаблицы.length 		= Формат(Длина, 	"ЧГ=;ЧРД=.");
		НоваяСтрокаТаблицы.width  		= Формат(Ширина, 	"ЧГ=;ЧРД=.");
		НоваяСтрокаТаблицы.height 		= Формат(Высота, 	"ЧГ=;ЧРД=.");
		НоваяСтрокаТаблицы.weight		= Формат(Вес, 		"ЧГ=;ЧРД=.");
	КонецЦикла;
	
	Возврат ТаблицаГабаритов;

КонецФункции

Процедура ЗаполнитьОсновныеРеквизитыВарианта(ДанныеВарианта, СтруктураВарианта, ТаблицаРазмеров, НастройкиПолей, НастройкиЗаполненияНДС)
	
	СтруктураРазмеров = ПолучитьРазмерыДляВарианта(ДанныеВарианта, ТаблицаРазмеров, 
		НастройкиПолей.ИспользоватьТиповыеГабаритыТоваров);
	
	ЗаполнитьЗначенияСвойств(СтруктураВарианта, ДанныеВарианта, НастройкиПолей.Поля);
		
	Если СтруктураВарианта.price <> 0 Тогда
		СтруктураВарианта.price = Формат(СтруктураВарианта.price, "ЧГ=;ЧРД=.");
	Иначе
		СтруктураВарианта.Удалить("price");	
	КонецЕсли;	
	
	Если НастройкиЗаполненияНДС.ПередаватьСтавкиНДС Тогда  
		СтавкаНДС = Перечисления.СтавкиНДС.НДС22; //УчетНДСУП.СтавкаНДСПоНоменклатуреИНалогообложению(ДанныеВарианта.Номенклатура, НастройкиЗаполненияНДС.НалогообложениеНДС,																НастройкиЗаполненияНДС.Организация, НастройкиЗаполненияНДС.Дата, Неопределено);
		Если ЗначениеЗаполнено(СтавкаНДС) Тогда
			//Если СтавкаНДС.ИмяПредопределенныхДанных = "БезНДС" Тогда 
			//	СтруктураВарианта.vat = -1;	
			//Иначе	
				СтруктураВарианта.vat = СтавкаНДС;//.Ставка;
			//КонецЕсли;
		Иначе
			СтруктураВарианта.Удалить("vat");
		КонецЕсли;
	Иначе
		СтруктураВарианта.Удалить("vat");
	КонецЕсли;
	
	СтруктураВарианта.dimensions = СтруктураРазмеров;
	
КонецПроцедуры

Процедура ДобавитьНулевыеОстатки(МассивОстатков, Узел)
	
	ОбнулитьСклады = Неопределено;
	Если Узел = Неопределено ИЛИ НЕ Узел.Свойство("ОбнулитьСклады", ОбнулитьСклады) ИЛИ ОбнулитьСклады = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Склад Из ОбнулитьСклады Цикл
		Если НЕ ЗначениеЗаполнено(Склад) Тогда
			Продолжить;
		КонецЕсли;
		УИДСклада = ВнешнийИДСкладаДляОстатков(Склад, Узел);
		Есть = Ложь;
		Для Каждого Остаток Из МассивОстатков Цикл
			Если Остаток.external_id = УИДСклада Тогда
				Есть = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Есть Тогда
			МассивОстатков.Добавить(Новый Структура("external_id, quantity", УИДСклада, 0));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Русские цвета из доп. свойства характеристик «Цвет для этикетки».
// Возвращает Соответствие: ХарактеристикаНоменклатуры -> строка вида «Бордовый» (первая буква заглавная).
Функция ПолучитьЦветаДляЭтикетки(ДеревоДанных)
	
	Характеристики = Новый Массив;
	Для Каждого СтрокаНоменклатуры Из ДеревоДанных.Строки Цикл
		Для Каждого СтрокаХарактеристики Из СтрокаНоменклатуры.Строки Цикл
			Если ЗначениеЗаполнено(СтрокаХарактеристики.Характеристика) Тогда
				Характеристики.Добавить(СтрокаХарактеристики.Характеристика);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Цвета = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	З.Объект КАК Характеристика,
	|	ПРЕДСТАВЛЕНИЕ(З.Значение) КАК Цвет
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК З
	|ГДЕ
	|	З.Объект В (&Характеристики)
	|	И З.Свойство.Наименование = ""Цвет для этикетки""";
	Запрос.УстановитьПараметр("Характеристики", Характеристики);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Цвет = СокрЛП(Выборка.Цвет);
		Если НЕ ПустаяСтрока(Цвет) Тогда
			Цвета.Вставить(Выборка.Характеристика, ВРег(Лев(Цвет, 1)) + НРег(Сред(Цвет, 2)));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Цвета;
	
КонецФункции

Процедура ЗаполнитьОстаткиВарианта(ДанныеОстатков, СтруктураВарианта, Узел = Неопределено)
	
	МассивОстатков = Новый Массив;
	
	Для Каждого СтрокаОстатков Из ДанныеОстатков Цикл
		Склад = СтрокаОстатков.Склад;
		УИДСклада = ВнешнийИДСкладаДляОстатков(Склад, Узел);
		
		СтруктураОстаткаНаСкладе = Новый Структура;
		СтруктураОстаткаНаСкладе.Вставить("external_id", 	УИДСклада);
		СтруктураОстаткаНаСкладе.Вставить("quantity", 		СтрокаОстатков.Остаток);
		
		МассивОстатков.Добавить(СтруктураОстаткаНаСкладе);
	КонецЦикла;
	
	ОбнулитьОтрицательныеОстатки(МассивОстатков);
	Если Узел <> Неопределено И СтруктураВарианта.Свойство("external_id") Тогда
		ВычестьРезервКомплектации(МассивОстатков, СтруктураВарианта.external_id, Узел);
	КонецЕсли;
	ДобавитьНулевыеОстатки(МассивОстатков, Узел);
	СтруктураВарианта.Вставить("stocks", МассивОстатков); 
	
КонецПроцедуры

Функция ПолДляСайта(Знач Значение)
	
	Текст = СокрЛП(Значение);
	Ключ = НРег(Текст);
	
	Если Ключ = "муж" Тогда
		Возврат "Мужской";
	ИначеЕсли Ключ = "жен" Тогда
		Возврат "Женский";
	ИначеЕсли Ключ = "дет" Тогда
		Возврат "Детский";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Процедура ЗаполнитьХарактеристикиВарианта(ДанныеВарианта, СтруктураВарианта, МассивХарактеристик);
	
	МассивХарактеристикДляСайта = Новый Массив;
	
	Для Каждого СтрокаХарактеристики Из МассивХарактеристик Цикл
		
		Если СтрокаХарактеристики.ПолеТип = Новый ОписаниеТипов("Булево") и ДанныеВарианта[СтрокаХарактеристики.Идентификатор] = NULL  Тогда
			ДанныеВарианта[СтрокаХарактеристики.Идентификатор] = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ДанныеВарианта[СтрокаХарактеристики.Идентификатор]) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаХарактеристики.ОписаниеТипа = "INT" Тогда
			ЗначениеХарактеристики = ДанныеВарианта[СтрокаХарактеристики.Идентификатор];
		Иначе
			ЗначениеХарактеристики = Строка(ДанныеВарианта[СтрокаХарактеристики.Идентификатор]);
		КонецЕсли;		 
		
		Если СтрокаХарактеристики.ПолеИмя = "Пол" Тогда
			ЗначениеХарактеристики = ПолДляСайта(ЗначениеХарактеристики);
		КонецЕсли;
		
		//new.kixbox.ru (характеристика size): "US8.5" -> "8.5 US", иначе KIT сортирует размеры как текст (US10 раньше US8)
		Если СтрокаХарактеристики.external_id = "size" Тогда
			ЗначениеХарактеристики = РазмерЧисломВперед(ЗначениеХарактеристики);
		КонецЕсли;
		
		СтруктураХарактеристики = Новый Структура;
		СтруктураХарактеристики.Вставить("external_id", СтрокаХарактеристики.external_id);
		СтруктураХарактеристики.Вставить("value", 		ЗначениеХарактеристики);
		СтруктураХарактеристики.Вставить("name",		СтрокаХарактеристики.ПолеИмя);
		
		МассивХарактеристикДляСайта.Добавить(СтруктураХарактеристики);
	КонецЦикла;
	
	СтруктураВарианта.characteristics = МассивХарактеристикДляСайта;
	
КонецПроцедуры

// Размер с системой размеров впереди ("US8.5", "UK 10", "EU42") -> число впереди ("8.5 US", "10 UK", "42 EU").
// KIT сортирует размеры на карточке по числу в начале строки; буквенные размеры (S, M, XL, ONE SIZE) не меняются.
Функция РазмерЧисломВперед(Значение)
	
	Стр = СокрЛП(Строка(Значение));
	ВСтр = ВРег(Стр);
	Префиксы = СтрРазделить("US,UK,EU,FR,IT,JP,RU", ",");
	Для Каждого Префикс Из Префиксы Цикл
		Если Лев(ВСтр, СтрДлина(Префикс)) = Префикс Тогда
			Остаток = СокрЛП(Сред(Стр, СтрДлина(Префикс) + 1));
			Если СтрДлина(Остаток) > 0 И СтрНайти("0123456789", Лев(Остаток, 1)) > 0 Тогда
				Возврат СтрЗаменить(Остаток, ",", ".") + " " + Префикс;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Стр;
	
КонецФункции

// Имя фото - то же, что в 1С: функция ПроцедурыОбменаССайтом.ПолучитьИмяДляФото(Номенклатура, Цвет)
// (ею считает поле «Имя фото» отчет «Анализ продаж \ прибыли \ остатков»).
// Вызов через Вычислить: если общий модуль недоступен на клиенте, обработка все равно откроется.
// Запасной вариант, если функция недоступна: Сезон_Марка_Артикул_Цвет (запятые убираются, пробелы и "/" -> "-"),
// по InSales 03.11.2026 совпадает у 23 955 из 23 964 карточек.
Функция ИмяФотоВарианта(Номенклатура, Характеристика, Артикул, Марка, Характеристики, Узел)
	
	Если ЗначениеЗаполнено(Характеристика) И НЕ Узел.Свойство("ИмяФотоПоПравилу") Тогда
		Попытка
			ЦветХарактеристики = Характеристика.Цвет;
			ИмяИз1С = Вычислить("ПроцедурыОбменаССайтом.ПолучитьИмяДляФото(Номенклатура, ЦветХарактеристики)");
			Возврат СокрЛП(Строка(ИмяИз1С));
		Исключение
			Узел.Вставить("ИмяФотоПоПравилу", Истина);
			Сообщить("Имя фото: функция ПроцедурыОбменаССайтом.ПолучитьИмяДляФото недоступна (" 
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + "), имя собирается по правилу Сезон_Марка_Артикул_Цвет");
		КонецПопытки;
	КонецЕсли;
	
	Цвет = "";
	Для Каждого Хар Из Характеристики Цикл
		ВнешнийИД = Неопределено;
		Если Хар.Свойство("external_id", ВнешнийИД) И ВнешнийИД = "color" И Хар.Свойство("value") Тогда
			Цвет = СокрЛП(Строка(Хар.value));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Сезон = СокрЛП(Строка(Номенклатура.Сезон));
	Если НЕ ЗначениеЗаполнено(Сезон) ИЛИ НЕ ЗначениеЗаполнено(Марка) ИЛИ НЕ ЗначениеЗаполнено(Артикул) ИЛИ НЕ ЗначениеЗаполнено(Цвет) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ЧастьИмениФото(Сезон) + "_" + ЧастьИмениФото(Марка) + "_" + ЧастьИмениФото(Артикул) + "_" + ЧастьИмениФото(Цвет);
	
КонецФункции

Функция ЧастьИмениФото(Знач Значение)
	
	Значение = СокрЛП(Значение);
	Значение = СтрЗаменить(Значение, ",", "");
	Значение = СтрЗаменить(Значение, " ", "-");
	Значение = СтрЗаменить(Значение, "/", "-");
	Возврат Значение;
	
КонецФункции

// Русский цвет для фильтров new.kixbox.ru: реквизит ДопХар значения цвета характеристики.
// Приводим к одному виду: «ё» -> «е», регистр «Черный» (не «ЧЕРНЫЙ»), части через « / ».
// new.kixbox.ru. Категория для фильтра на витрине (характеристика category «Категория»).
// Значение - название второго уровня типа товара (родитель типа): «Джинсы», «Брюки», «Кроссовки низкие».
// Уходит строкой, поэтому одноимённые уровни из разделов «Мужчины» / «Женщины» / «Унисекс» дают одно значение фильтра.
// Названия приводятся к множественному числу («Футболка» -> «Футболки»); чего нет в таблице - уходит как в 1С.
Функция КатегорияДляФильтра(Номенклатура, Узел)
	
	Замены = Неопределено;
	Если НЕ Узел.Свойство("ЗаменыКатегорийФильтра", Замены) ИЛИ ТипЗнч(Замены) <> Тип("Соответствие") Тогда
		Замены = Новый Соответствие;
		Замены.Вставить("футболка", "Футболки");
		Замены.Вставить("футболка дл. рукав", "Футболки дл. рукав");
		Замены.Вставить("футболка кор. рукав", "Футболки кор. рукав");
		Замены.Вставить("толстовка с капюшоном", "Толстовки с капюшоном");
		Замены.Вставить("толстовка без капюшона", "Толстовки без капюшона");
		Замены.Вставить("толстовка на молнии (half-zip)", "Толстовки на молнии (half-zip)");
		Замены.Вставить("куртка", "Куртки");
		Замены.Вставить("куртка джинсовая", "Куртки джинсовые");
		Замены.Вставить("куртка демисезонная", "Куртки демисезонные");
		Замены.Вставить("рубашка", "Рубашки");
		Замены.Вставить("рубашка поло", "Рубашки поло");
		Замены.Вставить("рубашка джинсовая", "Рубашки джинсовые");
		Замены.Вставить("рубашка джерси", "Рубашки джерси");
		Замены.Вставить("рубашка с капюшоном", "Рубашки с капюшоном");
		Замены.Вставить("пуховик", "Пуховики");
		Замены.Вставить("олимпийка", "Олимпийки");
		Замены.Вставить("топ", "Топы");
		Замены.Вставить("топ вязаный", "Топы вязаные");
		Замены.Вставить("топ джерси", "Топы джерси");
		Замены.Вставить("платье", "Платья");

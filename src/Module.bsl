				ДокОбъект = Документы.ЗаказПокупателя.СоздатьДокумент(); 
				
				//Заполним заказ сразу.   
				ЗаполнитьЗаказССайта(ДокОбъект,ДанныеТекЗаказа.ДанныеЗаполнения, Узел);
				Сообщить("Создали заказ №"+Выборка.IDЗаказа);
				//ДокОбъект.Заполнить(ДанныеЗаказа.Получить(Выборка.IDЗаказа));
				СтруктураЗаказаЧист = Новый Структура;
				//ПодтвердитьЗаказ(СтруктураЗаказаЧист,ДанныеТекЗаказа.ДанныеЗаполнения.id,Узел);	
				Сообщить("Подтвердили заказ №"+Выборка.IDЗаказа);
			КонецЕсли
		КонецЕсли;
		
		//Попытка

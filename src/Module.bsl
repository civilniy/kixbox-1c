// Возвращаемое значение:
//   Структура - Содержит информацию о существовании характеристики и ее параметрах
Функция ПроверитьХарактеристикуНаСайте(Характеристика, Узел) Экспорт

	ТекстЗапроса = "/api/public/v1/characteristics/by_external_id/%1";
	Метод = "GET";
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, Характеристика);
		
	Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса);
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("ХарактеристикаСуществует", Ложь);
	РезультатПроверки.Вставить("ПараметрыХарактеристики", Новый Структура);
	
	Если Результат.КодСостояния = 200 Тогда		
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
		ОтветОбъект = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		РезультатПроверки.ХарактеристикаСуществует = Истина;
		РезультатПроверки.ПараметрыХарактеристики = ОтветОбъект;
	КонецЕсли;
		
	//@skip-check constructor-function-return-section
	Возврат РезультатПроверки;
	
КонецФункции

// Отправляет продукты на сайт пакетами.
//
// Параметры:
//   ДанныеВариантов - Массив из Структура - данные продуктов для отправки
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена для отправки данных
//
// Возвращаемое значение:
//   Булево - признак наличия ошибок при отправке
Функция ОтправитьПродуктыНаСайт(ДанныеПродуктов, Узел) Экспорт

	ЕстьОшибки = Ложь;
	
	ТекстЗапроса = "/api/public/v1/products/bulk";
	Метод = "POST";
	
	МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеПродуктов, Узел.Пакет);
	
	Для Каждого Пакет Из МассивПакетов Цикл
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, Пакет);

		Если Результат.КодСостояния <> 200 Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьОшибки;
	
КонецФункции

// Отправляет цены и остатки на сайт пакетами.
//
// Параметры:
//   ДанныеВариантов - Массив из Структура - данные вариантов для отправки
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена для отправки данных
//
// Возвращаемое значение:
//   Булево - признак наличия ошибок при отправке
Функция ОтправитьЦеныИОстаткиНаСайт(ДанныеВариантов, Узел) Экспорт

	ЕстьОшибки = Истина;
	
	ТекстЗапроса = "/api/public/v1/variants/bulk/offers";
	Метод = "POST";
	
	//МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеВариантов, 
	//	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Пакет")); 
	МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеВариантов, Узел.Пакет);

		
	Для Каждого Пакет Из МассивПакетов Цикл
		СтруктураОтправки = Новый Структура("offers", Пакет); 
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, СтруктураОтправки);

		Если Результат.КодСостояния = 200 Тогда  
			СообщениеРезультат = Результат.ПолучитьТелоКакстроку();
			Сообщить(СообщениеРезультат);
			//РегистрыСведений.янд_ОшибкиОбмена.ОбновитьОшибкиОбмена(Узел, Результат.ПолучитьТелоКакстроку(), Пакет);
			ЕстьОшибки = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьОшибки;	

КонецФункции

// Отправляет варианты на сайт пакетами.
//
// Параметры:
//   ДанныеВариантов - Массив из Структура - данные вариантов для отправки
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена для отправки данных
//	 ДатаВыгрузкиTimeStamp - Строка - ТипЗапроса и дата выгрузки в формате TimeStamp
//
// Возвращаемое значение:
//   Булево - признак наличия ошибок при отправке
Функция ОтправитьВариантыНаСайт(ДанныеВариантов, Узел, ДатаВыгрузкиTimeStamp, ЭтоВыгрузкаЦенОстатков) Экспорт

	ЕстьОшибки = Ложь;
	
	ШаблонЗапроса = "/api/public/v1/variants/bulk?is_mapping=%1";
	Метод = "POST";
	
	Если ЭтоВыгрузкаЦенОстатков Тогда
		ТекстЗапроса = СтрШаблон(ШаблонЗапроса, "true");		
	Иначе
		ТекстЗапроса = СтрШаблон(ШаблонЗапроса, "false");	
	КонецЕсли;	
	
	МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеВариантов, Узел.Пакет);
	КоличествоПакетов = МассивПакетов.Количество();
	СчетчикПакетов = 1;
	ЭтоПоследнийПакет = Ложь;
	
	Если ЭтоВыгрузкаЦенОстатков Тогда
		Итог = НовыйИтогВыгрузки("Варианты, is_mapping=true", ДанныеВариантов.Количество(), КоличествоПакетов);
	Иначе
		Итог = НовыйИтогВыгрузки("Варианты, is_mapping=false", ДанныеВариантов.Количество(), КоличествоПакетов);
	КонецЕсли;
	
	ПробнаяОтправка = Узел.Свойство("ПоказатьОтправку");
	ФайлЛога = Неопределено;
	ИмяФайлаЛога = "";
	Попытка
		КаталогЛогов = КаталогДокументов() + "ВыгрузкаYandex_логи";
		СоздатьКаталог(КаталогЛогов);
		ИмяФайлаЛога = КаталогЛогов + "\" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") 
			+ ?(ПробнаяОтправка, "_пробная", "_каталог") + ".txt";
		Если Узел.Свойство("ФайлыОтправкиKIT") Тогда
            ИмяФайлаЛога = Лев(ИмяФайлаЛога, СтрДлина(ИмяФайлаЛога) - 4) + "_" + Строка(Новый УникальныйИдентификатор) + ".txt";
        КонецЕсли;
        ФайлЛога = Новый ЗаписьТекста(ИмяФайлаЛога, КодировкаТекста.UTF8);
        Если Узел.Свойство("ФайлыОтправкиKIT") Тогда
            Узел.ФайлыОтправкиKIT.Добавить(ИмяФайлаЛога);
            ФайлЛога.ЗаписатьСтроку("ПРОВЕРКА ID ВАРИАНТА KIT | v1.84.2 | результат сверки в конце файла");
        КонецЕсли;
		ФайлЛога.ЗаписатьСтроку("Выгрузка Yandex " + Формат(ТекущаяДата(), "ДЛФ=DT") + ", вариантов: " + Формат(ДанныеВариантов.Количество(), "ЧГ=0") 
			+ ?(ЭтоВыгрузкаЦенОстатков, ", is_mapping=true", ", is_mapping=false"));
		ФайлЛога.ЗаписатьСтроку("");
	Исключение
		ФайлЛога = Неопределено;
		Сообщить("Файл лога не создан: " + ОписаниеОшибки());
	КонецПопытки;
	
	Для Каждого Пакет Из МассивПакетов Цикл
		
		Если СчетчикПакетов = КоличествоПакетов Тогда
			ЭтоПоследнийПакет = Истина;	
		КонецЕсли;
		
		Если Узел.Свойство("СкладСкидок") Тогда
			//new.kixbox.ru: цена в карточке была бы средней по складам; верные цены уходят отдельным шагом
			Для Каждого ВариантПакета Из Пакет Цикл
				Если ВариантПакета.Свойство("price") Тогда
					ВариантПакета.Удалить("price");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтруктураОтправки = Новый Структура("variants", Пакет); 
		
		Для Каждого ВариантЛога Из Пакет Цикл
			СтрокиЛога = ОписаниеВариантаДляЛога(ВариантЛога, Узел);
			Для Каждого СтрокаЛога Из СтрокиЛога Цикл
				Если ПробнаяОтправка Тогда
					Сообщить(СтрокаЛога);
				КонецЕсли;
				Если ФайлЛога <> Неопределено Тогда
					ФайлЛога.ЗаписатьСтроку(СтрокаЛога);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, СтруктураОтправки, ,ДатаВыгрузкиTimeStamp, ЭтоПоследнийПакет);
		Если ФайлЛога <> Неопределено Тогда
			ФайлЛога.ЗаписатьСтроку("--- Пакет " + Формат(СчетчикПакетов, "ЧГ=0") + " из " + Формат(КоличествоПакетов, "ЧГ=0") 
				+ ": ответ сайта HTTP " + Формат(Результат.КодСостояния, "ЧГ=0") + " " + Лев(Результат.ПолучитьТелоКакСтроку(), 2000));
			ФайлЛога.ЗаписатьСтроку("");
		КонецЕсли;
		УчестьОтветПакета(Итог, Результат, СчетчикПакетов, Пакет.Количество());
		ПоказатьПрогресс(Итог, СчетчикПакетов, Пакет.Количество());
		
		Если Результат.КодСостояния <> 200 Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
		
		СчетчикПакетов = СчетчикПакетов + 1;
		
	КонецЦикла;
	
	СообщитьИтогВыгрузки(Итог);
	
	Если ФайлЛога <> Неопределено Тогда
		ФайлЛога.Закрыть();
		Сообщить("Полный лог отправки: " + ИмяФайлаЛога);
	КонецЕсли;
	
	Возврат ЕстьОшибки;	

КонецФункции

// new.kixbox.ru. Сайт через b2b API (variants/bulk) не меняет характеристики уже созданных карточек,
// поэтому новая характеристика (например, «Состав») сама на старые карточки не попадает.
// После выгрузки читаем карточки сайта через публичное API KIT и ДОПИСЫВАЕМ характеристики,
// которых на карточке нет или они пустые. Уже заполненные значения НЕ меняем
// (правки из кабинета и color_ru из отдельного скрипта сохраняются).
// ===== Название товара для new.kixbox.ru (правила kixbox.ru) =====
// БРЕНД + [Мужская/Женская ...] + короткий тип + модель из Номенклатура.Описание: «BY PARRA Мужская толстовка Not Fade Away Zip».
//  - бренд - Номенклатура.Марка как в 1С (как на Garage Sale); если модель начинается с бренда («Obey Doberman»), бренд из модели убирается;
//  - пол ставится одежде (Унисекс -> мужской род) и обуви с полом Муж/Жен; аксессуарам и сумкам не ставится;
//  - тип: первое слово типа 1С («Футболка кор. рукав» -> «Футболка»), плюс замены (Джемпер -> Лонгслив и т.п.);
//  - из модели убираются слова-типы (T-shirt, Tee, Hoodie, Pant, Jacket, S/s, L/s ...).
// Если «Описание» пустое - возвращает "" (остаётся название из 1С).
Функция НазваниеТовараДляСайта(Номенклатура) Экспорт

	Описание = СтрЗаменить(Строка(Номенклатура.Описание), Символы.НПП, " ");
	//переносы строк и табуляции в «Описании» - в пробел (иначе название на сайте не совпадает и правится при каждой выгрузке)
	Описание = СтрЗаменить(СтрЗаменить(СтрЗаменить(Описание, Символы.ПС, " "), Символы.ВК, " "), Символы.Таб, " ");
	Описание = СокрЛП(Описание);
	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		Возврат "";
	КонецЕсли;
	ТипНоменклатуры = СокрЛП(Строка(Номенклатура.Тип));
	Пол = СокрЛП(Строка(Номенклатура.Пол));

	ТипСайта = КороткийТипДляСайта(ТипНоменклатуры);
	Модель = МодельДляСайта(Описание, ТипНоменклатуры);

	Части = Новый Массив;
	НТип = НРегЕ(ТипСайта);
	Если ЕстьСлово(" футболка лонгслив майка толстовка свитер кардиган джемпер рубашка рубашка-поло поло куртка пуховик бомбер
		| ветровка анорак парка пальто жилет олимпийка блейзер брюки джинсы шорты топ халф-тайтсы тайтсы леггинсы комбинезон
		| футболка-джерси рубашка-регби рубашка-кимоно куртка-рубашка свитер-поло лонгслив-джерси халат плащ тренч водолазка ", НТип)
		ИЛИ (ЕстьСлово(" кроссовки кеды ботинки лоферы сабо сандалии слипоны мюли туфли клоги тапки сапоги шлепанцы слайды ", НТип)
			И (Пол = "Муж" ИЛИ Пол = "Жен")) Тогда
		Части.Добавить(ПолДляНазвания(ТипСайта, Пол));
	КонецЕсли;
	Если ЗначениеЗаполнено(ТипСайта) Тогда
		Части.Добавить(ТипСайта);
	КонецЕсли;
	//русская часть - с заглавной только первое слово («Мужская толстовка»), модель из «Описания» - каждое слово с заглавной
	Начало = НРег(СтрСоединить(Части, " "));
	Если ЗначениеЗаполнено(Начало) Тогда
		Начало = ВРег(Лев(Начало, 1)) + Сред(Начало, 2) + " ";
	КонецЕсли;
	
	//бренд в начале названия (в карточке и каталоге KIT бренд отдельно не виден)
	Бренд = СокрЛП(Строка(Номенклатура.Марка));
	Если ЗначениеЗаполнено(Бренд) Тогда
		Если СтрДлина(Модель) > СтрДлина(Бренд) + 1 И НРегЕ(Лев(Модель, СтрДлина(Бренд) + 1)) = НРегЕ(Бренд) + " " Тогда
			Модель = СокрЛП(Сред(Модель, СтрДлина(Бренд) + 2));
		КонецЕсли;
		Начало = Бренд + " " + Начало;
	КонецЕсли;
	
	//>>> ПРАВИЛО HIKES JASPER (см. блок «ПРАВИЛО HIKES JASPER» ниже): модель пишется по-русски
	РусскаяМодель = МодельHikesJasperПоРусски(Бренд, Модель);
	Если ЗначениеЗаполнено(РусскаяМодель) Тогда
		Возврат Начало + РусскаяМодель;
	КонецЕсли;
	//<<< ПРАВИЛО HIKES JASPER
	
	Возврат Начало + СловаСЗаглавной(Модель);

КонецФункции

// =====================================================================================================
// ПРАВИЛО HIKES JASPER (new.kixbox.ru), добавлено 12.11.2026
// -----------------------------------------------------------------------------------------------------
// Для кого: бренд HIKES (HIKE), модели «Jasper» и «Jasper V2». Другие модели бренда правило не трогает.
// Что делает:
//   1. Название модели пишется по-русски: «Jasper» -> «Джаспер», «Jasper V2» -> «Джаспер 2»
//      («HIKES Ботинки Jasper V2» -> «HIKES Ботинки Джаспер 2»).
//   2. Цвет карточки (характеристика «Цвет») заменяется русским названием из свойства характеристики
//      «Цвет этикетки»: ALTAI -> АЛТАЙ, OCHRE -> ОХРА. Если свойство у характеристики не заполнено -
//      берется таблица ниже (из файла «Цвета HIKES»); если цвета нет и там - остается английский.
// Чего НЕ меняет: «Имя фото» (остается с английским цветом, как файлы на FTP), «Цвет (русский)» для фильтра.
// Где вызывается (ищите по тексту «ПРАВИЛО HIKES JASPER»):
//   - НазваниеТовараДляСайта - название;
//   - сборка варианта в выгрузке товаров - цвет новой карточки;
//   - ДописатьНедостающиеХарактеристики - цвет и название уже созданной карточки.
// Как отключить: в функции ЭтоHikesJasper и МодельHikesJasperПоРусски первой строкой поставить Возврат Ложь / Возврат "".
// =====================================================================================================
Функция МодельHikesJasperПоРусски(Бренд, Модель)
	
	Если НРег(Лев(СокрЛП(Строка(Бренд)), 4)) <> "hike" Тогда
		Возврат "";
	КонецЕсли;
	М = НРег(СокрЛП(Строка(Модель)));
	Пока СтрНайти(М, "  ") > 0 Цикл
		М = СтрЗаменить(М, "  ", " ");
	КонецЦикла;
	Если М = "jasper" Тогда
		Возврат "Джаспер";
	ИначеЕсли М = "jasper v2" ИЛИ М = "jasper 2" ИЛИ М = "jasper v.2" ИЛИ М = "jasper v 2" Тогда
		Возврат "Джаспер 2";
	КонецЕсли;
	Возврат "";
	
КонецФункции

// Название - то, что вернула НазваниеТовараДляСайта: «HIKES Ботинки Джаспер», «HIKES Ботинки Джаспер 2»
Функция ЭтоHikesJasper(Название)
	
	Если ТипЗнч(Название) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = НРег(СокрЛП(Название));
	Если Лев(Н, 4) <> "hike" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Прав(Н, 8) = " джаспер" ИЛИ Прав(Н, 10) = " джаспер 2";
	
КонецФункции

// Характеристики - массив структур (external_id, value, name) одного варианта; меняется значение «color»
Процедура ЗаменитьЦветHikesJasper(Характеристики, Характеристика)
	
	Для Каждого Хар Из Характеристики Цикл
		ВнешнийИД = Неопределено;
		Если НЕ Хар.Свойство("external_id", ВнешнийИД) ИЛИ ВнешнийИД <> "color" ИЛИ НЕ Хар.Свойство("value") Тогда
			Продолжить;
		КонецЕсли;
		ЦветАнгл = ВРег(СокрЛП(Строка(Хар.value)));
		ЦветРусский = ЦветЭтикеткиИз1С(Характеристика);
		Если НЕ ЗначениеЗаполнено(ЦветРусский) Тогда
			ЦветРусский = ТаблицаЦветовHikes().Получить(ЦветАнгл);
		КонецЕсли;
		Если ЗначениеЗаполнено(ЦветРусский) Тогда
			Хар.value = ЦветРусский;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

// Свойство характеристики номенклатуры «Цвет этикетки» (в списке характеристик товара - колонка «Цвет этикетки»)
Функция ЦветЭтикеткиИз1С(Характеристика)
	
	Если НЕ ЗначениеЗаполнено(Характеристика) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПРЕДСТАВЛЕНИЕ(З.Значение) КАК Цвет
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК З
		|ГДЕ
		|	З.Объект = &Характеристика
		|	И З.Свойство.Наименование ПОДОБНО ""Цвет%этикетк%""";
		Запрос.УстановитьПараметр("Характеристика", Характеристика);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат ВРег(СокрЛП(Строка(Выборка.Цвет)));
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат "";
	
КонецФункции


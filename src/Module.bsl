		Склады.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		СтрокаСклад = Склады.Добавить();
		СтрокаСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000043"); //102 Сток    
		Узел.Склады = Склады;
		Узел.ОсновнойСклад = Справочники.Склады.ПустаяСсылка();
		
	ИначеЕсли Сайт = Перечисления.СписокСайтов.ЯндексКИТ Тогда
		//new.kixbox.ru - основной сайт (не распродажа): склады ИМ и магазинов, скидка склада 218
		Узел.КлючAPI = "<LOCAL_B2B_CREDENTIAL>";	

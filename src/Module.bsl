		Узел.Вставить("НазванияКатегорийИзКабинета", Истина);
		
		//Пустые характеристики, которые обработка только создает на сайте (значения из 1С не отправляются).
		//color_ru - русский цвет для фильтров, заполняется отдельным скриптом (kit_color_ru.py).
		//03.11.2026: color_ru уже создана на сайте, блок отключен - 1С ее не трогает.

#Область янд_ВызовApi				

// Отправляет HTTP-запрос согласно настроек указанного узла.
//
// Параметры:
//  Узел - ПланОбменаСсылка.янд_ОбменСайтом - Узел, к которому отправляется запрос
//  Метод - Строка - HTTP-метод запроса (например, "GET", "POST")
//  ТекстЗапроса - Строка - Текст запроса
//  ДанныеТелоЗапроса - Структура - Данные, отправляемые в теле запроса (по умолчанию Неопределено)
//  ПовторнаяОтправка - Булево - Признак повторной отправки запроса (по умолчанию Ложь)
//  ДатаВыгрузкиTimeStamp - Число - Дата выгрузки в формате Unix Time Stamp 
//  ЭтоПоследнийЗапрос - Булево - Параметр, указывающий на окончание выгрузки для сайта
//	ЭтоВыгрузкаКартинок - Булево - Параметр, определяющий будут ли выгружаться файлы картинок 
//	РазделительВыгрузкиКартинок - Строка - Параметр заголовка для формата multipart/form-data  
//
// Возвращаемое значение:
//  HTTPОтвет - Ответ на отправленный HTTP-запрос
Функция ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, ДанныеТелоЗапроса = Неопределено, ПовторнаяОтправка = Ложь, 
			ДатаВыгрузкиTimeStamp = Неопределено, ЭтоПоследнийЗапрос = Неопределено, ЭтоВыгрузкаКартинок = Ложь, РазделительВыгрузкиКартинок = Неопределено) Экспорт		
	
	АдресСервиса = ПолучитьАдресСервиса();
	HTTPЗапрос = ПодготовитьНовыйHTTPЗапрос(Узел, ТекстЗапроса, ДанныеТелоЗапроса, ПовторнаяОтправка, ДатаВыгрузкиTimeStamp, ЭтоПоследнийЗапрос, ЭтоВыгрузкаКартинок, РазделительВыгрузкиКартинок);	
		
	//Если ТипЗнч(Узел) = Тип("ДанныеФормыСтруктура") Тогда
		Таймаут = Узел.Таймаут;
	//Иначе
	//	Таймаут = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, "Таймаут");
	//КонецЕсли;           
	
	Соединение = Новый HTTPСоединение(АдресСервиса, , , , ,	Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
	
	Для Счетчик = 1 По 5 Цикл
		//обрыв связи - пауза и повтор (отправка по external_id, повтор не создает дублей)
		Попытка
			Ответ = Соединение.ВызватьHTTPМетод(Метод, HTTPЗапрос);
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Если Счетчик = 5 Тогда
				ВызватьИсключение "KIT " + Метод + " " + ТекстЗапроса + ": связь оборвалась 5 раз подряд: " + ТекстОшибки;
			КонецЕсли;
			Сообщить("KIT " + Метод + " " + ТекстЗапроса + ": обрыв связи (" + ТекстОшибки + "), повтор " + Формат(Счетчик + 1, "ЧГ=0") + " из 5");
			Пауза(Счетчик + 2);
			Продолжить;
		КонецПопытки;
		                 
		//Если Ответ.КодСостояния <> 429 Тогда 
		//	ЗаписатьВЛогиЗапросов(Узел, HTTPЗапрос, АдресСервиса, ТекстЗапроса, Метод, Ответ);
		//КонецЕсли;
		
		Если Ответ.КодСостояния = 200 Тогда
			Прервать;
		КонецЕсли;
				
		Если Ответ.КодСостояния = 401 И НЕ ПовторнаяОтправка Тогда
			Ответ = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, ДанныеТелоЗапроса, Истина, ДатаВыгрузкиTimeStamp, ЭтоПоследнийЗапрос, ЭтоВыгрузкаКартинок, РазделительВыгрузкиКартинок);
		КонецЕсли;
		
		Если Ответ.КодСостояния >= 500 И Ответ.КодСостояния < 600 Тогда		
			Пауза(Счетчик);
		ИначеЕсли Ответ.КодСостояния = 429 Тогда
			Пауза(Счетчик);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ответ;
	
КонецФункции

//Отправляет HTTP-запрос по указанному URL для скачивания файла
//
//Параметры:
//	URL - Строка - Адрес для скачивания файла
//
//Возвращаемое Значение:
//	HTTPОтвет - Ответ на отправленный HTTP-запрос
Функция ПолучитьФайлПоURL(Знач URL) Экспорт

	//СтруктураURL = ПолучениеФайловИзИнтернетаКлиентСервер.РазделитьURL(URL);
	СтруктураURL = РазделитьURL(URL); //Туктаров Р.Р. 07.04.2026
	
	Соединение = Новый HTTPСоединение(СтруктураURL.ИмяСервера,,,,,30);	
	Запрос = Новый HTTPЗапрос("/"+СтруктураURL.ПутьКФайлуНаСервере);
	
	Ответ = Соединение.Получить(Запрос);

	Возврат Ответ;
	
КонецФункции


Функция ПодготовитьНовыйHTTPЗапрос(Узел, ТекстЗапроса, ДанныеТелоЗапроса, ПовторнаяОтправка = Ложь, ДатаВыгрузкиTimeStamp, ЭтоПоследнийЗапрос, ЭтоВыгрузкаКартинок, РазделительВыгрузкиКартинок)
	
	Заголовки 		= ПодготовитьЗаголовкиДляHTTPЗапроса(Узел, ПовторнаяОтправка, ДатаВыгрузкиTimeStamp, ЭтоПоследнийЗапрос, ЭтоВыгрузкаКартинок, РазделительВыгрузкиКартинок); 
	
	Запрос = Новый  HTTPЗапрос(ТекстЗапроса, Заголовки);
	
	Если ДанныеТелоЗапроса <> Неопределено Тогда
		Если ЭтоВыгрузкаКартинок Тогда
			Запрос.УстановитьТелоИзДвоичныхДанных(ДанныеТелоЗапроса);	
		Иначе
			ТелоЗапроса 	= ЗаписатьДанныеВJSON(ДанныеТелоЗапроса);
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Запрос; 
	
КонецФункции

Функция ПодготовитьЗаголовкиДляHTTPЗапроса(Узел, ПовторнаяОтправка = Ложь, ДатаВыгрузкиTimeStamp, ЭтоПоследнийЗапрос, ЭтоВыгрузкаКартинок, РазделительВыгрузкиКартинок)
		
	СтруктураКлючаAPI = ПолучитьСтруктуруКлючаAPI(Узел.КлючAPI);
		
	Заголовки = Новый Соответствие;
	Если ЭтоВыгрузкаКартинок Тогда
		Заголовки.Вставить("Content-Type",	"multipart/form-data; boundary=" + РазделительВыгрузкиКартинок);	
	Иначе	
		Заголовки.Вставить("Content-Type",	"application/json");
	КонецЕсли;
	Заголовки.Вставить("Authorization",	"Bearer " + СтруктураКлючаAPI.APIКлюч);
	Заголовки.Вставить("Yandex-Kit-Store-Id", СтруктураКлючаAPI.IDМагазина);
	//Туктаров Р.Р. 07.04.2026+
	//Заголовки.Вставить("module-version", янд_ОбновлениеДанныхРасширенияВызовСервера.ТекущаяВерсияРасширения());
	//Заголовки.Вставить("1C-version", Метаданные.Версия);
	Заголовки.Вставить("module-version", "1.0.9.4");
	Заголовки.Вставить("1C-version", "11.5.21.104");
	//Туктаров Р.Р. 07.04.2026-
	
	
	Если ДатаВыгрузкиTimeStamp <> Неопределено Тогда
		Заголовки.Вставить("1C-Operation", ДатаВыгрузкиTimeStamp)
	КонецЕсли;
	
	//Туктаров Р.Р. 07.04.2026+	
	//Если Метаданные.Имя = "УправлениеТорговлей" Тогда
		Заголовки.Вставить("1C-configuration", "UT");                                
	//ИначеЕсли Метаданные.Имя = "КомплекснаяАвтоматизация" Тогда
	//	Заголовки.Вставить("1C-configuration", "KA");
	//ИначеЕсли Метаданные.Имя = "УправлениеПредприятием" Тогда	
	//	Заголовки.Вставить("1C-configuration", "ERP");	
	//КонецЕсли;	
	//Туктаров Р.Р. 07.04.2026-
	
	Если ЭтоПоследнийЗапрос <> Неопределено Тогда
		Заголовки.Вставить("1C-Is-Last-Request", ЗаписатьДанныеВJSON(ЭтоПоследнийЗапрос));		
	КонецЕсли;
	
	Возврат Заголовки;
	
КонецФункции

Функция ПолучитьАдресСервиса(ИспользоватьОтладочныйАдресСервиса=Ложь)

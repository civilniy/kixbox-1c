Процедура ЗаполнитьЗаказССайта(ОбъектЗаказ,ДанныеЗаполнения,Узел);
	Если отладка Тогда
		ОбъектЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	КонецЕсли;
	
	ОбъектЗаказ.Номер 	= Узел.ПрефиксЗаказа + ДанныеЗаполнения.order_number;
	ОбъектЗаказ.Дата = ПрочитатьДатуJSON(ДанныеЗаполнения.created_at, ФорматДатыJSON.ISO);   
	ОбъектЗаказ.Организация = Узел.Организация;	
	ОбъектЗаказ.МетодОплатыСайта = Перечисления.МетодОплатыСайта.Безнал;																
	ОбъектЗаказ.ВалютаДокумента = Константы.ВалютаУправленческогоУчета.Получить();
	ОбъектЗаказ.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
    ОбъектЗаказ.КратностьВзаиморасчетов = 1;
	ОбъектЗаказ.КурсВзаиморасчетов = 1;
    ОбъектЗаказ.ЭтоЗаказИМ = Истина;   
	ОбъектЗаказ.СайтЗаказа = Узел.Сайт; 
	ОбъектЗаказ.СтатусЗаказаСайта = Справочники.СтатусыЗаказовСайта.НайтиПоКоду("016");
	
	Если ДанныеЗаполнения.acquiring_id<>"" Тогда
		//Прописать документ оплаты.
		ОбъектЗаказ.ЗаказОплачен = Истина;   
		ОбъектЗаказ.Комментарий = ДанныеЗаполнения.acquiring_id; 
	КонецЕсли;
	
	Если ЕстьРеквизитСтруктуры(ДанныеЗаполнения.client, "email") Тогда
		ОбъектЗаказ.Почта = ДанныеЗаполнения.client.email;
	КонецЕсли;	
	Если ЕстьРеквизитСтруктуры(ДанныеЗаполнения.client, "phone") Тогда
		ОбъектЗаказ.Телефон = ДанныеЗаполнения.client.phone;                        
	КонецЕсли;
	Если ЕстьРеквизитСтруктуры(ДанныеЗаполнения.client, "last_name") Тогда
		Фамилия = ДанныеЗаполнения.client.last_name;                          
	КонецЕсли;
	Если ЕстьРеквизитСтруктуры(ДанныеЗаполнения.client, "first_name") Тогда
		Имя = ДанныеЗаполнения.client.first_name;
	КонецЕсли;
	ИмяКлиента = Фамилия + " " + Имя; 
	ИДПокупателя = "";
	Контрагент = ПолучитьКонтрагентаСайта2(ИдПокупателя,ОбъектЗаказ.Почта,ОбъектЗаказ.Телефон,ИмяКлиента); 
	ОбъектЗаказ.Контрагент = Контрагент;   
	ОбъектЗаказ.ДоговорКонтрагента = ПроцедурыОбменаССайтом.ПолучитьДоговорКонтрагентаСайта(ОбъектЗаказ.Контрагент,ОбъектЗаказ.Организация);  
	
	//Заполним товар
	Для Каждого Заказ Из ДанныеЗаполнения.delivery_chunks Цикл
		//Заполним адрес доставки
		Если Заказ.delivery_info.method = "COURIER" Тогда  
			Если Заказ.delivery_info.courier_delivery_service_type = "CDEK"	Тогда
				ОбъектЗаказ.СпособДоставкиСайта = Перечисления.СпособДоставкиСайта.КурьеромПоМоскве;
			ИначеЕсли Заказ.delivery_info.courier_delivery_service_type = "MERCHANT_SHIP" Тогда 
				ОбъектЗаказ.СпособДоставкиСайта = Перечисления.СпособДоставкиСайта.Dalli;
			ИначеЕсли Заказ.delivery_info.courier_delivery_service_type = "YANDEX_DELIVERY" Тогда
				ОбъектЗаказ.СпособДоставкиСайта = Перечисления.СпособДоставкиСайта.ЯндексДоставка; 
			КонецЕсли;
				
			//courier_delivery_service_type	"MERCHANT_SHIP"	Строка - Собственная служба доставки
			ОбъектЗаказ.АдресДоставки = "г." + Заказ.delivery_info.address.courier_locality + ", " 
			+  Заказ.delivery_info.address.courier_address 
			+ ", кв/оф." + Заказ.delivery_info.address.entrance
			+ ?(Заказ.delivery_info.address.intercom="","",", домофон: "+Заказ.delivery_info.address.intercom);  
		ИначеЕсли Заказ.delivery_info.method = "PICKUP_POINT" Тогда  
			Если Заказ.delivery_info.pickup_point_delivery_service_type = "CDEK"	Тогда   
				ОбъектЗаказ.СпособДоставкиСайта = Перечисления.СпособДоставкиСайта.CDEKPickPoint;
			КонецЕсли;
				ОбъектЗаказ.АдресДоставки = Заказ.delivery_info.address.pickup_point_locality + ", " 
			+  Заказ.delivery_info.address.pickup_point_address;   
		КонецЕсли;
		
		//Добавим к заказу стоимость доставки.
		Если Заказ.delivery_info.Свойство("customer_costs")>0 Тогда
			СтрокаУслуга = ОбъектЗаказ.Услуги.Добавить();
			СтрокаУслуга.Цена = Заказ.delivery_info.customer_costs;
			СтрокаУслуга.Количество = 1;
			СтрокаУслуга.Номенклатура = Справочники.Номенклатура.НайтиПоКоду("УС000051718"); 
			СтрокаУслуга.Содержание = Заказ.delivery_info.customer_costs;
			СтрокаУслуга.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
			СтрокаУслуга.Сумма = СтрокаУслуга.Цена; 
			СтрокаУслуга.СуммаНДС = 0;
			СтрокаУслуга.УсловиеАвтоматическойСкидки = Перечисления.УсловияСкидкиНаценки.БезУсловий;
		КонецЕсли;
		
		Для Каждого Строка Из Заказ.items Цикл		
			Если Строка.Свойство("external_id") Тогда    
								
				КодНоменклатуры = Лев(Строка.external_id,СтрНайти(Строка.external_id,"#",НаправлениеПоиска.СНачала,1,1)-1);
				КодХарактеристики = Прав(Строка.external_id,СтрДлина(Строка.external_id)-СтрНайти(Строка.external_id,"#",НаправлениеПоиска.СНачала,1,1));
				Номенклатура= Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(КодНоменклатуры));
				Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(КодХарактеристики));
				
				СтрокаТовар = ОбъектЗаказ.Товары.Добавить();
				СтрокаТовар.Номенклатура = Номенклатура;
				СтрокаТовар.ХарактеристикаНоменклатуры = Характеристика;
				СтрокаТовар.Количество = Строка.quantity;
				СтрокаТовар.Цена = Строка.price;
				СтрокаТовар.Сумма = Строка.final_price;//СтрокаТовар.Количество * СтрокаТовар.Цена;
				ПроцентСкидки = (1-(СтрокаТовар.Сумма/(СтрокаТовар.Цена*СтрокаТовар.Количество)))*100;
				//СтрокаТовар.ПроцентСкидкиНаценки = ПроцентСкидки; //Ручная скидка
				СтрокаТовар.ПроцентАвтоматическихСкидок = ПроцентСкидки; //Автоматическая скидка
				СтрокаТовар.СтавкаНДС = Перечисления.СтавкиНДС.НДС22;
				СтрокаТовар.ЕдиницаИзмерения = СтрокаТовар.Номенклатура.ЕдиницаХраненияОстатков;
				СтрокаТовар.ЕдиницаИзмеренияМест = СтрокаТовар.Номенклатура.ЕдиницаХраненияОстатков;
				СтрокаТовар.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000043");//102;
			КонецЕсли;		
		КонецЦикла;
	КонецЦикла;

	
	Если не Отладка Тогда
		ОбъектЗаказ.Записать(РежимЗаписиДокумента.Запись);
		Попытка 
			ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение);	
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	//Если ОбъектЗаказ.ЗаказОплачен Тогда
	//	ЭЛРОС_СоздатьДокументОплатаОтПокупателяПлатежнойКартой(	ОбъектЗаказ.Ссылка, ДанныеЗаполнения.acquiring_type, КомментарийДляОплаты, ОтветсвенныйПоДокументуОплаты, Узел.Сайт);
	//КонецЕсли;	
	//	   
	
	СформироватьЗаявкуНаКомплектацию(ОбъектЗаказ, Узел);
	//Создать заявку на комплектацию.
	//Склад получатель 206
	
		
	
КонецПроцедуры

Процедура СформироватьЗаявкуНаКомплектацию(ОбъектЗаказ, Узел)
	ТаблицаСкладов = Новый ТаблицаЗначений;
	ТаблицаСкладов.Колонки.Добавить("Склад");
	Для Каждого Стр Из ОбъектЗаказ.Товары Цикл
		Если ЗначениеЗаполнено(Стр.Склад) Тогда
			НовСтр = ТаблицаСкладов.Добавить();
			НовСтр.Склад = Стр.Склад;
		КонецЕсли;	
	КонецЦикла;
	ТаблицаСкладов.Свернуть("Склад");
	
	Для Каждого СтрСклад Из ТаблицаСкладов Цикл
		Заявка = Документы.ЗаявкаНаКомплектацию.СоздатьДокумент();
		Заявка.СкладОтправитель = СтрСклад.Склад;
		Если ЗначениеЗаполнено(ОбъектЗаказ.ПунктСамовывоза) Тогда
			Заявка.СкладПолучатель = Киксбокс.ПолучитьСкладПоПунктуСамовывоза(ОбъектЗаказ.ПунктСамовывоза,Узел.Сайт);
			Если Не ЗначениеЗаполнено(Заявка.СкладПолучатель) Тогда
				Заявка.СкладПолучатель = ОбъектЗаказ.ПунктСамовывоза;
			КонецЕсли;
		Иначе Заявка.СкладПолучатель = Киксбокс.ПолучитьСкладПоСайту(Узел.Сайт);									
		КонецЕсли;
		Заявка.Организация = ОбъектЗаказ.Организация;
		Заявка.Дата = ТекущаяДата();
		Заявка.Тип = Перечисления.ТипыЗаявокНаСклад.Комплектация;
		Заявка.Контрагент = Справочники.Контрагенты.НайтиПоКоду("ГЛ0001237").Ссылка;
		Заявка.ДокОснования = ОбъектЗаказ.Ссылка;
		Заявка.Вторичная = Истина;
		Заявка.Комментарий = "Распродажа";  
		Если Узел.Сайт <> Перечисления.СписокСайтов.Битрикс Тогда
			Текст = Новый ТекстовыйДокумент;
			Для Каждого Стр2 Из ОбъектЗаказ.Товары Цикл
				Если Стр2.Склад = СтрСклад.Склад Тогда									
					Для сч = 1 По Стр2.Количество Цикл										
						Эл = Заявка.Товары.Добавить();
						Эл.Номенклатура = Стр2.Номенклатура;
						Эл.ХарактеристикаНоменклатуры = Стр2.ХарактеристикаНоменклатуры;
						Эл.Количество = 1;
						Эл.ЗаказИнтернетМагазина = ОбъектЗаказ.Ссылка;
						Эл.КлючСтроки = Стр2.КлючСтроки;
						
						Если СтрСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000024") //202
							ИЛИ СтрСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000002") //204									
							ИЛИ СтрСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000097") //220
							ИЛИ СтрСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000087") //217
							ИЛИ СтрСклад.Склад = Справочники.Склады.НайтиПоКоду("ГЛ0000096") Тогда //218
							
							Текст.ДобавитьСтроку("^Q70,3");							
							Текст.ДобавитьСтроку("^W52");
							Текст.ДобавитьСтроку("^H5");
							Текст.ДобавитьСтроку("^P1");
							Текст.ДобавитьСтроку("^S4");
							Текст.ДобавитьСтроку("^AT");
							Текст.ДобавитьСтроку("^C1");
							Текст.ДобавитьСтроку("^R0");
							Текст.ДобавитьСтроку("~Q+0");
							Текст.ДобавитьСтроку("^O0");
							Текст.ДобавитьСтроку("^D0");
							Текст.ДобавитьСтроку("^E18");
							Текст.ДобавитьСтроку("~R255");
							Текст.ДобавитьСтроку("^L");
							
							Текст.ДобавитьСтроку("BB,396,404,5,12,74,2,0,"+Формат(ОбъектЗаказ.Штрихкод,"ЧГ=0"));											
							Текст.ДобавитьСтроку("AF,22,421,1,1,0,0E,"+СокрЛП(ОбъектЗаказ.Номер)+" / "+Строка(ОбъектЗаказ.Товары.Итог("Количество"))+" шт.");
							Текст.ДобавитьСтроку("AF,22,489,1,1,0,0E,"+"Из "+ Лев(СтрСклад.Склад.Наименование,3) +" В "+ Лев(Заявка.СкладПолучатель.Наименование,3));
							Текст.ДобавитьСтроку("AF,22,15,1,1,0,0E,"+Стр2.Номенклатура.Артикул);
							Текст.ДобавитьСтроку("AB,22,90,1,1,0,0E,"+Стр2.ХарактеристикаНоменклатуры.Цвет.Наименование); 
							Текст.ДобавитьСтроку("AF,22,150,1,1,0,0E,"+Стр2.ХарактеристикаНоменклатуры.Размер.Наименование);
							
							Текст.ДобавитьСтроку("AB,22,214,1,1,0,0E,"+Стр2.Номенклатура.Пол.Наименование);
							Текст.ДобавитьСтроку("AB,22,235,1,1,0,0E,"+Стр2.Номенклатура.Марка.Наименование);
							Тип1 = Стр2.Номенклатура.Тип.Родитель.Наименование;
							
							Тип1_1 = Лев(Тип1,30);
							Тип1_2 = Сред(Тип1,31,30);
							
							Текст.ДобавитьСтроку("AB,22,261,1,1,0,0E,"+Тип1_1);
							Если Не ПустаяСтрока(Тип1_2) Тогда
								Текст.ДобавитьСтроку("AB,22,288,1,1,0,0E,"+Тип1_2);
							КонецЕсли;
							Текст.ДобавитьСтроку("E");
							
						Иначе						
							
							Текст.ДобавитьСтроку("^Q40,3");
							Текст.ДобавитьСтроку("^W60");
							Текст.ДобавитьСтроку("^H6");
							Текст.ДобавитьСтроку("^P1");
							Текст.ДобавитьСтроку("^S7");
							Текст.ДобавитьСтроку("^AD");
							Текст.ДобавитьСтроку("^C1");
							Текст.ДобавитьСтроку("^R10");
							Текст.ДобавитьСтроку("~Q+10");
							Текст.ДобавитьСтроку("^O0");
							Текст.ДобавитьСтроку("^D0");
							Текст.ДобавитьСтроку("^E15");
							Текст.ДобавитьСтроку("~R200");
							Текст.ДобавитьСтроку("^XSET,ROTATION,0");
							Текст.ДобавитьСтроку("^L");
							
							Текст.ДобавитьСтроку("BB,86,276,3,8,74,3,0,"+Формат(ОбъектЗаказ.Штрихкод,"ЧГ=0"));

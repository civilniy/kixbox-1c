Функция ЦветРусИз1С(Характеристика)
	
	Попытка
		Цвет = Характеристика.Цвет;
		Если НЕ ЗначениеЗаполнено(Цвет) Тогда
			Возврат "";
		КонецЕсли;
		Значение = СокрЛП(Строка(Цвет.ДопХар));
	Исключение
		Возврат "";
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Значение = СтрЗаменить(СтрЗаменить(Значение, "ё", "е"), "Ё", "Е");
	//каждая часть («Черный / Белый») - с заглавной, остальное строчными: «ЧЕРНЫЙ» и «Черный» - одно значение фильтра
	Части = Новый Массив;
	Для Каждого ЧастьЦвета Из СтрРазделить(Значение, "/", Ложь) Цикл
		Часть = НРег(СокрЛП(ЧастьЦвета));
		Если ЗначениеЗаполнено(Часть) Тогда
			Части.Добавить(ВРег(Лев(Часть, 1)) + Сред(Часть, 2));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " / ");
	
КонецФункции


		Узел.ПрефиксЗаказа = "НКБ";
		Узел.Сайт = Перечисления.СписокСайтов.Яндекс;
		//new.kixbox.ru - основной сайт: скидка, как на kixbox.ru, берется со склада 218, а не со склада остатка
		//Склад скидок: ГЛ0000096 = 218 Магазин Kixbox Атриум
		Узел.Вставить("СкладСкидок", НайтиСкладПоКоду("ГЛ0000096", "218 Атриум (склад скидок)")); //218 Магазин Kixbox Атриум
		
		//Характеристики сайта: цвет, размер и пол пишутся в характеристики со слагами и внешними ID color, size, gender
		//(вместо cvet-1 / razmer-1 / pol-1 с внешними ID Характеристика_Цвет / Характеристика_Размер / Номенклатура_Пол)
		ХарактеристикиСайта = Новый Соответствие;

Процедура Пауза(НомерПопытки)
	
	Если НомерПопытки = 1 Тогда
		ВремяОжидания = 1;
	ИначеЕсли НомерПопытки = 2 Тогда
		ВремяОжидания = 5;
	ИначеЕсли НомерПопытки = 3 Тогда
		ВремяОжидания = 10;
	ИначеЕсли НомерПопытки = 4 Тогда
		ВремяОжидания = 30;
	Иначе
		ВремяОжидания = 60;
	КонецЕсли;
	
	ДатаОжидания = ТекущаяДатаСеанса() + ВремяОжидания;
	
	Пока ТекущаяДатаСеанса() < ДатаОжидания Цикл
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтруктуруКлючаAPI(КлючAPI) Экспорт
	
	ДлинаСтрокиТокенаЛК = СтрДлина(КлючAPI);
	ДлинаIDМагзина = 36;
	ДлинаТокена = ДлинаСтрокиТокенаЛК - 37;
	
	IDМагазина = Прав(КлючAPI, ДлинаIDМагзина);
	APIКлюч = Лев(КлючAPI, ДлинаТокена); 
	
	СтруктураКлючаAPI = Новый Структура("IDМагазина, APIКлюч", IDМагазина, APIКлюч);
	
	Возврат СтруктураКлючаAPI;
	
КонецФункции

#КонецОбласти

#Область янд_РаботаСТоварамиСервер

// Выполняет выгрузку товаров на сайт в соответствии с настройками указанного узла обмена.
//
// Параметры:
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена, для которого выполняется выгрузка товаров
Процедура ВыгрузитьТоварыНаСайт(Узел, ЭтоВыгрузкаЦенОстатков = Ложь) Экспорт
		
	СообщитьЭтап("Сбор товаров и остатков из 1С...");
	СтруктураВыгрузки = ПолучитьНоменклатуруДляВыгрузки(Узел);
	СообщитьЭтап("Моделей к выгрузке: " + Формат(СтруктураВыгрузки.ТаблицаДанных.Строки.Количество(), "ЧН=0; ЧГ=0"));
	
	Если СтруктураВыгрузки.ТаблицаДанных.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//Если Узел.ВыгружатьКартинкиТоваров Тогда
	//	СоответствиеКартинок1ССайта(СтруктураВыгрузки.ТаблицаДанных, СтруктураВыгрузки.СоответствиеКартинок, Узел);
	//КонецЕсли;
	
	Категории = ПостроитьКатегорииПоТипу(СтруктураВыгрузки.ТаблицаДанных);
    Если НЕ ЭтоВыгрузкаЦенОстатков И Узел.Свойство("СкладСкидок") Тогда
        Узел.Вставить("ТипыДляКаталога", Категории.ТипыТоваров);
    КонецЕсли;
	СообщитьЭтап("Категорий: " + Формат(Категории.Количество, "ЧН=0; ЧГ=0") + ", проверка и создание на сайте...");
	КатегорииСозданы = ВыгрузитьКатегорииНаСайт(Категории.Дерево, Узел);
	СообщитьЭтап("Категории готовы. Отправка карточек...");
	Попытка
		Узел.Вставить("ПутиКатегорий", Категории.ПутиКатегорий);
	Исключение
	КонецПопытки;
	Если Не КатегорииСозданы Тогда
		Сообщить("Выгрузка остановлена: на сайте не создалась категория, товары не отправлялись.");
		Возврат;
	КонецЕсли;	
	
	ВыгрузитьВариантыНаСайт(СтруктураВыгрузки.ТаблицаДанных, СтруктураВыгрузки.МассивХарактеристик, 
							СтруктураВыгрузки.СоответствиеКартинок, Узел, СтруктураВыгрузки.ДатаВыгрузки, ЭтоВыгрузкаЦенОстатков,
							Категории.КатегорииТоваров);
	
	Если Узел.Свойство("ПоказатьОтправку") Тогда
		НеСовпало = ПроверитьКатегорииКарточек(СтруктураВыгрузки.ТаблицаДанных, Категории.КатегорииТоваров, Узел);
		Если НеСовпало > 0 Тогда
			//KIT не ставит категорию при создании карточки, ставит при повторной отправке
			СообщитьЭтап("Повторная отправка карточек для привязки категорий (" + Формат(НеСовпало, "ЧГ=0") + ")...");
			ВыгрузитьВариантыНаСайт(СтруктураВыгрузки.ТаблицаДанных, СтруктураВыгрузки.МассивХарактеристик, 
							СтруктураВыгрузки.СоответствиеКартинок, Узел, СтруктураВыгрузки.ДатаВыгрузки, ЭтоВыгрузкаЦенОстатков,
							Категории.КатегорииТоваров);
			ПроверитьКатегорииКарточек(СтруктураВыгрузки.ТаблицаДанных, Категории.КатегорииТоваров, Узел);
		КонецЕсли;
	КонецЕсли;
	
	//new.kixbox.ru: цены (до скидки и со скидкой склада 218) отправляются сразу после карточек
	Если Узел.Свойство("СкладСкидок") И НЕ ЭтоВыгрузкаЦенОстатков Тогда
		СообщитьЭтап("Отправка цен для выгруженных товаров...");
		ТаблицаЦен = ПолучитьТаблицуЦен(Узел);
		Если ТаблицаЦен.Строки.Количество() > 0 Тогда
			ОтправитьЦеныНаСайт(ТаблицаЦен, Узел, "price_update_" + ПолучитьТекущуюДатуTimeStamp());
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет выгрузку цен для указанного узла обмена.
//
// Параметры:
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена, для которого выполняется выгрузка цен
Процедура ВыгрузитьЦеныНаСайт(Узел) Экспорт
	
	ДатаВыгрузки = ПолучитьТекущуюДатуTimeStamp();
	ДатаВыгрузки = "price_update_"+ДатаВыгрузки;
	
	СообщитьЭтап("Обновление цен: сбор цен из 1С...");
	ТаблицаЦен = ПолучитьТаблицуЦен(Узел);
	
	Если ТаблицаЦен.Строки.Количество() = 0 Тогда
		СообщитьЭтап("Цен для выгрузки нет.");
		Возврат;
	КонецЕсли;	
	
	//new.kixbox.ru: кнопка «Обновить цены» отправляет ТОЛЬКО цены (карточки, категории и характеристики не трогает).
	//sale.kixbox.ru: как раньше - сначала карточки (is_mapping=true), потом цены.
	Если НЕ Узел.Свойство("СкладСкидок") Тогда
		ВыгрузитьТоварыНаСайт(Узел, Истина); 
	КонецЕсли;
	
	//new.kixbox.ru: цены только вариантам, которые есть на сайте и не в архиве (по штрихкоду)
	Если Узел.Свойство("СкладСкидок") Тогда
		СообщитьЭтап("Чтение активных вариантов с сайта...");
		ШтрихкодыСайта = ШтрихкодыАктивныхВариантовСайта();
		Если ШтрихкодыСайта = Неопределено Тогда
			Сообщить("Не удалось прочитать варианты сайта - цены не отправлялись.");
			Возврат;
		КонецЕсли;
		Узел.Вставить("ШтрихкодыСайта", ШтрихкодыСайта);
		СообщитьЭтап("Активных вариантов на сайте: " + Формат(ШтрихкодыСайта.Количество(), "ЧН=0; ЧГ=0"));
	КонецЕсли;
	
	СообщитьЭтап("Моделей с ценами в 1С: " + Формат(ТаблицаЦен.Строки.Количество(), "ЧН=0; ЧГ=0") + ". Отправка только цен...");
	ОтправитьЦеныНаСайт(ТаблицаЦен, Узел, ДатаВыгрузки);
	Если Узел.Свойство("ШтрихкодыСайта") Тогда
		Узел.Удалить("ШтрихкодыСайта");
	КонецЕсли;
	
КонецПроцедуры

// Выполняет выгрузку остатков для указанного узла обмена.
//
// Параметры:
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена, для которого выполняется выгрузка остатков
//	 ПолнаяВыгрузка - Булево - указывает на вариант выгрузки: выгружать все остатки или только измененные
Процедура ВыгрузитьОстаткиНаСайт(Узел, ПолнаяВыгрузка = Ложь) Экспорт
	
	ДатаВыгрузки = ПолучитьТекущуюДатуTimeStamp();
	Если ПолнаяВыгрузка Тогда
		ДатаВыгрузки = "stock_full_update_"+ДатаВыгрузки;
	Иначе
		ДатаВыгрузки = "stock_modification_update_"+ДатаВыгрузки;
	КонецЕсли;
	
	СообщитьЭтап("Обновление остатков: сбор остатков из 1С...");
	Если ПолнаяВыгрузка Тогда
		ТаблицаОстатков = ПолучитьТаблицуОстатков(Узел);
	Иначе
		ТаблицаОстатков = ПолучитьТаблицуОстатков_Измененные(Узел);
	КонецЕсли;
	
	Если ТаблицаОстатков.Строки.Количество() = 0 Тогда
		СообщитьЭтап("Остатков для выгрузки нет.");
		Возврат;
	КонецЕсли;	
	
	СообщитьЭтап("Моделей с остатками: " + Формат(ТаблицаОстатков.Строки.Количество(), "ЧН=0; ЧГ=0") + ". Отправка только остатков...");
	
	ЗагрузитьРезервыКомплектации(Узел);
	ОтправитьОстаткиНаСайт(ТаблицаОстатков, Узел, ПолнаяВыгрузка, ДатаВыгрузки);
	
	//new.kixbox.ru: проданным вариантам (их нет в таблице остатков 1С) - остаток 0
	Если ПолнаяВыгрузка Тогда
		ОбнулитьПроданныеНаСайте(ТаблицаОстатков, Узел);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНоменклатуруДляВыгрузки(Узел)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//УзелОбъект = Узел.ПолучитьОбъект();
	УзелОбъект = Узел; //Туктаров Р.Р. 09.04.2026
	
	НастройкиКомпоновки = УзелОбъект.ОтборНоменклатуры.Получить();
	ТаблицаПолей = УзелОбъект.МаппингПолей.Получить();
	
	КомпоновщикМаппинг 				= Новый КомпоновщикНастроекКомпоновкиДанных;
	//НомерОтправленного = ПланыОбмена.янд_ОбменСайтом.НомерОтправленного(Узел);
	ДатаВыгрузки = ПолучитьТекущуюДатуTimeStamp();	
	//Если УзелОбъект.РежимВыгрузкиТоваров = 0 И НомерОтправленного <> 0 Тогда 
	//	СхемаОтбор 					= ПланыОбмена.янд_ОбменСайтом.ПолучитьМакет("ПоляВыгрузкиТоваров_Изменения");
	//	ДатаВыгрузки				= "modification_upload_"+ДатаВыгрузки;
	//Иначе
		//СхемаОтбор 					= ПланыОбмена.янд_ОбменСайтом.ПолучитьМакет("ПоляВыгрузкиТоваров_ПолнаяВыгрузка");
		СхемаОтбор 					= ПолучитьМакет("ПоляВыгрузкиТоваров_ПолнаяВыгрузка"); //Туктаров Р.Р. 07.04.2026 Макет изменен.
		Если Узел.Свойство("ПоказатьОтправку") Тогда
			ДатаВыгрузки			= "modification_upload_"+ДатаВыгрузки;
		Иначе
			ДатаВыгрузки			= "full_upload_"+ДатаВыгрузки;
		КонецЕсли;
	//КонецЕсли;
	АдресМаппинг					= ПоместитьВоВременноеХранилище(СхемаОтбор);
	ИсточникМаппинг					= Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресМаппинг);
	КомпоновщикМаппинг.Инициализировать(ИсточникМаппинг);	
	
	НастройкиСхемы = СхемаОтбор.НастройкиПоУмолчанию;	
	НастройкиСКД = КомпоновщикМаппинг.ПолучитьНастройки();
	
	Если УзелОбъект.РежимОтбораТоваров = 0 Тогда
		СкопироватьЭлементы(НастройкиСхемы.Отбор, НастройкиКомпоновки.Отбор, Ложь);
	КонецЕсли;
	
	//РежимВыгрузкиТоваров = 0 - это изменения. Если 1 - полная выгрузка
	//Если УзелОбъект.РежимВыгрузкиТоваров 	= 0 И НомерОтправленного <> 0 Тогда
	//	УдалитьОтборыЦенИОстатков(НастройкиСхемы.Отбор.Элементы);
	//КонецЕсли;		
			
	МассивХарактеристик = Новый Массив;
	
	Для Каждого Строка Из ТаблицаПолей Цикл
		Если Строка.ИмяРеквизита = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Строка.Поле) ИЛИ НЕ Строка.Активно Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Строка.ИмяРеквизита) = Тип("Строка") Тогда
			ДоступноеПоле = НастройкиСКД.ДоступныеПоляВыбора.НайтиПоле(Новый ПолеКомпоновкиДанных(Строка.ИмяРеквизита));
		ИначеЕсли ТипЗнч(Строка.ИмяРеквизита) = Тип("ИдентификаторКомпоновкиДанных") Тогда
			ДоступноеПоле = НастройкиСКД.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(Строка.ИмяРеквизита);	
		КонецЕсли;
		
		Если ДоступноеПоле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НовПоле 				= НастройкиСхемы.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовПоле.Поле 			= ДоступноеПоле.Поле;
		НовПоле.Использование 	= Истина;
		Если ТипЗнч(Строка.Поле) = Тип("Строка") Тогда
			НовПоле.Заголовок 	= Строка.Поле;
		Иначе
			НовПоле.Заголовок	= Строка.Поле.СлужебноеНаименование;
		КонецЕсли;                                                                 
		
		//Если ТипЗнч(Строка.Поле) <> Тип("СправочникСсылка.янд_ПоляТоваров") И Строка.Активно Тогда
		Если Строка.Активно Тогда
			СтруктураХарактеристики = Новый Структура();
			СтруктураХарактеристики.Вставить("ПолеИмя", 		НовПоле.Заголовок); 
			СтруктураХарактеристики.Вставить("РодительТип", 	ДоступноеПоле.Родитель.Заголовок);
			СтруктураХарактеристики.Вставить("ПолеТип", 		ДоступноеПоле.ТипЗначения);
			СтруктураХарактеристики.Вставить("Идентификатор",   ПреобразоватьИмяКолонки(НовПоле.Заголовок));
			

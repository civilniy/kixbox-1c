	|		ПО ВТ_ТЗID.IDЗаказа = ЗаказПокупателя.Номер";
	Запрос.УстановитьПараметр("ТЗID", ТЗID);
	Выборка = Запрос.Выполнить().Выбрать();  
	
	ЗаказыССайта = Новый Массив;  
	
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			//Сообщить("Откроем заказ №"+Выборка.IDЗаказа);
			//ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Иначе 
			Сообщить("Создадим заказ №"+Выборка.IDЗаказа); 
			ДанныеТекЗаказа = ДанныеЗаказа.Получить(Выборка.IDЗаказа);
			Если ДанныеТекЗаказа.ДанныеЗаполнения.Status 		= "WAIT_FOR_CONFIRMATION" Тогда

		ХарактеристикиСайта.Вставить("Характеристика_Размер", "size");
		ХарактеристикиСайта.Вставить("Номенклатура_Пол", "gender");
		ХарактеристикиСайта.Вставить("Номенклатура_Сезон", "season");
		ХарактеристикиСайта.Вставить("Номенклатура_Состав", "composition");

Процедура УдалитьПустыеПоля(СтруктураВарианта)

	ОбязательынеПоля = "name, barcode, external_id";
	УдаляемыеКлючи = Новый Массив;
	Для Каждого КлючИЗначение Из СтруктураВарианта Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого СтрокаМассива Из КлючИЗначение.Значение Цикл
				УдалитьПустыеПоля(СтрокаМассива);
			КонецЦикла;
		ИначеЕсли ТипЗнч(КлючИЗначение.Значение) = Тип("Структура") Тогда
			УдалитьПустыеПоля(КлючИЗначение.Значение);	
		ИначеЕсли НЕ ЭтоПримитивныйТип(КлючИЗначение.Значение) Тогда
			ПреобразоватьЗначениеКПримитивномуТипу(КлючИЗначение, СтруктураВарианта);
		ИначеЕсли КлючИЗначение.Ключ = "seller_sku" И ТипЗнч(КлючИЗначение.Значение) = Тип("Число") Тогда
			СтруктураВарианта[КлючИЗначение.Ключ] = Формат(КлючИЗначение.Значение, "ЧГ=");
		КонецЕсли;
		Если ТипЗнч(СтруктураВарианта[КлючИЗначение.Ключ]) = Тип("Строка") Тогда
			Если СтрНайти(ОбязательынеПоля, КлючИЗначение.Ключ) > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ПустаяСтрока(СтруктураВарианта[КлючИЗначение.Ключ]) Тогда
				УдаляемыеКлючи.Добавить(КлючИЗначение.Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	Для Каждого Ключ Из УдаляемыеКлючи Цикл
		СтруктураВарианта.Удалить(Ключ);
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоПримитивныйТип(ПроверяемоеЗначение)

	Если ТипЗнч(ПроверяемоеЗначение) = Тип("Строка") ИЛИ ТипЗнч(ПроверяемоеЗначение) = Тип("Число")
		ИЛИ ТипЗнч(ПроверяемоеЗначение) = Тип("Дата") ИЛИ ТипЗнч(ПроверяемоеЗначение) = Тип("Булево") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура ПреобразоватьЗначениеКПримитивномуТипу(КлючИЗначение, СтруктураВарианта)
	
	Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
		СтруктураВарианта[КлючИЗначение.Ключ] = Строка(КлючИЗначение.Значение);
	Иначе
		СтруктураВарианта[КлючИЗначение.Ключ] = "";
	КонецЕсли;
	
КонецПроцедуры

Функция ПреобразоватьИмяКолонки(СтрНаименование)
	
	Разделители	=  " .,+,-,/,*,?,=,<,>,(,)%!@#$%&*""№:;{}[]?()\|/`~'^";
	
	ИмяКолонки = "";
	БылСпецСимвол = Ложь;
	
	Для НомСимвола = 1 По СтрДлина(СтрНаименование) Цикл
		
		Символ = Сред(СтрНаименование, НомСимвола, 1);
		
		Если СтрНайти(Разделители, Символ) <> 0 Тогда
			БылСпецСимвол = Истина;
		ИначеЕсли БылСпецСимвол Тогда
			БылСпецСимвол = Ложь;
			ИмяКолонки = ИмяКолонки + ВРег(Символ);
		Иначе
			ИмяКолонки = ИмяКолонки + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИмяКолонки;
	
КонецФункции


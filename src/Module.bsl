// Создает категорию на сайте посредством API запроса.
//
// Параметры:
//   СтрокаКатегории - СтрокаДереваЗначений - Данные категории для создания
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - Узел для отправки HTTP запроса
//   НаименованиеКатегории - Строка
//
// Возвращаемое значение:
//   Булево - Признак успешности создания категории
Функция СоздатьКатегориюНаСайте(СтрокаКатегории, Узел, НаименованиеКатегории) Экспорт
	
	ЕстьОшибки = Ложь;
	
	ТекстЗапроса = "/api/public/v1/categories";
	Метод = "POST";
	
	Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, 
		СформироватьСтруктуруКатегории(СтрокаКатегории, НаименованиеКатегории));

	Если Результат.КодСостояния <> 200 Тогда
		ЕстьОшибки = Истина;
		Сообщить("Категория """ + НаименованиеКатегории + """ не создана, HTTP " + Формат(Результат.КодСостояния, "ЧГ=0") + ": " + Лев(Результат.ПолучитьТелоКакСтроку(), 500));
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
		
КонецФункции

// Обновляет категорию на сайте, отправляя PATCH-запрос к API.
//
// Параметры:
//   СтрокаКатегории - СтрокаДереваЗначений - строка категории, содержащая обновляемые данные
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел, к которому выполняется запрос
//   НаименованиеКатегории - Строка
//
// Возвращаемое значение:
//   Булево - признак наличия ошибок при обновлении категории
Функция ОбновитьКатегориюНаСайте(СтрокаКатегории, Узел, НаименованиеКатегории, ИДНаСайте = "") Экспорт
	
	ЕстьОшибки = Ложь;
	
	ТекстЗапроса = "/api/public/v1/categories";
	Метод = "PATCH";
	
	//Категория находится по external_id; id вместе с external_id сайт не принимает
	ДанныеКатегории = СформироватьСтруктуруКатегории(СтрокаКатегории, НаименованиеКатегории);
	Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, ДанныеКатегории);
	Если Результат.КодСостояния <> 200 И ЗначениеЗаполнено(ИДНаСайте) Тогда
		//Вторая попытка: по id сайта, без external_id
		ДанныеКатегории.Удалить("external_id");
		ДанныеКатегории.Вставить("id", ИДНаСайте);
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, ДанныеКатегории);
	КонецЕсли;
	
	Если Результат.КодСостояния <> 200 Тогда
		ЕстьОшибки = Истина;
		Сообщить("Категория """ + НаименованиеКатегории + """ не обновлена, HTTP " + Формат(Результат.КодСостояния, "ЧГ=0") + ": " + Лев(Результат.ПолучитьТелоКакСтроку(), 500));
	ИначеЕсли Узел.Свойство("ПоказатьОтправку") Тогда
		Сообщить("Категория «" + НаименованиеКатегории + "»: обновлена на сайте (название/родитель)");
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;
	
КонецФункции

// Проверяет существование категории на сайте по уникальному идентификатору номенклатуры.
//
// Параметры:
//   СтрокаКатегории - СтрокаДереваЗначений - строка категории, содержащая номенклатуру
//   Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел для вызова API
//
// Возвращаемое значение:
//   Структура:
//     * КатегорийСуществует - Булево
//     * РезультатПроверки - Структура:
//       ** КатегорияСуществует - Булево
//       ** ПараметрыКатегории - Структура
//
Функция ПроверитьКатегориюНаСайте(СтрокаКатегории, Узел) Экспорт
	
	ТекстЗапроса = "/api/public/v1/categories/by_external_id/%1";
	Метод = "GET";
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, СтрокаКатегории.ИД);
		
	Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса);
	
	РезультатПроверки = Новый Структура;
	РезультатПроверки.Вставить("КатегорияСуществует", Ложь);
	РезультатПроверки.Вставить("ПараметрыКатегории", Новый Структура);
	
	Если Результат.КодСостояния = 200 Тогда		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
		ОтветОбъект = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		РезультатПроверки.КатегорияСуществует = Истина;
		РезультатПроверки.ПараметрыКатегории = ОтветОбъект;
	КонецЕсли;
	
	//@skip-check constructor-function-return-section
	Возврат РезультатПроверки;
		
КонецФункции                                


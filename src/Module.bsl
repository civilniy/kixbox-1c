	Возврат Формат(ТекущаяДата, "ЧДЦ=0; ЧГ=");
	
КонецФункции

Функция ПреобразоватьТаблицуКартинокВСоответствие(ТаблицаКартинок)
	
	СоответствиеНоменклатуры = Новый Соответствие;
	
	ТаблицаНоменклатуры = ТаблицаКартинок.Скопировать(,"Номенклатура");
	ТаблицаНоменклатуры.Свернуть("Номенклатура");
	
	Для Каждого Строка Из ТаблицаНоменклатуры Цикл
		
		Отбор = Новый Структура("Номенклатура", Строка.Номенклатура);		
		НайдСтроки = ТаблицаКартинок.НайтиСтроки(Отбор);
		
		Если НЕ НайдСтроки.Количество() Тогда
			Продолжить;
		КонецЕсли;
		
		МассивИдентификаторов = Новый Массив;
		НомерКартинки = 2;
		Для Каждого СтрокаТЗ Из НайдСтроки Цикл
			СтруктураФайла = Новый Структура("НомерКартинки, IDКартинки");
			Если СтрокаТЗ.ОсновнойФайл Тогда
				СтруктураФайла.НомерКартинки = 1;
				СтруктураФайла.IDКартинки = СтрокаТЗ.IDКартинки;
				МассивИдентификаторов.Вставить(0, СтруктураФайла);
			Иначе
				СтруктураФайла.НомерКартинки = НомерКартинки;
				СтруктураФайла.IDКартинки = СтрокаТЗ.IDКартинки;
				МассивИдентификаторов.Добавить(СтруктураФайла);
				НомерКартинки = НомерКартинки + 1;
			КонецЕсли;                           
			СтруктураФайла.IDКартинки = СтрокаТЗ.IDКартинки;			
		КонецЦикла;
		
		СоответствиеНоменклатуры.Вставить(Строка.Номенклатура, МассивИдентификаторов);
		
	КонецЦикла;
		
	Возврат СоответствиеНоменклатуры;
	
КонецФункции

Процедура УдалитьОтборыЦенИОстатков(НастройкиОтбора) Экспорт

	Для Каждого ЭлементОтбора Из НастройкиОтбора Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УдалитьОтборыЦенИОстатков(ЭлементОтбора.Элементы)	
		Иначе
			Если Строка(ЭлементОтбора.ЛевоеЗначение) = "Остаток" Тогда
				ЭлементОтбора.Использование = Ложь;
			ИначеЕсли Строка(ЭлементОтбора.ЛевоеЗначение) = "Цена" Тогда
				ЭлементОтбора.Использование = Ложь;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры


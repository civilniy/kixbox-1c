		//Все склады сводятся в один склад сайта (106 - основной склад интернет-магазина), остатки суммируются. 102 и 111 сюда не входят.
		Склады = Новый ТаблицаЗначений;
		Склады.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
		НомераСкладов = Новый Массив;
		//Склады, остатки которых суммируются для new.kixbox.ru (код справочника "Склады" = склад):
		СкладыВыгрузки = Новый Соответствие;
		СкладыВыгрузки.Вставить("ГЛ0000047", "01a1a124-b33a-7c80-909f-ea2411d82b02");	//106 Склад Резерв (розница) - основной склад ИМ
		СкладыВыгрузки.Вставить("ГЛ0000056", "01a1ea8e-f746-7c36-9c80-3e8e42382e86");				//107 Freestock
		СкладыВыгрузки.Вставить("ГЛ0000024", "01a15881-6ad3-7dd3-b4ff-6602971e03e9");				//202 Магазин Kixbox Метрополис
		СкладыВыгрузки.Вставить("ГЛ0000002", "01a01a95-ea02-7af7-ae6c-c9a7ecdf2d06");					//204 Магазин Kixbox Садовая
		СкладыВыгрузки.Вставить("ГЛ0000055", "01a01ac0-a71b-7312-b0d9-6be805ef0409");					//212 Магазин Kixbox Цветной
		СкладыВыгрузки.Вставить("ГЛ0000087", "01a15e97-6c3e-775d-b248-9a272bdcb707");					//217 Магазин Kixbox Галерея
		СкладыВыгрузки.Вставить("ГЛ0000096", "01a15e97-6c9f-7dc3-a0a5-1033d4736356");					//218 Магазин Kixbox Атриум
		СкладыВыгрузки.Вставить("ГЛ0000097", "01980d4c-1b53-7aa1-ab23-1b7c23604704");					//219 Магазин ОКТЯБРЬ
		СкладыВыгрузки.Вставить("ГЛ0000098", "01a15e97-6cd6-7019-8452-2775c15d00cc");				//220 Магазин Kixbox Авиапарк
		//Не входят: ГЛ0000043 = 102 Сток (Garage Sale), склад 111
		Узел.Вставить("ОжидаетсяСкладовДляРазбивки", СкладыВыгрузки.Количество());
        Узел.Вставить("ИДСкладовКИТ", СкладыВыгрузки);

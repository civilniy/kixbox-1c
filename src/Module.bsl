//Проверяет существуют ли картинки на сайт
//
//Параметры:
//	ДанныеКартинок - Массив из Структура - данные картинок для проверки на сайте	
//  Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена с сайтом
//
//Возвращаемое значение:
//	Массив из структура - Данные по каждой картинке, загруженной на сайт
Функция ПроверитьКартинкиНаСайте(ДанныеКартинок, Узел) Экспорт

	ТекстЗапроса = "/api/public/v1/files/search";
	Метод = "POST";
	
	МассивПакетов = РазбитьМассивДанныхНаПакеты(ДанныеКартинок, Узел.Пакет);
	МассивКартинокНаСайте = Новый Массив;	
	
	Для Каждого Пакет Из МассивПакетов Цикл
				
		СтруктураОтправки = Новый Структура("hashes", Пакет); 
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, СтруктураОтправки);
		
		Если Результат.КодСостояния <> 200 Тогда
			ВыполнятьЗапрос = Ложь;
			Продолжить;
		КонецЕсли;		
		
		ТелоОтвета = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку());
		
		ДополнитьМассив(МассивКартинокНаСайте, ТелоОтвета.items);
		
	КонецЦикла;
	
	Возврат МассивКартинокНаСайте;
	
КонецФункции

//Отправляет картинку на сайт в формате multipart/form-data
//
//Параметры:
//	ДанныеФайла - Структура - Данные файла для формирования тела запроса 
//	Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена с сайтом 
//
//Возвращаемое значение:
// Структура - Результат выполнения запроса и данные файла
Функция ОтправитьФайлКартинкиНаСайт(ДанныеФайла, Узел) Экспорт

	РезультатОтправки = Новый Структура("ОтправленУспешно, ДанныеФайла", Ложь, Неопределено);	
	
	ТекстЗапроса = "/api/public/v1/files";
	Метод = "POST";
		                                       
	ПараметрыОтправки = СформироватьПараметрыДляОтправкиФайла(ДанныеФайла);
	
	Попытка
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, ПараметрыОтправки.ТелоЗапроса, , , , Истина, ПараметрыОтправки.Разделитель);	
				
		Если Результат.КодСостояния = 200 Тогда
			
			РезультатОтправки.ОтправленУспешно = Истина;
			РезультатОтправки.ДанныеФайла = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку());
			
		КонецЕсли;
		
	Исключение	
	КонецПопытки;
	
	Возврат РезультатОтправки;
		
КонецФункции

//Получает список версий модуля Яндекс KIT для 1С
//
//Параметры:
//	Узел - ПланОбменаСсылка.янд_ОбменСайтом - узел обмена с сайтом
//	ПолучатьСписокВсехВерсий - Булево - параметр загрузки версий
//Возвращаемое значение:
//	Структура - Инофрмация о  двоичных данных файла
Функция ПолучитьСписокВерсийЯндексKIT(Узел, ПолучатьСписокВсехВерсий = Ложь) Экспорт

	ТекстЗапроса = "/api/public/v1/external_modules/list";
	Метод = "POST";
	
	НомерСтраницы = 1;
	КоличествоЭлементов = 25;	
	
	ВыполнятьЗапрос = Истина;
	МассивВерсий = Новый Массив;
	
	СтруктураЗапросаВерсий = СформироватьСтруктуруЗапросаНовыхВерсий(ПолучатьСписокВсехВерсий);
	
	Пока ВыполнятьЗапрос Цикл
		
		Результат = ОтправитьHTTPЗапрос(Узел, Метод, ТекстЗапроса, СтруктураЗапросаВерсий);
		
		Если Результат.КодСостояния <> 200 Тогда
			ВыполнятьЗапрос = Ложь;
			Продолжить;
		КонецЕсли;
		
		ТелоОтвета = ПрочитатьДанныеJSON(Результат.ПолучитьТелоКакСтроку()); 
		
		Если ТелоОтвета.total_count > КоличествоЭлементов Тогда
			НомерСтраницы = НомерСтраницы + 1;
			КоличествоЭлементов = КоличествоЭлементов * 2;		
			СтруктураЗапросаВерсий.НомерСтраницы = НомерСтраницы;
			ДополнитьМассив(МассивВерсий, ТелоОтвета.items); 
		Иначе
			ВыполнятьЗапрос = Ложь;
			ДополнитьМассив(МассивВерсий, ТелоОтвета.items);
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат МассивВерсий;	
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьСтруктуруКатегории(СтрокаКатегории, НаименованиеКатегории = "")
		
	СтруктураКатегории = Новый Структура;
	Если ПустаяСтрока(НаименованиеКатегории) Тогда
		СтруктураКатегории.Вставить("title", СтрокаКатегории.Наименование);
	Иначе
		СтруктураКатегории.Вставить("title", НаименованиеКатегории);
	КонецЕсли;
		
	СтруктураКатегории.Вставить("external_id", СтрокаКатегории.ИД);
	Если ТипЗнч(СтрокаКатегории.Родитель) = Тип("СтрокаДереваЗначений") Тогда
		СтруктураКатегории.Вставить("external_parent_id", СтрокаКатегории.Родитель.ИД);
	КонецЕсли;
		
	Возврат СтруктураКатегории;  
	
КонецФункции

Функция СформироватьСтруктуруСклада(Склад)

	СтруктураСклада = Новый Структура;
	СтруктураСклада.Вставить("title", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "Наименование"));
	СтруктураСклада.Вставить("external_id", Строка(Склад.УникальныйИдентификатор()));
	
	Возврат СтруктураСклада;
	
КонецФункции

Процедура ПоказатьПрогресс(Итог, НомерПакета, РазмерПакета)
	
	Итог.Передано = Итог.Передано + РазмерПакета;
	Всего = Итог.ВсегоСтрок;
	Осталось = Всего - Итог.Передано;
	Если Осталось < 0 Тогда
		Осталось = 0;
	КонецЕсли;
	
	Текст = Итог.Операция + ": передано " + Формат(Итог.Передано, "ЧН=0; ЧГ=0") 
		+ " из " + Формат(Всего, "ЧН=0; ЧГ=0") 
		+ ", осталось " + Формат(Осталось, "ЧН=0; ЧГ=0");
	
	Прошло = ТекущаяДата() - Итог.ВремяНачала;
	Если Итог.Передано > 0 И Осталось > 0 И Прошло > 0 Тогда
		Текст = Текст + ", ещё примерно " + ФорматДлительности(Окр(Прошло / Итог.Передано * Осталось));
	КонецЕсли;
	
	ПоказатьСостояние(ПолосаПрогресса(ПроцентОт(Итог.Передано, Всего)) + "  " + Текст, ПроцентОт(Итог.Передано, Всего));
	
	Если НомерПакета % 10 = 0 ИЛИ Осталось = 0 Тогда
		Сообщить(Формат(ТекущаяДата(), "ДФ=ЧЧ:мм:сс") + "  " + Текст);
	КонецЕсли;
	
КонецПроцедуры

Процедура СообщитьЭтап(Текст)
	
	Сообщить(Формат(ТекущаяДата(), "ДФ=ЧЧ:мм:сс") + "  " + Текст);
	Состояние(Текст);
	
КонецПроцедуры

// ----- Прогресс в строке состояния 1С (внизу окна, не уходит вместе с логом) -----

Функция ПроцентОт(Текущий, Всего)
	Если Всего <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Мин(100, Цел(Текущий * 100 / Всего));
КонецФункции

// ██████░░░░░░░░ 40%
Функция ПолосаПрогресса(Процент)
	Заполнено = Цел(Процент / 5);
	Полоса = "";
	Для Сч = 1 По 20 Цикл
		Полоса = Полоса + ?(Сч <= Заполнено, "█", "░");
	КонецЦикла;
	Возврат Полоса + " " + Формат(Процент, "ЧН=0; ЧГ=0") + "%";
КонецФункции

Процедура ПоказатьПрогрессФазы(Фаза, Текущий, Знач Всего, НачалоФазы)
	Если Всего < Текущий Тогда
		Всего = Текущий;
	КонецЕсли;
	Процент = ПроцентОт(Текущий, Всего);
	Текст = Фаза + "  " + ПолосаПрогресса(Процент) + "  (" + Формат(Текущий, "ЧН=0; ЧГ=0") + " из " + Формат(Всего, "ЧН=0; ЧГ=0") + ")";
	Прошло = ТекущаяДата() - НачалоФазы;
	Если Текущий > 0 И Текущий < Всего И Прошло >= 5 Тогда
		Текст = Текст + ", осталось примерно " + ФорматДлительности(Прошло / Текущий * (Всего - Текущий));
	КонецЕсли;
	ПоказатьСостояние(Текст, Процент);
КонецПроцедуры

// Состояние с полосой (если платформа поддерживает параметр «Прогресс»), иначе просто текст в строке состояния
Процедура ПоказатьСостояние(ТекстСостояния, ПроцентСостояния)
	Попытка
		Выполнить("Состояние(ТекстСостояния, ПроцентСостояния)");
	Исключение
		Состояние(ТекстСостояния);
	КонецПопытки;
КонецПроцедуры


Функция ФорматДлительности(Знач Секунд)
	
	Секунд = Окр(Секунд);
	Если Секунд < 60 Тогда
		Возврат Формат(Секунд, "ЧН=0; ЧГ=0") + " сек";
	КонецЕсли;
	Минут = Цел(Секунд / 60);
	Если Минут < 60 Тогда
		Возврат Формат(Минут, "ЧГ=0") + " мин " + Формат(Секунд % 60, "ЧН=0; ЧГ=0") + " сек";
	КонецЕсли;
	Возврат Формат(Цел(Минут / 60), "ЧГ=0") + " ч " + Формат(Минут % 60, "ЧН=0; ЧГ=0") + " мин";
	
КонецФункции

Функция НовыйИтогВыгрузки(Операция, ВсегоСтрок, ВсегоПакетов)
	
	Итог = Новый Структура;
	Итог.Вставить("Операция", Операция);
	Итог.Вставить("ВсегоСтрок", ВсегоСтрок);
	Итог.Вставить("ВсегоПакетов", ВсегоПакетов);
	Итог.Вставить("ОтправленоПакетов", 0);
	Итог.Вставить("Принято", 0);
	Итог.Вставить("Отклонено", 0);
	Итог.Вставить("ПакетовСОшибкойHTTP", 0);
	Итог.Вставить("СтрокВПакетахСОшибкойHTTP", 0);
	Итог.Вставить("КодыОшибок", Новый Соответствие);
	Итог.Вставить("Примеры", Новый Массив);
	Итог.Вставить("ВремяНачала", ТекущаяДата());
	Итог.Вставить("Передано", 0);
	Возврат Итог;
	
КонецФункции

Процедура УчестьОтветПакета(Итог, Результат, НомерПакета, РазмерПакета)
	
	Итог.ОтправленоПакетов = Итог.ОтправленоПакетов + 1;
	ТелоОтвета = Результат.ПолучитьТелоКакСтроку();
	
	Если Результат.КодСостояния <> 200 Тогда
		Итог.ПакетовСОшибкойHTTP = Итог.ПакетовСОшибкойHTTP + 1;
		Итог.СтрокВПакетахСОшибкойHTTP = Итог.СтрокВПакетахСОшибкойHTTP + РазмерПакета;
		Если Итог.ПакетовСОшибкойHTTP <= 5 Тогда
			Сообщить(Итог.Операция + ": пакет " + Формат(НомерПакета, "ЧГ=0") + ", HTTP " + Формат(Результат.КодСостояния, "ЧГ=0") + ": " + Лев(ТелоОтвета, 500));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Попытка
		Ответ = ПрочитатьДанныеJSON(ТелоОтвета);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Ответ.Свойство("success_count") Тогда
		Итог.Принято = Итог.Принято + Ответ.success_count;
	КонецЕсли;
	Если Ответ.Свойство("error_count") Тогда
		Итог.Отклонено = Итог.Отклонено + Ответ.error_count;
	КонецЕсли;
	
	Если НЕ Ответ.Свойство("validation_errors") ИЛИ ТипЗнч(Ответ.validation_errors) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ОшибкаСтроки Из Ответ.validation_errors Цикл
		КодОшибки = "";
		ТекстОшибки = "";
		ВнешнийИД = "";
		Если ТипЗнч(ОшибкаСтроки) = Тип("Структура") Тогда
			Если ОшибкаСтроки.Свойство("code") Тогда
				КодОшибки = Строка(ОшибкаСтроки.code);
			КонецЕсли;
			Если ОшибкаСтроки.Свойство("message") Тогда
				ТекстОшибки = Строка(ОшибкаСтроки.message);
			КонецЕсли;
			Если ОшибкаСтроки.Свойство("external_id") Тогда
				ВнешнийИД = Строка(ОшибкаСтроки.external_id);
			КонецЕсли;
		КонецЕсли;
		КлючОшибки = КодОшибки + " | " + ТекстОшибки;
		Было = Итог.КодыОшибок.Получить(КлючОшибки);
		Если Было = Неопределено Тогда
			Было = 0;
		КонецЕсли;
		Итог.КодыОшибок.Вставить(КлючОшибки, Было + 1);
		Если Итог.Примеры.Количество() < 10 Тогда
			Итог.Примеры.Добавить(КлючОшибки + " | " + ВнешнийИД);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СообщитьИтогВыгрузки(Итог)
	
	Сообщить("=== " + Итог.Операция + " ===");
	Сообщить("Время: " + ФорматДлительности(ТекущаяДата() - Итог.ВремяНачала));
	Сообщить("Отправлено строк: " + Формат(Итог.ВсегоСтрок, "ЧГ=0") + ", пакетов отправлено: " + Формат(Итог.ОтправленоПакетов, "ЧГ=0") + " из " + Формат(Итог.ВсегоПакетов, "ЧГ=0"));
	Сообщить("Сайт принял: " + Формат(Итог.Принято, "ЧН=0; ЧГ=0"));
	Сообщить("Сайт отклонил: " + Формат(Итог.Отклонено, "ЧН=0; ЧГ=0"));
	Если Итог.ПакетовСОшибкойHTTP > 0 Тогда
		Сообщить("Пакетов с ошибкой HTTP: " + Формат(Итог.ПакетовСОшибкойHTTP, "ЧГ=0") + ", строк в них: " + Формат(Итог.СтрокВПакетахСОшибкойHTTP, "ЧГ=0"));
	КонецЕсли;
	Если Итог.КодыОшибок.Количество() > 0 Тогда
		Сообщить("Причины отказа (код | сообщение: количество):");
		Для Каждого ЭлементОшибки Из Итог.КодыОшибок Цикл
			Сообщить("  " + ЭлементОшибки.Ключ + ": " + Формат(ЭлементОшибки.Значение, "ЧГ=0"));
		КонецЦикла;
	КонецЕсли;
	Если Итог.Примеры.Количество() > 0 Тогда
		Сообщить("Примеры (код | сообщение | external_id):");
		Для Каждого Пример Из Итог.Примеры Цикл
			Сообщить("  " + Пример);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция РазбитьМассивДанныхНаПакеты(Данные, КоличествоВПакете)
		
	МассивПакетов = Новый Массив;
	ПодмассивПакета = Новый Массив;
	Для Каждого СтрокаДанных Из Данные Цикл
		ПодмассивПакета.Добавить(СтрокаДанных);
		Если ПодмассивПакета.Количество() = КоличествоВПакете Тогда
			МассивПакетов.Добавить(ПодмассивПакета);
			ПодмассивПакета = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	
	Если ПодмассивПакета.Количество() Тогда
		МассивПакетов.Добавить(ПодмассивПакета);
	КонецЕсли;
	
	Возврат МассивПакетов;
	
КонецФункции

Функция СформироватьПараметрыДляОтправкиФайла(ДанныеФайла)
	
	СтруктураОтправки = Новый Структура("ТелоЗапроса, Разделитель"); 
	
	Разделитель = СтрЗаменить(Новый УникальныйИдентификатор, "-", "");
	РазделительСтрок = Символы.ВК + Символы.ПС;	

	ПараметрыФайла = СформироватьПараметрыФайла(ДанныеФайла);	
	
	Тело = Новый ПотокВПамяти();
	
	ЗаписьДанных = Новый ЗаписьДанных(Тело, КодировкаТекста.UTF8, ПорядокБайтов.LittleEndian, "", "", Ложь);
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + РазделительСтрок);
	ЗаписьДанных.ЗаписатьСтроку(ЗаголовкиВСтроку(ПараметрыФайла.Заголовки));
	ЗаписьДанных.Записать(ПараметрыФайла.Данные);
	ЗаписьДанных.ЗаписатьСтроку(РазделительСтрок);
	ЗаписьДанных.ЗаписатьСтроку("--" + Разделитель + "--" + РазделительСтрок);
	
	ДанныеТела = Тело.ЗакрытьИПолучитьДвоичныеДанные();
	
	СтруктураОтправки.ТелоЗапроса = ДанныеТела;
	СтруктураОтправки.Разделитель = Разделитель; 
	
	Возврат СтруктураОтправки;
	
КонецФункции

Функция СформироватьПараметрыФайла(ДанныеФайла)
	
	ПараметрыФайла = Новый Структура("Имя,ИмяФайла,Данные,Тип,Заголовки");
	ПараметрыФайла.Имя = ДанныеФайла.Имя;
	ПараметрыФайла.Данные = ДанныеФайла.Данные;
	ПараметрыФайла.Тип = ДанныеФайла.Тип;
	ПараметрыФайла.Заголовки = Новый Соответствие;
	ПараметрыФайла.ИмяФайла = ДанныеФайла.ИмяФайла;
	ПараметрыФайла.Заголовки.Вставить("Content-Disposition", "form-data");

	Части = Новый Массив;
	Части.Добавить(ПараметрыФайла.Заголовки["Content-Disposition"]);
	Части.Добавить(СтрШаблон("name=""%1""", ПараметрыФайла.Имя));
	Если ЗначениеЗаполнено(ПараметрыФайла.ИмяФайла) Тогда
		Части.Добавить(СтрШаблон("filename=""%1""", ПараметрыФайла.ИмяФайла));
	КонецЕсли;

	ПараметрыФайла.Заголовки["Content-Disposition"] = СтрСоединить(Части, "; ");
	ПараметрыФайла.Заголовки["Content-Type"] = ПараметрыФайла.Тип;

	Возврат ПараметрыФайла;	
	
КонецФункции

Функция ЗаголовкиВСтроку(Заголовки)

	РазделительСтрок = Символы.ВК + Символы.ПС;
	Строки = Новый Массив;

	СортированныеЗаголовки = "Content-Disposition,Content-Type,Content-Location";
	Для Каждого Ключ Из СтрРазделить(СортированныеЗаголовки, ",") Цикл
		Значение = Заголовки.Получить(Ключ);
		Если Значение <> Ложь И ЗначениеЗаполнено(Значение) Тогда
			Строки.Добавить(СтрШаблон("%1: %2", Ключ, Значение));
		КонецЕсли;
	КонецЦикла;

	Ключи = СтрРазделить(ВРег(СортированныеЗаголовки), ",");
	Для Каждого Заголовок Из Заголовки Цикл
		Если Ключи.Найти(ВРег(Заголовок.Ключ)) = Неопределено Тогда
			Строки.Добавить(СтрШаблон("%1: %2", Заголовок.Ключ, Заголовок.Значение));
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(РазделительСтрок);

	Возврат СтрСоединить(Строки, РазделительСтрок);

КонецФункции

Функция СформироватьСтруктуруЗапросаНовыхВерсий(ПолучатьСписокВсехВерсий)
	
	СтруктураВерсии = Новый Структура;
	Если НЕ ПолучатьСписокВсехВерсий Тогда
		СтруктураВерсии.Вставить("from_version", "1.0.9.4");
	КонецЕсли;
	СтруктураВерсии.Вставить("type", "1C_UT_KA_ERP");	
	
	СтруктураЗапросаВерсий = Новый Структура;
	СтруктураЗапросаВерсий.Вставить("page", 1);
	СтруктураЗапросаВерсий.Вставить("per_page", 25);
	СтруктураЗапросаВерсий.Вставить("sort_field", "created_at");
	СтруктураЗапросаВерсий.Вставить("sort_direction", "desc");
	СтруктураЗапросаВерсий.Вставить("type_filter", СтруктураВерсии);
	
	Возврат СтруктураЗапросаВерсий;
	
КонецФункции

#КонецОбласти

#Область янд_РаботаСЗаказамиСервер
Процедура ОбработатьЗаказыССайта(СписокЗаказов, Узел) Экспорт

	ТЗID = Новый ТаблицаЗначений();
	ТЗID.Колонки.Добавить("IDЗаказа", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(11)));       
		ДанныеЗаказа = Новый Соответствие();
	
	Для Каждого ДанныеЗаказаССайта Из СписокЗаказов Цикл
		ЕстьТоварыНе1С = ПроверитьМассивЗаказов(ДанныеЗаказаССайта.delivery_chunks);
		Если ЕстьТоварыНе1С Тогда
			Продолжить;
		КонецЕсли;
		ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("ДанныеЗаполнения", ДанныеЗаказаССайта);
		ПараметрыЗаполнения.Вставить("Узел", Узел);    
		НомерДляПоиска = Узел.ПрефиксЗаказа + ДанныеЗаказаССайта.order_number;
		ДанныеЗаказа.Вставить(НомерДляПоиска, ПараметрыЗаполнения);
		//ДанныеЗаказа.Вставить(ДанныеЗаказаССайта.id, ПараметрыЗаполнения);

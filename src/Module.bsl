Процедура ТоварПоСкладамНажатие(Элемент) Экспорт
    Если Сайт <> Перечисления.СписокСайтов.ЯндексКИТ Тогда
        Предупреждение("Выберите сайт Яндекс Kixbox.ru.");
        Возврат;
    КонецЕсли;
    Ввод = "";
    Если НЕ ВвестиСтроку(Ввод, "Товар по складам: штрихкоды по одному в строке или через запятую", 0, Истина) Тогда
        Возврат;
    КонецЕсли;
    Попытка
        Ввод = СтрЗаменить(СтрЗаменить(СтрЗаменить(Ввод, Символы.ВК, " "), Символы.ПС, " "), Символы.Таб, " ");
        Ввод = СтрЗаменить(СтрЗаменить(Ввод, ",", " "), ";", " ");
        Коды = Новый Массив;
        Для Каждого ШК Из СтрРазделить(Ввод, " ", Ложь) Цикл
            Для Н = 1 По СтрДлина(ШК) Цикл
                Если Найти("0123456789", Сред(ШК, Н, 1)) = 0 Тогда
                    ВызватьИсключение "Некорректный штрихкод: " + ШК;
                КонецЕсли;
            КонецЦикла;
            Если Коды.Найти(ШК) = Неопределено Тогда
                Коды.Добавить(ШК);
            КонецЕсли;
        КонецЦикла;
        Если Коды.Количество() > 0 Тогда
            ПередатьРаздельныеОстаткиKIT(Коды);
        КонецЕсли;
    Исключение
        Сообщить("Товар по складам: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

Функция РазбивкаПоСкладам1С(ШК, Склады)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Ш.Владелец КАК Товар, Ш.ХарактеристикаНоменклатуры КАК Вариант
    |ИЗ РегистрСведений.Штрихкоды КАК Ш
    |ГДЕ Ш.Штрихкод = &ШК И Ш.Владелец ССЫЛКА Справочник.Номенклатура";
    Запрос.УстановитьПараметр("ШК", ШК);
    Товары = Запрос.Выполнить().Выгрузить();
    Если Товары.Количество() <> 1 Тогда
        ВызватьИсключение "ШК " + ШК + ": в 1С требуется ровно одно сочетание товара и характеристики.";
    КонецЕсли;
    Т = Товары[0];
    Если Т.Товар.ПометкаУдаления Или (ЗначениеЗаполнено(Т.Вариант) И Т.Вариант.ПометкаУдаления) Тогда
        ВызватьИсключение "ШК " + ШК + ": в 1С установлена пометка удаления.";
    КонецЕсли;
    Запрос.УстановитьПараметр("Товар", Т.Товар);
    Запрос.УстановитьПараметр("Вариант", Т.Вариант);
    Запрос.УстановитьПараметр("Склады", Склады);
    Запрос.Текст = "ВЫБРАТЬ Д.Склад, СУММА(Д.Физический) КАК Физический, СУММА(Д.Резерв) КАК Резерв
    |ИЗ (ВЫБРАТЬ О.Склад КАК Склад, О.ОстатокОстаток КАК Физический, 0 КАК Резерв
    | ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(, Номенклатура = &Товар И ХарактеристикаНоменклатуры = &Вариант И Склад В (&Склады)) КАК О
    | ОБЪЕДИНИТЬ ВСЕ
    | ВЫБРАТЬ К.Склад, 0, К.КоличествоОстаток
    | ИЗ РегистрНакопления.Комплектация.Остатки(, Номенклатура = &Товар И ХарактеристикаНоменклатуры = &Вариант И Склад В (&Склады)) КАК К) КАК Д
    |СГРУППИРОВАТЬ ПО Д.Склад";
    Доступно = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Кол = Макс(0, Выборка.Физический - Макс(0, Выборка.Резерв));
        Если Кол <> Цел(Кол) Тогда
            ВызватьИсключение "Дробный остаток: " + ШК + ", " + Строка(Выборка.Склад);
        КонецЕсли;
        Доступно.Вставить(Выборка.Склад, Кол);
    КонецЦикла;
    СсылкаВарианта = ?(ЗначениеЗаполнено(Т.Вариант), Т.Вариант, Т.Товар);
    Возврат Новый Структура("Ссылка,Доступно", СсылкаВарианта, Доступно);
КонецФункции

Функция СписокСкладовДляРазбивкиKIT(Соединение, Токен)
    Все = Новый Массив;
    Для Каждого Статус Из СтрРазделить("ACTIVE ARCHIVED", " ") Цикл
        Номер = 1;
        Прочитано = 0;
        Пока Истина Цикл
            Путь = "/v1/warehouses?status=" + Статус + "&per_page=100&page=" + Формат(Номер, "ЧГ=0");
            Ответ = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", Путь);
            Если Ответ.КодСостояния <> 200 Тогда
                ВызватьИсключение "Чтение складов KIT: HTTP " + Строка(Ответ.КодСостояния);
            КонецЕсли;
            Данные = ОтветПубличногоAPIKIT(Ответ);
            Строки = Данные.Получить("warehouses");
            Всего = Данные.Получить("total_count");
            Если ТипЗнч(Строки) <> Тип("Массив") Или ТипЗнч(Всего) <> Тип("Число") Тогда
                ВызватьИсключение "Неполный список складов KIT.";
            КонецЕсли;
            Для Каждого СтрСклад Из Строки Цикл
                Если СтрСклад.Получить("status") <> Статус Или НЕ ЗначениеЗаполнено(СтрСклад.Получить("id")) Тогда
                    ВызватьИсключение "Не удалось проверить склад KIT.";
                КонецЕсли;
                Все.Добавить(СтрСклад);
            КонецЦикла;
            Прочитано = Прочитано + Строки.Количество();
            Если Прочитано = Всего Тогда
                Прервать;
            КонецЕсли;
            Если Строки.Количество() = 0 Или Прочитано > Всего Тогда
                ВызватьИсключение "Изменился список складов KIT. Повторите проверку.";
            КонецЕсли;
            Номер = Номер + 1;
        КонецЦикла;
    КонецЦикла;
    Возврат Все;
КонецФункции

Функция СкладРазбивкиПоИДKIT(ИД, ВсеСклады)
    Для Каждого С Из ВсеСклады Цикл
        Если С.Получить("id") = ИД Тогда
            Возврат С;
        КонецЕсли;
    КонецЦикла;
    ВызватьИсключение "В кабинете KIT отсутствует закреплённый склад " + Строка(ИД);
КонецФункции

Функция ОстаткиИзВариантаKIT(Вариант)
    МассивСкладов = Вариант.Получить("stocks");
    Если ТипЗнч(МассивСкладов) <> Тип("Массив") Тогда
        ВызватьИсключение "KIT не вернул остатки по складам.";
    КонецЕсли;
    Остатки = Новый Соответствие;
    Для Каждого С Из МассивСкладов Цикл
        ИД = С.Получить("warehouse_id");
        Кол = С.Получить("quantity");
        Если НЕ ЗначениеЗаполнено(ИД) Или ТипЗнч(Кол) <> Тип("Число") Или Остатки.Получить(ИД) <> Неопределено Тогда
            ВызватьИсключение "Некорректная строка stocks в ответе KIT.";
        КонецЕсли;
        Остатки.Вставить(ИД, Кол);
    КонецЦикла;
    Возврат Остатки;
КонецФункции

Процедура ПередатьРаздельныеОстаткиKIT(Коды)
    Узел = ПолучитьНастройкиУзла(Сайт);
    Склады = Узел.Склады.ВыгрузитьКолонку("Склад");
    Если Склады.Количество() <> Узел.ОжидаетсяСкладовДляРазбивки Тогда
        ВызватьИсключение "В 1С не найдены все склады интернет-магазина.";
    КонецЕсли;
    Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
    Токен = ТокенПубличногоAPIKIT();
    Реестр = СписокСкладовДляРазбивкиKIT(Соединение, Токен);
    Карта = Новый Соответствие;
    Для Каждого Склад Из Склады Цикл
        Карта.Вставить(Склад, СкладРазбивкиПоИДKIT(Узел.ИДСкладовКИТ.Получить(Склад.Код), Реестр));
    КонецЦикла;
    План = Новый Массив;
    Иды = Новый Массив;
    Ссылки = Новый Массив;
    Для Каждого ШК Из Коды Цикл
        Локально = РазбивкаПоСкладам1С(ШК, Склады);
        Варианты = ПрочитатьВариантыПоШтрихкодуKIT(Соединение, Токен, ШК);
        Если Варианты = Неопределено Или Варианты.Количество() <> 1 Тогда
            ВызватьИсключение "ШК " + ШК + ": требуется один действующий вариант KIT.";
        КонецЕсли;
        Вариант = Варианты[0];
        ИД = Вариант.Получить("id");
        Если НЕ ЗначениеЗаполнено(ИД) Или Иды.Найти(ИД) <> Неопределено Или Ссылки.Найти(Локально.Ссылка) <> Неопределено Тогда
            ВызватьИсключение "Неоднозначное соответствие варианта: " + ШК;
        КонецЕсли;
        Иды.Добавить(ИД);
        Ссылки.Добавить(Локально.Ссылка);
        Было = ОстаткиИзВариантаKIT(Вариант);
        Для Каждого Склад Из Склады Цикл
            СкладКИТ = Карта.Получить(Склад);
            Кол = Локально.Доступно.Получить(Склад);
            Кол = ?(Кол = Неопределено, 0, Кол);
            Если СкладКИТ.Получить("status") = "ARCHIVED" Тогда
                Если Кол > 0 Тогда
                    ВызватьИсключение ШК + ": склад KIT в архиве: " + СкладКИТ.Получить("id");
                КонецЕсли;
                Продолжить;
            КонецЕсли;
            Старое = Было.Получить(СкладКИТ.Получить("id"));
            Старое = ?(Старое = Неопределено, 0, Старое);
            Если Старое = Кол Тогда
                Продолжить;
            КонецЕсли;
            План.Добавить(Новый Структура("ИД,Склад,Количество", ИД, Склад, Кол));
            Сообщить(ШК + " | " + Строка(Склад) + " | KIT " + Строка(Старое) + " → 1С " + Строка(Кол));
        КонецЦикла;
    КонецЦикла;
    Если План.Количество() = 0 Тогда
        Сообщить("Товар по складам: остатки уже совпадают с 1С.");
        Возврат;
    КонецЕсли;
    Если План.Количество() > 5000 Тогда
        ВызватьИсключение "Более 5000 изменений. Разделите список штрихкодов.";
    КонецЕсли;
    Текст = "Отправить остатки по складам? Изменений: " + Строка(План.Количество()) + ". Разбивка в служебных сообщениях.";
    Если Вопрос(Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет) <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    Пакет = Новый Массив;
    Для Каждого СтрПлана Из План Цикл
        Пакет.Добавить(Новый Структура("variant_id,warehouse_id,quantity", СтрПлана.ИД, Карта.Получить(СтрПлана.Склад).Получить("id"), СтрПлана.Количество));
    КонецЦикла;
    ЗапросHTTP = Новый HTTPЗапрос("/v1/variants/stocks/bulk_update");
    ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + Токен);
    ЗапросHTTP.Заголовки.Вставить("Content-Type", "application/json");
    ЗапросHTTP.УстановитьТелоИзСтроки(ЗаписатьДанныеВJSON(Новый Структура("items", Пакет)), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
    Попытка
        Ответ = Соединение.ВызватьHTTPМетод("POST", ЗапросHTTP);
    Исключение
        ВызватьИсключение "Нет ответа KIT на отправку остатков. Запустите сверку повторно. " + ОписаниеОшибки();
    КонецПопытки;
    Если Ответ.КодСостояния <> 204 Тогда
        ВызватьИсключение "Отправка остатков: HTTP " + Строка(Ответ.КодСостояния) + " " + Лев(Ответ.ПолучитьТелоКакСтроку(), 1000);
    КонецЕсли;
    Сообщить("KIT подтвердил обновление остатков. Изменено пар товар / склад: " + Строка(Пакет.Количество()));
    Проверено = Новый Соответствие;
    Для Каждого СтрПакета Из Пакет Цикл
        Факт = Проверено.Получить(СтрПакета.variant_id);
        Если Факт = Неопределено Тогда
            Проверка = ЗапросПубличногоAPIKIT(Соединение, Токен, "GET", "/v1/variants/" + СтрПакета.variant_id);
            Если Проверка.КодСостояния <> 200 Тогда
                ВызватьИсключение "KIT принял пакет, но повторное чтение не удалось. Запустите сверку повторно.";
            КонецЕсли;
            Вариант = ОтветПубличногоAPIKIT(Проверка);
            Если Вариант.Получить("id") <> СтрПакета.variant_id Тогда
                ВызватьИсключение "KIT принял пакет. Не удалось проверить ID прочитанного варианта.";
            КонецЕсли;
            Факт = ОстаткиИзВариантаKIT(Вариант);
            Проверено.Вставить(СтрПакета.variant_id, Факт);
        КонецЕсли;
        Кол = Факт.Получить(СтрПакета.warehouse_id);
        Если ?(Кол = Неопределено, 0, Кол) <> СтрПакета.quantity Тогда
            ВызватьИсключение "KIT принял пакет, но фактический остаток отличается. Вариант " + СтрПакета.variant_id + ", склад " + СтрПакета.warehouse_id;
        КонецЕсли;
    КонецЦикла;
    Сообщить("Товар по складам: остатки проверены повторным чтением KIT.");
КонецПроцедуры

Процедура ПолучитьКитИДНажатие(Элемент) Экспорт

    Если Сайт <> Перечисления.СписокСайтов.ЯндексКИТ Тогда
        Предупреждение("Выберите сайт Яндекс Kixbox.ru.");
        Возврат;
    КонецЕсли;
    ШК = "2700010662516";
    Если НЕ ВвестиСтроку(ШК, "Получить KIT ID для одной характеристики. Введите штрихкод:", 0, Ложь) Тогда
        Возврат;
    КонецЕсли;
    ШК = СокрЛП(ШК);
    Если ПустаяСтрока(ШК) Тогда
        Возврат;
    КонецЕсли;
    Для Индекс = 1 По СтрДлина(ШК) Цикл
        Если СтрНайти("0123456789", Сред(ШК, Индекс, 1)) = 0 Тогда
            Предупреждение("Введите один штрихкод цифрами.");
            Возврат;
        КонецЕсли;
    КонецЦикла;
    Попытка
        ПолучитьКитИДДляХарактеристики(ШК);
    Исключение
        Сообщить("Получить KIT ID, ШК " + ШК + ": " + ОписаниеОшибки());
    КонецПопытки;

КонецПроцедуры

Процедура ПолучитьКитИДДляХарактеристики(ШК)

    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
    | Ш.Владелец КАК Номенклатура, Ш.ХарактеристикаНоменклатуры КАК Характеристика
    |ИЗ РегистрСведений.Штрихкоды КАК Ш
    |ГДЕ Ш.Штрихкод = &ШК И Ш.Владелец ССЫЛКА Справочник.Номенклатура";
    Запрос.УстановитьПараметр("ШК", ШК);
    СтрокиШК = Запрос.Выполнить().Выгрузить();
    Если СтрокиШК.Количество() <> 1 Тогда
        Сообщить("ШК " + ШК + ": в 1С найдено сочетаний товара и характеристики: " + Строка(СтрокиШК.Количество()) + ". Запись пропущена.");
        Возврат;
    КонецЕсли;
    Характеристика = СтрокиШК[0].Характеристика;
    Номенклатура = СтрокиШК[0].Номенклатура;
    Если НЕ ЗначениеЗаполнено(Характеристика) ИЛИ Характеристика.ПометкаУдаления
        ИЛИ Характеристика.Владелец <> Номенклатура ИЛИ Номенклатура.ПометкаУдаления Тогда
        Сообщить("ШК " + ШК + ": действующая характеристика товара не определена.");
        Возврат;
    КонецЕсли;

    Токен = ТокенПубличногоAPIKIT();
    Соединение = Новый HTTPСоединение("api.kit.yandex.net", , , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
    Варианты = ПрочитатьВариантыПоШтрихкодуKIT(Соединение, Токен, ШК);
    Если Варианты = Неопределено Тогда
        Возврат;
    КонецЕсли;
    Если Варианты.Количество() <> 1 Тогда
        Сообщить("ШК " + ШК + ": точных совпадений в KIT: " + Строка(Варианты.Количество()) + ". Запись пропущена.");
        Возврат;
    КонецЕсли;
    ИД = Варианты[0].Получить("id");
    Если ТипЗнч(ИД) <> Тип("Строка") ИЛИ СтрДлина(ИД) <> 36 Тогда
        Сообщить("Ответ KIT не содержит UUID варианта.");
        Возврат;
    КонецЕсли;
    UUIDВарианта = Новый УникальныйИдентификатор(ИД);
    Если НРег(Строка(UUIDВарианта)) <> НРег(ИД) Тогда
        Сообщить("Некорректный UUID варианта KIT.");
        Возврат;
    КонецЕсли;
    Сообщить("ШК " + ШК + " | " + Строка(Характеристика) + " | KIT ID: " + ИД);

    // Код свойства подтверждён в рабочей базе для характеристик номенклатуры.
    Свойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("00000000230");
    Если НЕ ЗначениеЗаполнено(Свойство) Тогда
        Сообщить("Не найдено свойство с кодом 00000000230. Запись пропущена.");
        Возврат;
    КонецЕсли;
    Если Свойство.ПометкаУдаления Или НРег(СокрЛП(Свойство.Наименование)) <> НРег("id_ЯндексКит") Тогда
        Сообщить("Код 00000000230 не соответствует действующему свойству id_ЯндексКит. Запись пропущена.");
        Возврат;
    КонецЕсли;
    Если НЕ Свойство.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
        Сообщить("Свойство id_ЯндексКит не принимает строку. Тип значения: " + Строка(Свойство.ТипЗначения));
        Возврат;
    КонецЕсли;

    Если Свойство.ТипЗначения.ПривестиЗначение(ИД) <> ИД Тогда
        Сообщить("Не удалось представить KIT ID в свойстве без изменения значения.");
        Возврат;
    КонецЕсли;
    Детали = Строка(Номенклатура) + " / " + Строка(Характеристика) + Символы.ПС
        + "ШК: " + ШК + Символы.ПС + "id_ЯндексКит: " + ИД;
    Если Вопрос("Записать KIT ID в характеристику?" + Символы.ПС + Детали,
        РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;

    Рег = РегистрыСведений.ЗначенияСвойствОбъектов;
    НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Ключ = Блокировка.Добавить("РегистрСведений.ЗначенияСвойствОбъектов");
        Ключ.УстановитьЗначение("Объект", Характеристика);
        Ключ.УстановитьЗначение("Свойство", Свойство);
        Блокировка.Заблокировать();
        Запись = Рег.СоздатьМенеджерЗаписи();
        Запись.Объект = Характеристика;
        Запись.Свойство = Свойство;
        Запись.Прочитать();
        Если Запись.Выбран() И ЗначениеЗаполнено(Запись.Значение) Тогда
            Если Запись.Значение = ИД Тогда
                Итог = "KIT ID уже записан";
            Иначе
                Итог = "Конфликт: в 1С хранится " + Строка(Запись.Значение) + ". Запись пропущена";
            КонецЕсли;
        Иначе
            Запись.Объект = Характеристика;
            Запись.Свойство = Свойство;
            Запись.Значение = ИД;
            Запись.Записать();
            Запись.Прочитать();
            Если НЕ Запись.Выбран() ИЛИ Запись.Значение <> ИД Тогда
                ВызватьИсключение "Проверка записанного KIT ID не прошла.";
            КонецЕсли;
            Итог = "KIT ID записан и проверен";
        КонецЕсли;
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
    Сообщить(Итог + ". " + Детали);

КонецПроцедуры

Процедура ВыгрузитьКаталогНажатие(Элемент) Экспорт
	
	Узел = ПолучитьНастройкиУзла(Сайт);
	
	ТекстШтрихкодов = "";
	Если НЕ ВвестиСтроку(ТекстШтрихкодов, "Штрихкоды для пробной выгрузки, по одному в строке или через запятую (пусто - весь каталог)", 0, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	СписокШтрихкодов = Новый СписокЗначений;
	Текст = ТекстШтрихкодов;
	//любые разделители (перенос строки, запятая, точка с запятой, табуляция) -> пробел
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, ",", " ");
	Текст = СтрЗаменить(Текст, ";", " ");
	Для Каждого Часть Из СтрРазделить(Текст, " ", Ложь) Цикл
		//оставляем только цифры: при копировании могут попасть звездочки, кавычки, точки
		Штрихкод = "";
		Для Н = 1 По СтрДлина(Часть) Цикл
			Символ = Сред(Часть, Н, 1);
			Если СтрНайти("0123456789", Символ) > 0 Тогда
				Штрихкод = Штрихкод + Символ;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(Штрихкод) И СписокШтрихкодов.НайтиПоЗначению(Штрихкод) = Неопределено Тогда
			СписокШтрихкодов.Добавить(Штрихкод);
			Сообщить("Штрихкод для пробной выгрузки: " + Штрихкод);
		КонецЕсли;
	КонецЦикла;
	
	Если СписокШтрихкодов.Количество() > 0 Тогда
		НастройкиОтбора = Узел.ОтборНоменклатуры.Получить();
		ЭлементОтбора = НастройкиОтбора.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Штрихкод");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = СписокШтрихкодов;
		ЭлементОтбора.Использование = Истина;
		Узел.ОтборНоменклатуры = Новый ХранилищеЗначения(НастройкиОтбора);
		Узел.Вставить("ПоказатьОтправку", Истина);
		Узел.Вставить("ШтрихкодыПробнойВыгрузки", СписокШтрихкодов);
        Если Узел.Свойство("СкладСкидок") Тогда
            Узел.Вставить("ПолученныеИДВариантов", Новый Соответствие);
            Узел.Вставить("ФайлыОтправкиKIT", Новый Массив);
            Сообщить("ПРОВЕРКА ID ВАРИАНТА KIT | v1.84.2 | выбранных штрихкодов: " + Строка(СписокШтрихкодов.Количество()));
        КонецЕсли;
		Сообщить("Пробная выгрузка: штрихкодов " + Формат(СписокШтрихкодов.Количество(), "ЧГ=0"));
		Сообщить("Тип операции: изменения (modification_upload), остальной каталог на сайте не затрагивается");
		Сообщить("Если в итоге отправлено меньше строк, чем штрихкодов, - части штрихкодов нет на складах выгрузки с остатком больше нуля");
	ИначеЕсли НЕ ПустаяСтрока(ТекстШтрихкодов) Тогда
		Сообщить("Штрихкоды не распознаны, выгрузка отменена");
		Возврат;
	Иначе
		Если Вопрос("Штрихкоды не указаны. Выгрузить ВЕСЬ каталог?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
    Попытка
        ВыгрузитьТоварыНаСайт(Узел, Ложь);
    Исключение
        ВывестиПроверкуИДВариантовKIT(Узел);
        ВызватьИсключение;
    КонецПопытки;
	
	Если СписокШтрихкодов.Количество() > 0 И НЕ Узел.Свойство("СкладСкидок") Тогда
		СообщитьЭтап("Пробная выгрузка цен для тех же штрихкодов...");
		ТаблицаЦен = ПолучитьТаблицуЦен(Узел);
		Если ТаблицаЦен.Строки.Количество() = 0 Тогда
			Сообщить("Цены: для этих штрихкодов нечего отправлять (нет остатка на складе или цены)");
		Иначе
			ОтправитьЦеныНаСайт(ТаблицаЦен, Узел, "price_update_" + ПолучитьТекущуюДатуTimeStamp());
		КонецЕсли;
	КонецЕсли;
	
    ВывестиПроверкуИДВариантовKIT(Узел);
КонецПроцедуры

Процедура ВывестиПроверкуИДВариантовKIT(Узел)
    Если НЕ Узел.Свойство("ПолученныеИДВариантов") Тогда
        Возврат;
    КонецЕсли;
    Итоги = Новый Массив;
    Для Каждого Элемент Из Узел.ШтрихкодыПробнойВыгрузки Цикл
        ШК = Элемент.Значение;
        ИДПоШК = Узел.ПолученныеИДВариантов.Получить(ШК);
        Если ИДПоШК = Неопределено Тогда
            Результат = "ID НЕ ПОЛУЧЕН при сверке";
        ИначеЕсли ИДПоШК.Количество() > 1 Тогда
            Результат = "НЕСКОЛЬКО ID: " + СтрСоединить(ИДПоШК, ", ");
        ИначеЕсли ШК = "2700010662516" Тогда
            Эталон = "01a1c5bb-f17b-7ec6-be5b-c22dabc3f3b6";
            Результат = ?(ИДПоШК[0] = Эталон, "СОВПАЛ", "РАСХОЖДЕНИЕ, ожидался " + Эталон) + " | получен из KIT: " + ИДПоШК[0];
        Иначе
            Результат = "получен из KIT: " + ИДПоШК[0];
        КонецЕсли;
        СтрокаИтога = "ПРОВЕРКА ID ВАРИАНТА KIT | ШК " + ШК + " | " + Результат;
        Сообщить(СтрокаИтога);
        Итоги.Добавить(СтрокаИтога);
    КонецЦикла;
    Для Каждого ИмяФайла Из Узел.ФайлыОтправкиKIT Цикл
        Попытка
            ЗаписьИтога = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8, , Истина);
            Для Каждого СтрокаИтога Из Итоги Цикл
                ЗаписьИтога.ЗаписатьСтроку(СтрокаИтога);
            КонецЦикла;
            ЗаписьИтога.Закрыть();
        Исключение
            Сообщить("Не удалось дописать результат проверки ID в " + ИмяФайла + ": " + ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;
КонецПроцедуры

Процедура ВыгрузитьКатегорииНажатие(Элемент) Экспорт
	
	Узел = ПолучитьНастройкиУзла(Сайт);
	
	Если Вопрос("Только сверка категорий с 1С?" + Символы.ПС + Символы.ПС
		+ "Да - ничего не создавать и не менять на сайте, только записать файл сверки." + Символы.ПС
		+ "Нет - выгрузить категории (создать недостающие, поправить родителей), затем сверка.", 
		РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
		ЗаписатьКатегории1СНаСайте(Узел);
		Возврат;
	КонецЕсли;
	
	СообщитьЭтап("Выгрузка категорий: сбор товаров с остатком...");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ост.Номенклатура КАК Номенклатура
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(, Склад В (&Склады)) КАК Ост
	|ГДЕ
	|	Ост.ОстатокОстаток > 0";
	Запрос.УстановитьПараметр("Склады", Узел.Склады.ВыгрузитьКолонку("Склад"));
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДеревоТоваров = Новый ДеревоЗначений;
	ДеревоТоваров.Колонки.Добавить("Номенклатура");
	Пока Выборка.Следующий() Цикл
		СтрокаТовара = ДеревоТоваров.Строки.Добавить();
		СтрокаТовара.Номенклатура = Выборка.Номенклатура;
	КонецЦикла;
	
	Категории = ПостроитьКатегорииПоТипу(ДеревоТоваров);
	СообщитьЭтап("Моделей: " + Формат(ДеревоТоваров.Строки.Количество(), "ЧН=0; ЧГ=0") 
		+ ", категорий: " + Формат(Категории.Количество, "ЧН=0; ЧГ=0") + ". Проверка и создание на сайте...");
	
	Если ВыгрузитьКатегорииНаСайт(Категории.Дерево, Узел) Тогда
		СообщитьЭтап("Категории выгружены. Карточки к ним привяжутся при выгрузке каталога.");
	Иначе
		СообщитьЭтап("Выгрузка категорий остановлена из-за ошибки, причина в сообщении выше.");
	КонецЕсли;
	
	ЗаписатьКатегории1СНаСайте(Узел);
	
КонецПроцедуры

// Проверяет на сайте все элементы справочника «Тип» с префиксами tp1_ / tp2_ / t_ (и kt_none)
// и пишет в файл, какие категории сайта привязаны к 1С (внешний ID -> id на сайте).
Процедура ЗаписатьКатегории1СНаСайте(Узел)
	
	СообщитьЭтап("Сверка категорий сайта с типами 1С (все элементы справочника «Тип»)...");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.Ссылка КАК Тип,
	|	Т.Наименование КАК Наименование,
	|	ЕСТЬNULL(Т.Родитель.Наименование, """") КАК Родитель
	|ИЗ
	|	Справочник.Тип КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Попытка
		КаталогЛогов = КаталогДокументов() + "ВыгрузкаYandex_логи";
		СоздатьКаталог(КаталогЛогов);
		ИмяФайла = КаталогЛогов + "\категории_1С_на_сайте_" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd_HH-mm-ss") + ".csv";
		Файл = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8);
	Исключение
		Сообщить("Файл сверки не создан: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Файл.ЗаписатьСтроку("external_id;тип_1С;родитель_1С;id_на_сайте;название_на_сайте;родитель_на_сайте");
	
	Найдено = 0;
	Проверено = 0;
	Префиксы = Новый Массив;
	Префиксы.Добавить("tp1_");
	Префиксы.Добавить("tp2_");
	Префиксы.Добавить("t_");
	Пока Выборка.Следующий() Цикл
		УИД = Строка(Выборка.Тип.УникальныйИдентификатор());
		Для Каждого Префикс Из Префиксы Цикл
			ВнешнийИД = Префикс + УИД;
			Проверено = Проверено + 1;
			Если Проверено % 300 = 0 Тогда
				СообщитьЭтап("Сверка категорий: проверено " + Формат(Проверено, "ЧГ=0") + ", найдено на сайте " + Формат(Найдено, "ЧГ=0"));
			КонецЕсли;
			Рез = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/categories/by_external_id/" + ВнешнийИД);
			Если Рез.КодСостояния = 200 Тогда
				Д = ПрочитатьДанныеJSON(Рез.ПолучитьТелоКакСтроку());
				ИД = ""; Назв = ""; Род = "";
				Если ТипЗнч(Д) = Тип("Структура") Тогда
					Если Д.Свойство("id") И Д.id <> Неопределено Тогда ИД = Д.id; КонецЕсли;
					Если Д.Свойство("title") И Д.title <> Неопределено Тогда Назв = Д.title; КонецЕсли;
					Если Д.Свойство("external_parent_id") И Д.external_parent_id <> Неопределено Тогда Род = Д.external_parent_id; КонецЕсли;
				КонецЕсли;
				Файл.ЗаписатьСтроку(ВнешнийИД + ";" + СтрЗаменить(Выборка.Наименование, ";", ",") + ";" + СтрЗаменить(Выборка.Родитель, ";", ",") + ";" + ИД + ";" + СтрЗаменить(Назв, ";", ",") + ";" + Род);
				Найдено = Найдено + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Рез = ОтправитьHTTPЗапрос(Узел, "GET", "/api/public/v1/categories/by_external_id/kt_none");
	Если Рез.КодСостояния = 200 Тогда
		Д = ПрочитатьДанныеJSON(Рез.ПолучитьТелоКакСтроку());
		Если ТипЗнч(Д) = Тип("Структура") И Д.Свойство("id") Тогда
			Файл.ЗаписатьСтроку("kt_none;Без категории;;" + Д.id + ";Без категории;");
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЕсли;
	
	Файл.Закрыть();
	СообщитьЭтап("Сверка категорий готова: проверено " + Формат(Проверено, "ЧГ=0") + ", привязано к 1С на сайте " + Формат(Найдено, "ЧГ=0"));
	Сообщить("Файл сверки категорий: " + ИмяФайла);
	
КонецПроцедуры

